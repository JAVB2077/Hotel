---
// src/pages/logIn.astro
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=Jost:wght@200;300;400;500&display=swap"
  rel="stylesheet"
/>

<div class="ambient"></div>
<div class="grid-lines"></div>

<!-- Indicador de hora + toggle manual -->
<div class="theme-bar" id="themeBar">
  <div class="theme-time" id="themeTime"></div>
  <button class="theme-toggle" id="themeToggle" title="Cambiar tema">
    <svg
      class="icon-sun"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
    >
      <circle cx="12" cy="12" r="4"></circle>
      <path
        d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
      ></path>
    </svg>
    <svg
      class="icon-moon"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
    >
      <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"></path>
    </svg>
    <span class="theme-label" id="themeLabel">Modo d&iacute;a</span>
  </button>
</div>

<div class="page">
  <!-- Panel Izquierdo -->
  <div class="left-panel">
    <div class="brand">
      <div class="brand-icon">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
        >
          <path d="M3 21h18M3 7l9-4 9 4M4 7v14M20 7v14M8 10v4M12 10v4M16 10v4"
          ></path>
        </svg>
      </div>
      <span class="brand-eyebrow">Sistema de Control</span>
      <h1 class="brand-name">Grand<br /><em>&eacute;lite</em><br />Hotels</h1>
      <p class="brand-tagline">
        Panel de administraci&oacute;n centralizado para la gesti&oacute;n
        integral de operaciones hoteleras.
      </p>
    </div>

    <div class="stats">
      <div class="stat-divider"></div>
      <div class="stat-item">
        <span class="stat-number" id="statRooms">—</span>
        <span class="stat-label">Habitaciones activas</span>
      </div>
      <div class="stat-item">
        <span class="stat-number" id="statOccupancy">—</span>
        <span class="stat-label">Ocupaci&oacute;n actual</span>
      </div>
      <div class="stat-item">
        <span class="stat-number" id="statStaff">—</span>
        <span class="stat-label">Personal en turno</span>
      </div>
      <div class="stat-divider"></div>
    </div>

    <div class="left-footer">
      <div class="status-dot"></div>
      <span class="status-text">Todos los sistemas operativos</span>
    </div>
  </div>

  <!-- Panel Derecho -->
  <div class="right-panel">
    <div class="login-container">
      <div class="login-header">
        <h2 class="login-title">Iniciar sesi&oacute;n</h2>
        <p class="login-subtitle">Acceso restringido al personal autorizado</p>
      </div>

      <form class="form" id="loginForm" novalidate>
        <div class="field">
          <span class="field-label">Departamento</span>
          <div class="role-selector">
            <label class="role-option">
              <input type="radio" name="role" value="admin" checked />
              <span class="role-label">Admin</span>
            </label>
            <label class="role-option">
              <input type="radio" name="role" value="recepcion" />
              <span class="role-label">Recepci&oacute;n</span>
            </label>
            <label class="role-option">
              <input type="radio" name="role" value="staff" />
              <span class="role-label">Staff</span>
            </label>
          </div>
        </div>

        <div class="field">
          <label class="field-label" for="username">Usuario</label>
          <div class="field-input-wrap">
            <input
              type="text"
              id="username"
              class="field-input"
              placeholder="nombre.apellido"
              autocomplete="username"
            />
            <svg
              class="field-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <circle cx="12" cy="8" r="4"></circle>
              <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"></path>
            </svg>
            <div class="field-line"></div>
          </div>
        </div>

        <div class="field">
          <label class="field-label" for="password">Contrase&ntilde;a</label>
          <div class="field-input-wrap">
            <input
              type="password"
              id="password"
              class="field-input"
              placeholder="••••••••••••"
              autocomplete="current-password"
            />
            <svg
              class="field-icon"
              id="togglePwd"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"></path>
              <circle cx="12" cy="12" r="3"></circle>
            </svg>
            <div class="field-line"></div>
          </div>
        </div>

        <div class="error-msg" id="errorMsg">
          Credenciales incorrectas. Verifica tu usuario y contrase&ntilde;a.
        </div>

        <div class="options-row">
          <label class="remember-wrap">
            <input type="checkbox" id="remember" style="display:none" />
            <div class="remember-box" id="rememberBox">
              <svg
                id="checkIcon"
                width="8"
                height="8"
                viewBox="0 0 8 8"
                fill="none"
                stroke="var(--gold)"
                stroke-width="2"
                style="display:none"
              >
                <path d="M1 4l2 2 4-4"></path>
              </svg>
            </div>
            <span class="remember-text">Recordar sesi&oacute;n</span>
          </label>
          <a href="#" class="forgot-link">&#x00BF;Olvidaste tu acceso?</a>
        </div>

        <button type="submit" class="btn-submit" id="submitBtn">
          <span class="btn-text">Ingresar al sistema</span>
          <div class="btn-loader">
            <div class="loader-dot"></div>
            <div class="loader-dot"></div>
            <div class="loader-dot"></div>
          </div>
        </button>
      </form>

      <p class="version">v2.4.1 &middot; Grand &eacute;lite Control Suite</p>
    </div>
  </div>
</div>

<style>
  *,
  *::before,
  *::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  /* ══ TEMA NOCHE (defecto) ══ */
  :root {
    --gold: #c9a96e;
    --gold-light: #e2c99a;
    --gold-dim: rgba(201, 169, 110, 0.14);
    --gold-btn-fg: #0a0a0b;

    --bg: #0a0a0b;
    --bg-panel: #0a0a0b;
    --text: #e8e4dc;
    --text-muted: #6b6860;
    --text-dim: #7f7f85;
    --border: rgba(201, 169, 110, 0.12);
    --border-h: rgba(201, 169, 110, 0.35);
    --grid-line: rgba(201, 169, 110, 0.025);
    --ambient-1: rgba(201, 169, 110, 0.06);
    --ambient-2: rgba(201, 169, 110, 0.03);

    --bar-bg: rgba(10, 10, 11, 0.92);
    --bar-border: rgba(201, 169, 110, 0.1);
    --bar-text: #6b6860;
  }

  /* ══ TEMA DIA ══ */
  :root.day {
    --gold: #a87a3a;
    --gold-light: #7a5520;
    --gold-dim: rgba(168, 122, 58, 0.12);
    --gold-btn-fg: #ffffff;

    --bg: #f5f1ea;
    --bg-panel: #ede8df;
    --text: #1a1714;
    --text-muted: #5a5248;
    --text-dim: #8a8278;
    --border: rgba(168, 122, 58, 0.2);
    --border-h: rgba(168, 122, 58, 0.5);
    --grid-line: rgba(168, 122, 58, 0.06);
    --ambient-1: rgba(168, 122, 58, 0.08);
    --ambient-2: rgba(168, 122, 58, 0.04);

    --bar-bg: rgba(237, 232, 223, 0.95);
    --bar-border: rgba(168, 122, 58, 0.15);
    --bar-text: #8a8278;
  }

  html,
  body {
    height: 100%;
    background: var(--bg);
    color: var(--text);
    font-family: "Jost", sans-serif;
    font-weight: 300;
    overflow: hidden;
    transition:
      background 0.6s ease,
      color 0.6s ease;
  }

  /* Barra de tema */
  .theme-bar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 24px;
    background: var(--bar-bg);
    border-bottom: 1px solid var(--bar-border);
    backdrop-filter: blur(12px);
    transition:
      background 0.6s,
      border-color 0.6s;
  }
  .theme-time {
    font-size: 11px;
    font-weight: 300;
    letter-spacing: 0.18em;
    color: var(--bar-text);
    font-variant-numeric: tabular-nums;
  }
  .theme-toggle {
    display: flex;
    align-items: center;
    gap: 8px;
    background: transparent;
    border: 1px solid var(--border);
    padding: 6px 14px;
    cursor: pointer;
    color: var(--text-muted);
    font-family: "Jost", sans-serif;
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    transition: all 0.3s;
  }
  .theme-toggle:hover {
    border-color: var(--border-h);
    color: var(--gold);
  }
  .theme-toggle svg {
    width: 13px;
    height: 13px;
    flex-shrink: 0;
    transition:
      opacity 0.3s,
      transform 0.4s;
  }
  /* Mostrar solo el icono correcto */
  :root .icon-sun {
    opacity: 0;
    transform: rotate(90deg);
  }
  :root .icon-moon {
    opacity: 1;
    transform: rotate(0deg);
  }
  :root.day .icon-sun {
    opacity: 1;
    transform: rotate(0deg);
  }
  :root.day .icon-moon {
    opacity: 0;
    transform: rotate(-90deg);
  }

  .theme-label {
    transition: color 0.3s;
  }

  /* Ambiente */
  .ambient {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .ambient::before {
    content: "";
    position: absolute;
    top: -20%;
    right: -10%;
    width: 55vw;
    height: 55vw;
    background: radial-gradient(circle, var(--ambient-1) 0%, transparent 65%);
    animation: breathe 8s ease-in-out infinite;
    transition: background 0.6s;
  }
  .ambient::after {
    content: "";
    position: absolute;
    bottom: -15%;
    left: -10%;
    width: 45vw;
    height: 45vw;
    background: radial-gradient(circle, var(--ambient-2) 0%, transparent 65%);
    animation: breathe 8s ease-in-out infinite reverse;
    transition: background 0.6s;
  }
  @keyframes breathe {
    0%,
    100% {
      opacity: 0.6;
      transform: scale(1);
    }
    50% {
      opacity: 1;
      transform: scale(1.08);
    }
  }

  .grid-lines {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image:
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size: 60px 60px;
    transition: background-image 0.6s;
  }

  /* Layout */
  .page {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    height: 100vh;
    padding-top: 41px; /* altura barra */
  }

  /* Panel Izquierdo */
  .left-panel {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 56px 64px;
    border-right: 1px solid var(--border);
    background: var(--bg-panel);
    animation: fadeL 1s ease both;
    transition:
      background 0.6s,
      border-color 0.6s;
  }
  @keyframes fadeL {
    from {
      opacity: 0;
      transform: translateX(-24px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .brand {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .brand-icon {
    width: 36px;
    height: 36px;
    border: 1px solid var(--gold);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 24px;
    position: relative;
    transition: border-color 0.6s;
  }
  .brand-icon::before {
    content: "";
    position: absolute;
    inset: 4px;
    border: 1px solid rgba(201, 169, 110, 0.3);
    transition: border-color 0.6s;
  }
  .brand-icon svg {
    width: 16px;
    height: 16px;
    color: var(--gold);
    transition: color 0.6s;
  }

  .brand-eyebrow {
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--gold);
    opacity: 0.8;
    transition: color 0.6s;
  }
  .brand-name {
    font-family: "Cormorant Garamond", serif;
    font-size: clamp(32px, 3.5vw, 52px);
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: 0.02em;
    color: var(--text);
    transition: color 0.6s;
  }
  .brand-name em {
    font-style: italic;
    color: var(--gold-light);
    transition: color 0.6s;
  }
  .brand-tagline {
    margin-top: 20px;
    font-size: 12px;
    font-weight: 300;
    color: var(--text-muted);
    letter-spacing: 0.08em;
    line-height: 1.7;
    max-width: 280px;
    transition: color 0.6s;
  }

  .stats {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .stat-divider {
    width: 32px;
    height: 1px;
    background: var(--border-h);
    transition: background 0.6s;
  }
  .stat-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .stat-number {
    font-family: "Cormorant Garamond", serif;
    font-size: 28px;
    font-weight: 400;
    color: var(--gold-light);
    letter-spacing: 0.05em;
    transition: color 0.6s;
  }
  .stat-label {
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--text-dim);
    transition: color 0.6s;
  }

  .left-footer {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #4caf82;
    box-shadow: 0 0 8px rgba(76, 175, 130, 0.6);
    animation: pulse 2.5s ease-in-out infinite;
  }
  @keyframes pulse {
    0%,
    100% {
      box-shadow: 0 0 8px rgba(76, 175, 130, 0.6);
    }
    50% {
      box-shadow: 0 0 16px rgba(76, 175, 130, 0.9);
    }
  }
  .status-text {
    font-size: 11px;
    color: var(--text-muted);
    letter-spacing: 0.12em;
    transition: color 0.6s;
  }

  /* Panel Derecho */
  .right-panel {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 56px 72px;
    background: var(--bg);
    animation: fadeR 1s ease 0.15s both;
    transition: background 0.6s;
  }
  @keyframes fadeR {
    from {
      opacity: 0;
      transform: translateX(24px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .login-container {
    width: 100%;
    max-width: 380px;
  }
  .login-header {
    margin-bottom: 52px;
  }
  .login-title {
    font-family: "Cormorant Garamond", serif;
    font-size: 28px;
    font-weight: 400;
    letter-spacing: 0.04em;
    color: var(--text);
    margin-bottom: 8px;
    transition: color 0.6s;
  }
  .login-subtitle {
    font-size: 12px;
    font-weight: 300;
    color: var(--text-muted);
    letter-spacing: 0.08em;
    transition: color 0.6s;
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .field {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .field-label {
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--text-dim);
    transition: color 0.3s;
  }
  .field:focus-within .field-label {
    color: var(--gold);
  }

  .field-input-wrap {
    position: relative;
  }
  .field-input {
    width: 100%;
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--border);
    padding: 12px 0;
    padding-right: 36px;
    font-family: "Jost", sans-serif;
    font-size: 14px;
    font-weight: 300;
    color: var(--text);
    letter-spacing: 0.05em;
    outline: none;
    caret-color: var(--gold);
    transition:
      border-color 0.3s,
      color 0.6s;
  }
  .field-input::placeholder {
    color: var(--text-dim);
    font-weight: 200;
  }
  .field-input:focus {
    border-bottom-color: var(--gold);
  }

  .field-line {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--gold);
    transition:
      width 0.4s cubic-bezier(0.4, 0, 0.2, 1),
      background 0.6s;
  }
  .field-input:focus ~ .field-line {
    width: 100%;
  }

  .field-icon {
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-dim);
    width: 16px;
    height: 16px;
    transition: color 0.3s;
    cursor: pointer;
  }
  .field:focus-within .field-icon {
    color: var(--text-muted);
  }

  .role-selector {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 8px;
    margin-top: 4px;
  }
  .role-option {
    position: relative;
  }
  .role-option input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }
  .role-label {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10px 8px;
    border: 1px solid var(--border);
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-dim);
    cursor: pointer;
    transition: all 0.25s;
    user-select: none;
  }
  .role-label:hover {
    border-color: var(--border-h);
    color: var(--text-muted);
  }
  .role-option input:checked + .role-label {
    border-color: var(--gold);
    color: var(--gold);
    background: var(--gold-dim);
  }

  .options-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .remember-wrap {
    display: flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    user-select: none;
  }
  .remember-box {
    width: 14px;
    height: 14px;
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.25s;
    flex-shrink: 0;
  }
  .remember-text {
    font-size: 11px;
    font-weight: 300;
    color: var(--text-muted);
    letter-spacing: 0.06em;
    transition: color 0.6s;
  }
  .forgot-link {
    font-size: 11px;
    font-weight: 300;
    color: var(--text-dim);
    text-decoration: none;
    letter-spacing: 0.06em;
    transition: color 0.25s;
  }
  .forgot-link:hover {
    color: var(--gold);
  }

  .btn-submit {
    position: relative;
    width: 100%;
    padding: 16px;
    background: transparent;
    border: 1px solid var(--gold);
    color: var(--gold);
    font-family: "Jost", sans-serif;
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    cursor: pointer;
    overflow: hidden;
    transition:
      color 0.4s,
      border-color 0.6s;
    margin-top: 8px;
  }
  .btn-submit::before {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--gold);
    transform: translateX(-100%);
    transition:
      transform 0.4s cubic-bezier(0.4, 0, 0.2, 1),
      background 0.6s;
    z-index: 0;
  }
  .btn-submit:hover::before {
    transform: translateX(0);
  }
  .btn-submit:hover {
    color: var(--gold-btn-fg);
  }

  .btn-text {
    position: relative;
    z-index: 1;
  }
  .btn-submit.loading .btn-text {
    opacity: 0;
  }
  .btn-loader {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    z-index: 1;
    opacity: 0;
    transition: opacity 0.2s;
  }
  .btn-submit.loading .btn-loader {
    opacity: 1;
  }
  .loader-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: currentColor;
    animation: dotB 0.8s ease-in-out infinite;
  }
  .loader-dot:nth-child(2) {
    animation-delay: 0.15s;
  }
  .loader-dot:nth-child(3) {
    animation-delay: 0.3s;
  }
  @keyframes dotB {
    0%,
    100% {
      transform: translateY(0);
      opacity: 0.4;
    }
    50% {
      transform: translateY(-5px);
      opacity: 1;
    }
  }

  .error-msg {
    background: rgba(220, 80, 80, 0.08);
    border: 1px solid rgba(220, 80, 80, 0.25);
    padding: 12px 16px;
    font-size: 11px;
    color: #dc5050;
    letter-spacing: 0.06em;
    line-height: 1.6;
    display: none;
  }
