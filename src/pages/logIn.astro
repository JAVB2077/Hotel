<script>
  // @ts-nocheck
  // ── ESTADÍSTICAS EN TIEMPO REAL (panel izquierdo) ─────────────────
  ;(async () => {
    const API_URL = 'http://localhost:3000'
    try {
      const res = await fetch(`${API_URL}/api/auth/stats`)
      if (!res.ok) return
      const { totalRooms, occupancyPct, activeStaff } = await res.json()

      const elRooms     = document.getElementById('statRooms')
      const elOccupancy = document.getElementById('statOccupancy')
      const elStaff     = document.getElementById('statStaff')

      if (elRooms)     elRooms.textContent     = totalRooms
      if (elOccupancy) elOccupancy.textContent = `${occupancyPct}%`
      if (elStaff)     elStaff.textContent     = activeStaff
    } catch {
      // Sin conexión: los valores quedan en "—"
    }
  })()

  // ── SISTEMA DE TEMAS DIA / NOCHE ──────────────────────────────────

  const DAY_START = 6; // 6:00 AM
  const DAY_END = 18; // 6:00 PM

  const root = document.documentElement;
  const themeToggle = document.getElementById("themeToggle");
  const themeLabel = document.getElementById("themeLabel");
  const themeTime = document.getElementById("themeTime");

  let manualOverride = false; // el usuario cambio el tema manualmente
  let currentTheme = "night";

  function getAutoTheme(): "day" | "night" {
    const h = new Date().getHours();
    return h >= DAY_START && h < DAY_END ? "day" : "night";
  }

  function applyTheme(theme: "day" | "night") {
    currentTheme = theme;
    if (theme === "day") {
      root.classList.add("day");
      if (themeLabel) themeLabel.textContent = "Modo noche";
    } else {
      root.classList.remove("day");
      if (themeLabel) themeLabel.textContent = "Modo dia";
    }
  }

  function updateClock() {
    const now = new Date();
    const h = String(now.getHours()).padStart(2, "0");
    const m = String(now.getMinutes()).padStart(2, "0");
    const s = String(now.getSeconds()).padStart(2, "0");
    const dia = ["Dom", "Lun", "Mar", "Mie", "Jue", "Vie", "Sab"][now.getDay()];
    const auto = getAutoTheme();

    if (themeTime) {
      themeTime.textContent =
        dia +
        "  " +
        h +
        ":" +
        m +
        ":" +
        s +
        "  ·  " +
        (auto === "day" ? "Horario diurno" : "Horario nocturno");
    }

    // Si no hay override manual, seguir el horario automatico
    if (!manualOverride && auto !== currentTheme) {
      applyTheme(auto);
    }
  }

  // Toggle manual
  themeToggle?.addEventListener("click", () => {
    manualOverride = true;
    applyTheme(currentTheme === "day" ? "night" : "day");

    // Resetear override despues de 2 horas para volver al automatico
    setTimeout(
      () => {
        manualOverride = false;
      },
      2 * 60 * 60 * 1000,
    );
  });

  // Inicializar con el tema correcto segun la hora
  applyTheme(getAutoTheme());
  updateClock();
  setInterval(updateClock, 1000);

  // ── TOGGLE CONTRASENA ────────────────────────────────────────────

  const togglePwd = document.getElementById("togglePwd");
  const pwdInput = document.getElementById("password");
  let visible = false;

  togglePwd?.addEventListener("click", () => {
    visible = !visible;
    if (pwdInput instanceof HTMLInputElement)
      pwdInput.type = visible ? "text" : "password";
    if (togglePwd) {
      togglePwd.innerHTML = visible
        ? `<path d="M17.94 17.94A10 10 0 0112 20c-7 0-11-8-11-8a18.45 18.45 0 015.06-5.94M9.9 4.24A9.12 9.12 0 0112 4c7 0 11 8 11 8a18.5 18.5 0 01-2.16 3.19"/><line x1="1" y1="1" x2="23" y2="23"/>`
        : `<path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/>`;
    }
  });

  // ── CHECKBOX RECORDAR ────────────────────────────────────────────

  const rememberBox = document.getElementById("rememberBox");
  const remember = document.getElementById("remember");
  const checkIcon = document.getElementById("checkIcon");

  function syncRemember() {
    if (!(remember instanceof HTMLInputElement)) return;
    const checked = remember.checked;
    if (checkIcon instanceof HTMLElement)
      checkIcon.style.display = checked ? "block" : "none";
    if (rememberBox instanceof HTMLElement) {
      rememberBox.style.borderColor = checked ? "var(--gold)" : "var(--border)";
      rememberBox.style.background = checked
        ? "var(--gold-dim)"
        : "transparent";
    }
  }

  rememberBox?.addEventListener("click", () => {
    if (remember instanceof HTMLInputElement) {
      remember.checked = !remember.checked;
      syncRemember();
    }
  });

  // Por si el usuario usa teclado u otro metodo
  remember?.addEventListener("change", syncRemember);

  // ── SUBMIT ───────────────────────────────────────────────────────

  const form = document.getElementById("loginForm");
  const submitBtn = document.getElementById("submitBtn");
  const errorMsg = document.getElementById("errorMsg");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    errorMsg?.classList.remove("show");

    const usernameEl = document.getElementById("username");
    const passwordEl = document.getElementById("password");
    const user =
      usernameEl instanceof HTMLInputElement ? usernameEl.value.trim() : "";
    const pass = passwordEl instanceof HTMLInputElement ? passwordEl.value : "";

    if (!user || !pass) {
      if (errorMsg)
        errorMsg.textContent = "Por favor completa todos los campos.";
      errorMsg?.classList.add("show");
      return;
    }

    if (submitBtn instanceof HTMLButtonElement) {
      submitBtn.classList.add("loading");
      submitBtn.disabled = true;
    }

    // ── Llamada real al backend ─────────────────────────────
    const API_URL = "http://localhost:3000";

    try {
      const res = await fetch(`${API_URL}/api/auth/login`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ username: user, password: pass }),
      });

      const data = await res.json();

      if (!res.ok) {
        if (submitBtn instanceof HTMLButtonElement) {
          submitBtn.classList.remove("loading");
          submitBtn.disabled = false;
        }
        if (errorMsg)
          errorMsg.textContent = data.error ?? "Credenciales incorrectas.";
        errorMsg?.classList.add("show");
        return;
      }

      // ── Login exitoso ─────────────────────────────────────
      sessionStorage.setItem("hotel_token", data.token);
      sessionStorage.setItem("hotel_user", data.user.username);
      sessionStorage.setItem("hotel_role", data.user.role);
      sessionStorage.setItem("hotel_fullname", data.user.fullName);
      sessionStorage.setItem("hotel_shift", data.user.shift);
      sessionStorage.setItem("hotel_id", data.user.id);

      if (submitBtn instanceof HTMLElement) {
        submitBtn.style.background = "var(--gold)";
        submitBtn.style.color = "var(--gold-btn-fg)";
        submitBtn.classList.remove("loading");
        const btnText = submitBtn.querySelector(".btn-text");
        if (btnText instanceof HTMLElement) {
          btnText.style.opacity = "1";
          btnText.textContent = "Acceso concedido ✓";
        }
      }

      setTimeout(() => {
        const role = data.user.role;
        if (role === "admin") window.location.href = "/admin/dashboard";
        if (role === "recepcion") window.location.href = "/recepcion/dashboard";
        if (role === "staff") window.location.href = "/staff/dashboard";
      }, 800);
    } catch (err) {
      if (submitBtn instanceof HTMLButtonElement) {
        submitBtn.classList.remove("loading");
        submitBtn.disabled = false;
      }
      if (errorMsg)
        errorMsg.textContent = "No se pudo conectar con el servidor.";
      errorMsg?.classList.add("show");
    }
  });
</script>
