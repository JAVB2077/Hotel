.inc-form select:focus,.inc-form textarea:focus,.inc-form input:focus{border-bottom-color:var(--gold)}
.inc-form select{cursor:pointer;appearance:none;background:transparent}
.inc-form label{font-size:8px;letter-spacing:.22em;text-transform:uppercase;color:var(--text-d);display:block;margin-bottom:3px}
