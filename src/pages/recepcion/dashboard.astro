/* OVERLAY */
.sidebar-overlay{display:none;position:fixed;inset:0;z-index:150;background:rgba(0,0,0,.65);backdrop-filter:blur(2px)}

/* RESPONSIVE */
@media(max-width:1200px){.topbar-kpis{display:none}.hk-summary{grid-template-columns:repeat(3,1fr)}}
@media(max-width:900px){.ci-layout{grid-template-columns:1fr}.ci-col{max-height:320px}.hk-layout{grid-template-columns:1fr}}
@media(max-width:768px){
  :root{--sidebar-w:250px}
  .sidebar{position:fixed;top:0;left:0;bottom:0;transform:translateX(-100%)}
  .sidebar.open{transform:translateX(0)}
  .sidebar-close{display:flex!important}
  .sidebar-overlay.open{display:block}
  .menu-btn{display:flex!important}
  .topbar{padding:0 14px}
  .section{padding:14px}
  .rooms-row{grid-template-columns:repeat(auto-fill,minmax(76px,1fr))}
  .inc-grid{grid-template-columns:1fr}
  .hk-summary{grid-template-columns:repeat(2,1fr)}
}
@media(max-width:480px){
  .rooms-row{grid-template-columns:repeat(auto-fill,minmax(66px,1fr));gap:5px}
  .floor-tab{padding:6px 10px;font-size:9px}
  .topbar-clock{display:none}
}
</style>

<script>
// ── SESIÓN ──────────────────────────────────────────────────────
const storedUser = sessionStorage.getItem('hotel_user') || 'Recepción';
const avatarEl = document.getElementById('userAvatar');
const sidebarUserEl = document.getElementById('sidebarUser');
if (avatarEl) avatarEl.textContent = storedUser.charAt(0).toUpperCase();
if (sidebarUserEl) sidebarUserEl.textContent = storedUser;

// ── TEMA ────────────────────────────────────────────────────────
const root = document.documentElement;
let manualOverride = false, currentTheme = 'night';
function getAutoTheme(){ const h=new Date().getHours(); return(h>=6&&h<18)?'day':'night'; }
function applyTheme(t: string){ currentTheme=t; t==='day'?root.classList.add('day'):root.classList.remove('day'); }
document.getElementById('themeToggleTop')?.addEventListener('click',()=>{manualOverride=true;applyTheme(currentTheme==='day'?'night':'day');setTimeout(()=>{manualOverride=false;},7200000);});
applyTheme(getAutoTheme());

// RELOJ
const clockEl=document.getElementById('topbarClock'),dateEl=document.getElementById('topbarDate');
function tick(){
  const now=new Date(),h=String(now.getHours()).padStart(2,'0'),m=String(now.getMinutes()).padStart(2,'0'),s=String(now.getSeconds()).padStart(2,'0');
  if(clockEl) clockEl.textContent=h+':'+m+':'+s;
  const dias=['Dom','Lun','Mar','Mié','Jue','Vie','Sáb'],meses=['Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Sep','Oct','Nov','Dic'];
  if(dateEl) dateEl.textContent=dias[now.getDay()]+' '+now.getDate()+' '+meses[now.getMonth()];
  if(!manualOverride&&getAutoTheme()!==currentTheme) applyTheme(getAutoTheme());
}
tick(); setInterval(tick,1000);

// ── NAVEGACIÓN ──────────────────────────────────────────────────
const navItems=document.querySelectorAll('.nav-item'),sections=document.querySelectorAll('.section');
const sectionLabel=document.getElementById('sectionLabel');
const secLabels: Record<string,string>={mapa:'Mapa de pisos',checkins:'Check-in / Check-out',incidencias:'Incidencias',housekeeping:'Housekeeping'};
navItems.forEach(btn=>{
  btn.addEventListener('click',()=>{
    const sec=btn.getAttribute('data-section')||'mapa';
    navItems.forEach(b=>b.classList.remove('active')); btn.classList.add('active');
    sections.forEach(s=>s.classList.remove('active')); document.getElementById('sec-'+sec)?.classList.add('active');
    if(sectionLabel) sectionLabel.textContent=secLabels[sec]||sec;
    if(window.innerWidth<768) closeSidebar();
  });
});
const sidebar=document.getElementById('sidebar'),overlay=document.getElementById('sidebarOverlay');
function openSidebar(){sidebar?.classList.add('open');overlay?.classList.add('open');document.body.style.overflow='hidden';}
function closeSidebar(){sidebar?.classList.remove('open');overlay?.classList.remove('open');document.body.style.overflow='';}
document.getElementById('menuBtn')?.addEventListener('click',openSidebar);
document.getElementById('sidebarClose')?.addEventListener('click',closeSidebar);
overlay?.addEventListener('click',closeSidebar);
document.getElementById('btnLogout')?.addEventListener('click',()=>{sessionStorage.removeItem('hotel_user');sessionStorage.removeItem('hotel_role');window.location.replace('/logIn');});

// ── MODAL ───────────────────────────────────────────────────────
const backdrop=document.getElementById('modalBackdrop');
function openModal(title: string, badge: string, badgeClass: string, body: string, footer: string){
  const mt=document.getElementById('modalTitle'),mb=document.getElementById('modalBadge'),mbd=document.getElementById('modalBody'),mf=document.getElementById('modalFooter');
  if(mt) mt.textContent=title;
  if(mb){ mb.textContent=badge; mb.className='modal-badge'; if(badgeClass) mb.classList.add(badgeClass); if(!badge) mb.style.display='none'; else mb.style.display=''; }
  if(mbd) mbd.innerHTML=body;
  if(mf) mf.innerHTML=footer;
  backdrop?.classList.add('open');
}
function closeModal(){ backdrop?.classList.remove('open'); }
document.getElementById('modalClose')?.addEventListener('click',closeModal);
backdrop?.addEventListener('click',(e)=>{ if(e.target===backdrop) closeModal(); });

// ── DATOS ───────────────────────────────────────────────────────
type RoomStatus = 'ocupada'|'libre-limpia'|'libre-sucia'|'reservada'|'checkout'|'mantenimiento'|'bloqueada';
interface Room { num: number; tipo: string; piso: number; status: RoomStatus; guest?: string; checkIn?: string; checkOut?: string; nights?: number; notas?: string; hasIncidence?: boolean; }

const tipoMap: Record<number,string> = {1:'Estándar',2:'Doble',3:'Suite',4:'Jr. Suite',5:'Suite Deluxe',6:'Piso Exec.',7:'Penthouse'};
const guestNames=['García, A.','Pérez, J.','López, M.','Ruiz, P.','Johnson','Martínez','Rodríguez','Sánchez','Morales','Hernández'];

function rng(seed: number){ let s=seed%2147483647; return ()=>{ s=(s*16807)%2147483647; return(s-1)/2147483646; }; }

// Generar 248 habitaciones distribuidas en 7 pisos
const rooms: Room[] = [];
const statusPool: RoomStatus[] = ['ocupada','ocupada','ocupada','ocupada','ocupada','ocupada','ocupada','ocupada','ocupada','libre-limpia','libre-limpia','libre-sucia','reservada','checkout','mantenimiento','bloqueada'];
let roomIdx=0;
for(let piso=1; piso<=7; piso++){
  const count = piso===7? 8 : piso===6? 24 : 36;
  const rand = rng(piso*31);
  for(let i=0; i<count; i++){
    const num = piso*100+(i+1);
    const stIdx = Math.floor(rand()*statusPool.length);
    const st = statusPool[stIdx];
    const gIdx = Math.floor(rand()*guestNames.length);
    const hasInc = rand()<0.08;
    rooms.push({
      num, tipo: tipoMap[piso]||'Estándar', piso, status: st,
      guest: (st==='ocupada'||st==='checkout') ? guestNames[gIdx] : undefined,
      checkIn: st==='ocupada'?'03 Mar':st==='checkout'?'01 Mar':undefined,
      checkOut: st==='ocupada'?'08 Mar':st==='checkout'?'05 Mar':undefined,
      nights: st==='ocupada'?5:st==='checkout'?4:undefined,
      hasIncidence: (st==='ocupada'||st==='checkout') && hasInc,
    });
    roomIdx++;
  }
}

const statusLabels: Record<RoomStatus,string>={'ocupada':'Ocupada','libre-limpia':'Libre · Limpia','libre-sucia':'Libre · Sucia','reservada':'Reservada hoy','checkout':'Check-out hoy','mantenimiento':'Mantenimiento','bloqueada':'Bloqueada'};
const statusBadgeClass: Record<RoomStatus,string>={'ocupada':'inc-tipo solicitud','libre-limpia':'inc-tipo limpieza','libre-sucia':'inc-tipo','checkout':'inc-tipo tecnico','reservada':'inc-tipo tecnico','mantenimiento':'inc-tipo urgente','bloqueada':'inc-tipo resuelta'};

// Actualizar KPIs topbar
function updateTopbarKpis(){
  const ocupadas=rooms.filter(r=>r.status==='ocupada').length;
  const libres=rooms.filter(r=>r.status==='libre-limpia'||r.status==='libre-sucia').length;
  const checkins=rooms.filter(r=>r.status==='reservada').length;
  const incs=incidencias.filter(i=>i.estado!=='resuelta').length;
  const el=document.getElementById;
  const t=(id: string,val: number)=>{ const e=document.getElementById(id); if(e) e.textContent=String(val); };
  t('tkOcupadas',ocupadas); t('tkLibres',libres); t('tkCheckins',checkins); t('tkIncidencias',incs);
  const nc=document.getElementById('notifCount'); if(nc) nc.textContent=String(incs);
  const nb=document.getElementById('navBadge'); if(nb){ nb.textContent=String(incs); }
}

// ── MAPA DE PISOS ───────────────────────────────────────────────
const floorTabs=document.getElementById('floorTabs'), floorContainer=document.getElementById('floorContainer');
let currentFloor=0; // 0 = todos

function buildFloorMap(floor: number, searchQ=''){
  if(!floorContainer) return;
  const q=searchQ.toLowerCase();
  const filtered=rooms.filter(r=>(floor===0||r.piso===floor)&&(!q||String(r.num).includes(q)||(r.guest||'').toLowerCase().includes(q)));

  if(floor===0){
    // agrupar por piso
    const byFloor: Record<number,Room[]> = {};
    filtered.forEach(r=>{ (byFloor[r.piso]||(byFloor[r.piso]=[])).push(r); });
    floorContainer.innerHTML='';
    Object.keys(byFloor).sort((a,b)=>Number(a)-Number(b)).forEach(p=>{
      const sec=document.createElement('div'); sec.className='floor-section';
      const lbl=document.createElement('div'); lbl.className='floor-label'; lbl.textContent='Piso '+p;
      sec.appendChild(lbl);
      const row=document.createElement('div'); row.className='rooms-row';
      byFloor[Number(p)].forEach(r=>{ row.appendChild(makeRoomCard(r)); });
      sec.appendChild(row); floorContainer.appendChild(sec);
    });
  } else {
    floorContainer.innerHTML='';
    const sec=document.createElement('div'); sec.className='floor-section';
    const lbl=document.createElement('div'); lbl.className='floor-label'; lbl.textContent='Piso '+floor;
    sec.appendChild(lbl);
    const row=document.createElement('div'); row.className='rooms-row';
    filtered.forEach(r=>{ row.appendChild(makeRoomCard(r)); });
    sec.appendChild(row); floorContainer.appendChild(sec);
  }
}

function makeRoomCard(r: Room): HTMLElement {
  const card=document.createElement('div');
  card.className='room-card rc-'+r.status+(r.hasIncidence?' has-incidence':'');
  card.innerHTML=`<div><div class="rc-num">${r.num}</div><div class="rc-type">${r.tipo}</div></div><div class="rc-bottom"><span class="rc-guest">${r.guest||statusLabels[r.status].split('·')[0].trim()}</span><span class="rc-status-dot rc-${r.status}"></span></div>`;
  card.addEventListener('click',()=>openRoomModal(r));
  return card;
}

function openRoomModal(r: Room){
  const body=`
    <div class="detail-grid">
      <div class="detail-item"><span class="detail-label">Número</span><span class="detail-val">${r.num}</span></div>
      <div class="detail-item"><span class="detail-label">Tipo</span><span class="detail-val">${r.tipo}</span></div>
      <div class="detail-item"><span class="detail-label">Piso</span><span class="detail-val">${r.piso}°</span></div>
      <div class="detail-item"><span class="detail-label">Estado actual</span><span class="detail-val">${statusLabels[r.status]}</span></div>
      ${r.guest?`<div class="detail-item"><span class="detail-label">Huésped</span><span class="detail-val">${r.guest}</span></div>`:''}
      ${r.checkIn?`<div class="detail-item"><span class="detail-label">Check-in</span><span class="detail-val">${r.checkIn}</span></div>`:''}
      ${r.checkOut?`<div class="detail-item"><span class="detail-label">Check-out</span><span class="detail-val">${r.checkOut}</span></div>`:''}
      ${r.nights?`<div class="detail-item"><span class="detail-label">Noches</span><span class="detail-val">${r.nights}</span></div>`:''}
    </div>
    <div style="margin-top:16px">
      <label class="detail-label" style="display:block;margin-bottom:6px">Cambiar estado</label>
      <select class="status-select" id="modalStatusSel">
        <option value="ocupada" ${r.status==='ocupada'?'selected':''}>Ocupada</option>
        <option value="libre-limpia" ${r.status==='libre-limpia'?'selected':''}>Libre · Limpia</option>
        <option value="libre-sucia" ${r.status==='libre-sucia'?'selected':''}>Libre · Sucia</option>
        <option value="reservada" ${r.status==='reservada'?'selected':''}>Reservada hoy</option>
        <option value="checkout" ${r.status==='checkout'?'selected':''}>Check-out hoy</option>
        <option value="mantenimiento" ${r.status==='mantenimiento'?'selected':''}>Mantenimiento</option>
        <option value="bloqueada" ${r.status==='bloqueada'?'selected':''}>Bloqueada</option>
      </select>
    </div>
    ${r.hasIncidence?`<div style="margin-top:12px;padding:10px;background:var(--red-dim);border:1px solid rgba(224,85,85,.2);font-size:11px;color:var(--red)">⚠ Esta habitación tiene una incidencia activa</div>`:''}
  `;
  const footer=`<button class="btn-ghost" onclick="closeModal()">Cancelar</button><button class="btn-primary" onclick="saveRoomStatus(${r.num})"><span>Guardar</span></button>`;
  openModal('Habitación '+r.num, statusLabels[r.status], r.status==='ocupada'?'inc-tipo solicitud':r.status==='libre-limpia'?'inc-tipo limpieza':r.status==='mantenimiento'?'inc-tipo urgente':'inc-tipo', body, footer);
}

(window as any).saveRoomStatus=(num: number)=>{
  const sel=document.getElementById('modalStatusSel') as HTMLSelectElement;
  if(!sel) return;
  const room=rooms.find(r=>r.num===num);
  if(room){ room.status=sel.value as RoomStatus; }
  closeModal();
  buildFloorMap(currentFloor, (document.getElementById('roomSearch') as HTMLInputElement)?.value||'');
  updateTopbarKpis();
};
(window as any).closeModal=closeModal;

// Floor tabs
function buildFloorTabs(){
  if(!floorTabs) return;
  floorTabs.innerHTML='';
  const allBtn=document.createElement('button'); allBtn.className='floor-tab active'; allBtn.textContent='Todos'; allBtn.setAttribute('data-floor','0');
  floorTabs.appendChild(allBtn);
  for(let i=1;i<=7;i++){
    const btn=document.createElement('button'); btn.className='floor-tab'; btn.textContent='P'+i; btn.setAttribute('data-floor',String(i));
    floorTabs.appendChild(btn);
  }
  floorTabs.addEventListener('click',(e)=>{
    const btn=(e.target as HTMLElement).closest('.floor-tab'); if(!btn) return;
    document.querySelectorAll('.floor-tab').forEach(b=>b.classList.remove('active')); btn.classList.add('active');
    currentFloor=Number(btn.getAttribute('data-floor'));
    buildFloorMap(currentFloor,(document.getElementById('roomSearch') as HTMLInputElement)?.value||'');
  });
}
buildFloorTabs();
buildFloorMap(0);

document.getElementById('roomSearch')?.addEventListener('input',(e)=>{
  buildFloorMap(currentFloor,(e.target as HTMLInputElement).value);
});

// ── CHECK-IN / OUT ───────────────────────────────────────────────
interface CIEntry { id:number; nombre:string; hab:number; tipo:string; entrada:string; salida:string; noches:number; pax:number; notas:string; estado:'pendiente'|'en-casa'|'checkout'; }
const ciData: CIEntry[] = [
  {id:1,nombre:'Alejandro Torres',hab:205,tipo:'Jr. Suite',entrada:'05 Mar',salida:'09 Mar',noches:4,pax:2,notas:'Solicita cuna extra',estado:'pendiente'},
  {id:2,nombre:'Familia Morales',hab:401,tipo:'Jr. Suite',entrada:'05 Mar',salida:'12 Mar',noches:7,pax:4,notas:'Llegada 14:00 hrs',estado:'pendiente'},
  {id:3,nombre:'Ms. Williams',hab:607,tipo:'Piso Exec.',entrada:'05 Mar',salida:'07 Mar',noches:2,pax:1,notas:'Early check-in solicitado',estado:'pendiente'},
  {id:4,nombre:'Juan Pérez',hab:312,tipo:'Suite Deluxe',entrada:'03 Mar',salida:'08 Mar',noches:5,pax:2,notas:'—',estado:'en-casa'},
  {id:5,nombre:'Familia García',hab:401,tipo:'Jr. Suite',entrada:'03 Mar',salida:'12 Mar',noches:9,pax:4,notas:'VIP',estado:'en-casa'},
  {id:6,nombre:'Mr. Johnson',hab:501,tipo:'Suite Deluxe',entrada:'02 Mar',salida:'15 Mar',noches:13,pax:1,notas:'Corporativo',estado:'en-casa'},
  {id:7,nombre:'Ana López',hab:201,tipo:'Doble',entrada:'01 Mar',salida:'05 Mar',noches:4,pax:2,notas:'—',estado:'checkout'},
  {id:8,nombre:'Pedro Ruiz',hab:318,tipo:'Estándar',entrada:'02 Mar',salida:'05 Mar',noches:3,pax:1,notas:'—',estado:'checkout'},
];

function renderCILists(){
  const pend=ciData.filter(c=>c.estado==='pendiente'),incasa=ciData.filter(c=>c.estado==='en-casa'),cout=ciData.filter(c=>c.estado==='checkout');
  const fill=(listId: string,data: CIEntry[],btnLabel: string,btnClass: string,action: string)=>{
    const el=document.getElementById(listId); if(!el) return;
    el.innerHTML=''; data.forEach((c,i)=>{
      const div=document.createElement('div'); div.className='ci-card'; div.style.animationDelay=(i*0.05)+'s';
      div.innerHTML=`<div class="ci-card-top"><div><div class="ci-name">${c.nombre}</div><div class="ci-detail">${c.entrada} → ${c.salida} · <span class="ci-nights">${c.noches}n</span> · ${c.pax} pax</div></div><div class="ci-hab">${c.hab}</div></div><div style="font-size:10px;color:var(--text-d);margin-bottom:4px">${c.tipo}</div>${c.notas!=='—'?`<div style="font-size:9px;color:var(--amber);margin-bottom:6px">📝 ${c.notas}</div>`:''}<div class="ci-actions"><button class="ci-btn" onclick="verCI(${c.id})">Ver detalle</button><button class="ci-btn primary" onclick="${action}(${c.id})">${btnLabel}</button></div>`;
      el.appendChild(div);
    });
  };
  fill('ciPendList',pend,'Check-in','primary','doCheckin');
  fill('ciIncasaList',incasa,'Ampliar estancia','','ampliarCI');
  fill('ciOutList',cout,'Check-out','primary','doCheckout');
  const c1=document.getElementById('ciPendCount'),c2=document.getElementById('ciIncasaCount'),c3=document.getElementById('ciOutCount');
  if(c1) c1.textContent=String(pend.length); if(c2) c2.textContent=String(incasa.length); if(c3) c3.textContent=String(cout.length);
}
renderCILists();

(window as any).verCI=(id: number)=>{
  const c=ciData.find(x=>x.id===id); if(!c) return;
  openModal(c.nombre,'Hab. '+c.hab,'inc-tipo solicitud',`<div class="detail-grid"><div class="detail-item"><span class="detail-label">Habitación</span><span class="detail-val">${c.hab} · ${c.tipo}</span></div><div class="detail-item"><span class="detail-label">Huéspedes</span><span class="detail-val">${c.pax} pax</span></div><div class="detail-item"><span class="detail-label">Check-in</span><span class="detail-val">${c.entrada}</span></div><div class="detail-item"><span class="detail-label">Check-out</span><span class="detail-val">${c.salida}</span></div><div class="detail-item"><span class="detail-label">Noches</span><span class="detail-val">${c.noches}</span></div><div class="detail-item"><span class="detail-label">Notas</span><span class="detail-val">${c.notas}</span></div></div>`,`<button class="btn-ghost" onclick="closeModal()">Cerrar</button>`);
};
(window as any).doCheckin=(id: number)=>{
  const c=ciData.find(x=>x.id===id); if(!c) return;
  c.estado='en-casa';
  const r=rooms.find(x=>x.num===c.hab); if(r){ r.status='ocupada'; r.guest=c.nombre.split(' ')[1]||c.nombre; }
  renderCILists(); buildFloorMap(currentFloor); updateTopbarKpis();
  openModal('Check-in realizado','✓ Completado','inc-tipo limpieza',`<p style="color:var(--text)">El huésped <strong>${c.nombre}</strong> ha ingresado a la habitación <strong>${c.hab}</strong>.</p>`,`<button class="btn-ghost" onclick="closeModal()">Cerrar</button>`);
};
(window as any).doCheckout=(id: number)=>{
  const c=ciData.find(x=>x.id===id); if(!c) return;
  c.estado='en-casa';
  const r=rooms.find(x=>x.num===c.hab); if(r){ r.status='libre-sucia'; r.guest=undefined; }
  ciData.splice(ciData.indexOf(c),1);
  renderCILists(); buildFloorMap(currentFloor); updateTopbarKpis();
  // Agregar a cola housekeeping
  hkQueue.unshift({hab:c.hab,tipo:'Limpieza post check-out',prioridad:'alta',tiempo:'Ahora',asignada:false});
  renderHK();
  openModal('Check-out realizado','✓ Completado','inc-tipo limpieza',`<p style="color:var(--text)">Check-out de <strong>${c.nombre}</strong> (hab. ${c.hab}) completado. Habitación enviada a cola de limpieza.</p>`,`<button class="btn-ghost" onclick="closeModal()">Cerrar</button>`);
};
(window as any).ampliarCI=(id: number)=>{
  openModal('Ampliar estancia','','',`<p style="color:var(--text-m);margin-bottom:12px">Funcionalidad disponible al conectar el backend.</p>`,`<button class="btn-ghost" onclick="closeModal()">Cerrar</button>`);
};

// ── INCIDENCIAS ──────────────────────────────────────────────────
interface Incidencia { id:number; hab:number; tipo:'urgente'|'solicitud'|'limpieza'|'tecnico'|'resuelta'; desc:string; tiempo:string; estado:'activa'|'resuelta'; }
let incidencias: Incidencia[] = [
  {id:1,hab:312,tipo:'urgente',desc:'Fuga de agua en el baño, el huésped reporta agua en el piso.',tiempo:'Hace 10 min',estado:'activa'},
  {id:2,hab:205,tipo:'solicitud',desc:'Solicita almohadas adicionales y botella de vino.',tiempo:'Hace 25 min',estado:'activa'},
  {id:3,hab:401,tipo:'limpieza',desc:'Servicio de habitación solicitado. Prefieren después de las 11am.',tiempo:'Hace 40 min',estado:'activa'},
  {id:4,hab:607,tipo:'tecnico',desc:'Control remoto del TV no funciona, solicita reemplazo.',tiempo:'Hace 1 h',estado:'activa'},
  {id:5,hab:501,tipo:'solicitud',desc:'Room service: desayuno continental para dos personas.',tiempo:'Hace 1.5 h',estado:'activa'},
  {id:6,hab:318,tipo:'tecnico',desc:'Aire acondicionado hace ruido al encender.',tiempo:'Hace 2 h',estado:'activa'},
  {id:7,hab:103,tipo:'limpieza',desc:'Servicio completo de habitación solicitado.',tiempo:'Hace 3 h',estado:'resuelta'},
  {id:8,hab:214,tipo:'solicitud',desc:'Solicita plancha y tabla de planchar.',tiempo:'Hace 4 h',estado:'resuelta'},
];
let incNextId=9;

function renderIncidencias(filter='todas'){
  const grid=document.getElementById('incGrid'); if(!grid) return;
  const filtered=filter==='todas'?incidencias:filter==='resuelta'?incidencias.filter(i=>i.estado==='resuelta'):incidencias.filter(i=>i.tipo===filter&&i.estado!=='resuelta');
  grid.innerHTML='';
  filtered.forEach((inc,idx)=>{
    const card=document.createElement('div'); card.className='inc-card '+(inc.estado==='resuelta'?'resuelta':inc.tipo);
    card.style.animationDelay=(idx*0.04)+'s';
    card.innerHTML=`<div class="inc-top"><span class="inc-tipo ${inc.tipo}">${inc.tipo}</span><span class="inc-hab">${inc.hab}</span></div><p class="inc-desc">${inc.desc}</p><div class="inc-footer"><span class="inc-time">${inc.tiempo}</span><button class="inc-resolve-btn ${inc.estado==='resuelta'?'resolved':''}" onclick="resolveInc(${inc.id})">${inc.estado==='resuelta'?'✓ Resuelta':'Marcar resuelta'}</button></div>`;
    card.addEventListener('click',(e)=>{ if((e.target as HTMLElement).classList.contains('inc-resolve-btn')) return; openIncModal(inc); });
    grid.appendChild(card);
  });
}
renderIncidencias();

function openIncModal(inc: Incidencia){
  openModal('Incidencia · Hab. '+inc.hab,inc.tipo,'inc-tipo '+inc.tipo,`<p style="margin-bottom:14px;color:var(--text)">${inc.desc}</p><div class="detail-grid"><div class="detail-item"><span class="detail-label">Habitación</span><span class="detail-val">${inc.hab}</span></div><div class="detail-item"><span class="detail-label">Tipo</span><span class="detail-val">${inc.tipo}</span></div><div class="detail-item"><span class="detail-label">Tiempo</span><span class="detail-val">${inc.tiempo}</span></div><div class="detail-item"><span class="detail-label">Estado</span><span class="detail-val">${inc.estado}</span></div></div>`,`<button class="btn-ghost" onclick="closeModal()">Cerrar</button><button class="btn-primary" onclick="resolveInc(${inc.id});closeModal()"><span>${inc.estado==='resuelta'?'Reabrir':'Marcar resuelta'}</span></button>`);
}

(window as any).resolveInc=(id: number)=>{
  const inc=incidencias.find(x=>x.id===id); if(!inc) return;
  inc.estado=inc.estado==='activa'?'resuelta':'activa';
  const active=document.querySelector(`[data-inc-filter]`);
  renderIncidencias((document.querySelector('.inc-filters .filter-btn.active') as HTMLElement)?.getAttribute('data-inc')||'todas');
  updateTopbarKpis();
};

document.querySelectorAll('[data-inc]').forEach(btn=>{
  btn.addEventListener('click',()=>{ document.querySelectorAll('[data-inc]').forEach(b=>b.classList.remove('active')); btn.classList.add('active'); renderIncidencias(btn.getAttribute('data-inc')||'todas'); });
});

document.getElementById('btnNuevaInc')?.addEventListener('click',()=>{
  openModal('Nueva incidencia','','',`<div class="inc-form"><div class="field"><label>Habitación</label><input id="nif-hab" type="number" placeholder="Ej. 312" /></div><div class="field"><label>Tipo</label><select id="nif-tipo"><option value="urgente">Urgente</option><option value="solicitud" selected>Solicitud</option><option value="limpieza">Limpieza</option><option value="tecnico">Técnico</option></select></div><div class="field"><label>Descripción</label><textarea id="nif-desc" rows="3" placeholder="Describe la incidencia…"></textarea></div></div>`,`<button class="btn-ghost" onclick="closeModal()">Cancelar</button><button class="btn-primary" onclick="saveNewInc()"><span>Guardar</span></button>`);
});

(window as any).saveNewInc=()=>{
  const hab=parseInt((document.getElementById('nif-hab') as HTMLInputElement).value);
  const tipo=(document.getElementById('nif-tipo') as HTMLSelectElement).value as any;
  const desc=(document.getElementById('nif-desc') as HTMLTextAreaElement).value.trim();
  if(!hab||!desc){ alert('Completa todos los campos.'); return; }
  incidencias.unshift({id:incNextId++,hab,tipo,desc,tiempo:'Ahora',estado:'activa'});
  closeModal();
  renderIncidencias((document.querySelector('.inc-filters .filter-btn.active') as HTMLElement)?.getAttribute('data-inc')||'todas');
  updateTopbarKpis();
};

// ── HOUSEKEEPING ─────────────────────────────────────────────────
interface HKItem { hab:number; tipo:string; prioridad:'alta'|'media'|'baja'; tiempo:string; asignada:boolean; }
let hkQueue: HKItem[] = [
  {hab:204,tipo:'Limpieza post check-out',prioridad:'alta',tiempo:'08:30',asignada:false},
  {hab:317,tipo:'Limpieza post check-out',prioridad:'alta',tiempo:'09:00',asignada:false},
  {hab:102,tipo:'Servicio de habitación',prioridad:'media',tiempo:'10:00',asignada:false},
  {hab:405,tipo:'Cambio de sábanas',prioridad:'media',tiempo:'10:30',asignada:false},
  {hab:218,tipo:'Limpieza estándar',prioridad:'baja',tiempo:'11:00',asignada:false},
  {hab:511,tipo:'Limpieza estándar',prioridad:'baja',tiempo:'11:30',asignada:false},
];
const hkDoneItems: HKItem[] = [
  {hab:103,tipo:'Limpieza post check-out',prioridad:'alta',tiempo:'07:45',asignada:true},
  {hab:209,tipo:'Servicio de habitación',prioridad:'media',tiempo:'08:15',asignada:true},
  {hab:301,tipo:'Cambio de toallas',prioridad:'baja',tiempo:'09:10',asignada:true},
];

function renderHK(){
  // Summary
  const hkSummary=document.getElementById('hkSummary');
  if(hkSummary){
    const libSucValues=rooms.filter(r=>r.status==='libre-sucia').length;
    const libre=rooms.filter(r=>r.status==='libre-limpia').length;
    const occ=rooms.filter(r=>r.status==='ocupada').length;
    const mnt=rooms.filter(r=>r.status==='mantenimiento').length;
    const co=rooms.filter(r=>r.status==='checkout').length;
    const stats=[
      {val:libSucValues,lbl:'Libre · Sucia',color:'var(--amber)'},
      {val:hkQueue.length,lbl:'En cola limpieza',color:'var(--red)'},
      {val:hkDoneItems.length,lbl:'Limpias hoy',color:'var(--green)'},
      {val:mnt,lbl:'Mantenimiento',color:'var(--red)'},
      {val:co,lbl:'Check-out hoy',color:'var(--teal)'},
    ];
    hkSummary.innerHTML='';
    stats.forEach((s,i)=>{ const d=document.createElement('div'); d.className='hk-stat'; d.style.setProperty('--i',String(i)); d.innerHTML=`<span class="hk-stat-val" style="color:${s.color}">${s.val}</span><span class="hk-stat-lbl">${s.lbl}</span>`; hkSummary.appendChild(d); });
  }

  // Queue
  const qEl=document.getElementById('hkQueue'),qc=document.getElementById('hkQueueCount');
  if(qEl){ qEl.innerHTML=''; hkQueue.forEach((item,i)=>{ const div=document.createElement('div'); div.className='hk-item'; div.style.animationDelay=(i*0.04)+'s'; div.innerHTML=`<div class="hk-priority ${item.prioridad}"></div><div class="hk-info"><div class="hk-num">Hab. ${item.hab}</div><div class="hk-type">${item.tipo}</div></div><span class="hk-time">${item.tiempo}</span><button class="hk-assign" onclick="assignHK(${item.hab})">Asignar</button>`; qEl.appendChild(div); }); }
  if(qc) qc.textContent=hkQueue.length+' pendientes';

  // Done
  const dEl=document.getElementById('hkDone'),dc=document.getElementById('hkDoneCount');
  if(dEl){ dEl.innerHTML=''; hkDoneItems.forEach((item,i)=>{ const div=document.createElement('div'); div.className='hk-item'; div.style.animationDelay=(i*0.04)+'s'; div.innerHTML=`<div class="hk-priority ${item.prioridad}"></div><div class="hk-info"><div class="hk-num">Hab. ${item.hab}</div><div class="hk-type">${item.tipo}</div></div><span class="hk-time">${item.tiempo}</span><button class="hk-assign done">✓ Lista</button>`; dEl.appendChild(div); }); }
  if(dc) dc.textContent=String(hkDoneItems.length);
}
renderHK();

(window as any).assignHK=(hab: number)=>{
  const idx=hkQueue.findIndex(x=>x.hab===hab); if(idx<0) return;
  const item=hkQueue.splice(idx,1)[0];
  item.asignada=true; item.tiempo=new Date().toLocaleTimeString('es-MX',{hour:'2-digit',minute:'2-digit'});
  hkDoneItems.unshift(item);
  const r=rooms.find(x=>x.num===hab);
  if(r&&r.status==='libre-sucia') r.status='libre-limpia';
  renderHK(); buildFloorMap(currentFloor); updateTopbarKpis();
};

// Notif btn → ir a incidencias
document.getElementById('notifBtn')?.addEventListener('click',()=>{
  document.querySelectorAll('.nav-item').forEach(b=>b.classList.remove('active'));
  document.querySelector('[data-section="incidencias"]')?.classList.add('active');
  sections.forEach(s=>s.classList.remove('active'));
  document.getElementById('sec-incidencias')?.classList.add('active');
  if(sectionLabel) sectionLabel.textContent='Incidencias';
});

updateTopbarKpis();
</script>1