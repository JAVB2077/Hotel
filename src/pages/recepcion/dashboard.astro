---
// src/pages/recepcion/dashboard.astro
import Distribucion from '../../components/distribucion.astro';
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Jost:wght@200;300;400;500&display=swap"
  rel="stylesheet"
/>

<script is:inline>
  const _r = sessionStorage.getItem("hotel_role");
  const _u = sessionStorage.getItem("hotel_user");
  if (!_u || (_r !== "admin" && _r !== "recepcion"))
    window.location.replace("/logIn");

  // ── CHECK-IN / CHECKOUT desde API ───────────────────────────────
  async function loadCILists() {
    const data = await apiFetch("GET", "/api/reservations/today");
    if (!data) return;
    const ciPending  = document.getElementById("ciPending");
    const ciInhouse  = document.getElementById("ciInhouse");
    const ciCheckout = document.getElementById("ciCheckout");
    const fmt = (d) => (d ? d.slice(5).replace("-", "/") : "—");

    const cardCI = (r) => `<div class="ci-card">
      <div class="ci-name">${r.guestName || "—"}</div>
      <div class="ci-room">Hab. ${r.roomNumber || "—"} · ${r.checkInDate ? fmt(r.checkInDate) : "—"} → ${r.checkOutDate ? fmt(r.checkOutDate) : "—"}</div>
      ${r.specialRequests ? `<div class="ci-note">${r.specialRequests}</div>` : ""}
      <button onclick="doCheckin('${r.id}')" style="margin-top:8px;background:var(--gold);color:#0A0A0B;border:none;padding:6px 16px;font-size:10px;font-family:Jost,sans-serif;letter-spacing:.12em;cursor:pointer">CHECK-IN</button>
    </div>`;

    const cardCO = (r) => `<div class="ci-card">
      <div class="ci-name">${r.guestName || "—"}</div>
      <div class="ci-room">Hab. ${r.roomNumber || "—"} · desde ${r.checkInDate ? fmt(r.checkInDate) : "—"}</div>
      <button onclick="doCheckout('${r.id}')" style="margin-top:8px;background:var(--teal);color:#0A0A0B;border:none;padding:6px 16px;font-size:10px;font-family:Jost,sans-serif;letter-spacing:.12em;cursor:pointer">CHECK-OUT</button>
    </div>`;

    if (ciPending)
      ciPending.innerHTML =
        (data.checkins || []).map(cardCI).join("") ||
        '<div style="color:var(--text-d);font-size:11px">Sin check-ins pendientes</div>';
    if (ciInhouse)
      ciInhouse.innerHTML =
        (data.checkins || [])
          .filter((r) => r.status === "checked_in")
          .map(
            (r) => `<div class="ci-card"><div class="ci-name">${r.guestName || "—"}</div><div class="ci-room">Hab. ${r.roomNumber || "—"}</div></div>`,
          )
          .join("") ||
        '<div style="color:var(--text-d);font-size:11px">Sin huéspedes en casa hoy</div>';
    if (ciCheckout)
      ciCheckout.innerHTML =
        (data.checkouts || []).map(cardCO).join("") ||
        '<div style="color:var(--text-d);font-size:11px">Sin check-outs pendientes</div>';
  }

  async function doCheckin(id) {
    const r = await apiFetch("PATCH", "/api/reservations/" + id + "/checkin");
    if (r?.success) {
      showToast("Check-in realizado ✓");
      loadCILists();
      loadTopbarKpis();
      updateRoomsFromAPI();
    } else showToast("Error al realizar check-in", "error");
  }
  async function doCheckout(id) {
    const r = await apiFetch("PATCH", "/api/reservations/" + id + "/checkout");
    if (r?.success) {
      showToast("Check-out realizado ✓ — Hab. añadida a Housekeeping");
      loadCILists();
      loadTopbarKpis();
      updateRoomsFromAPI();
    } else showToast("Error al realizar check-out", "error");
  }

  // ── WebSocket tiempo real ────────────────────────────────────────
  function conectarWS() {
    const role  = sessionStorage.getItem("hotel_role") || "recepcion";
    const token = sessionStorage.getItem("hotel_token") || "";
    const wsUrl = API.replace("http", "ws");
    const ws    = new WebSocket(wsUrl + "/live?role=" + role + "&token=" + token);
    ws.onopen = () => {
      setInterval(
        () => ws.readyState === 1 && ws.send(JSON.stringify({ type: "ping" })),
        30000,
      );
    };
    ws.onmessage = ({ data }) => {
      try {
        const msg = JSON.parse(data);
        if (msg.type === "new_incident") {
          loadIncidencias();
          showToast("⚠ Nueva incidencia: " + (msg.incident?.title || ""), "warning");
        }
        if (msg.type === "checkin" || msg.type === "checkout") {
          loadCILists();
          loadTopbarKpis();
          updateRoomsFromAPI();
        }
        if (msg.type === "room_status") {
          updateRoomsFromAPI();
        }
      } catch {}
    };
    ws.onclose = () => setTimeout(conectarWS, 3000);
  }

  // ── INICIALIZACIÓN ───────────────────────────────────────────────
  document.addEventListener("DOMContentLoaded", () => {
    loadTopbarKpis();
    loadCILists();
    loadIncidencias();
    conectarWS();
  });
</script>

<div class="shell">
  <!-- SIDEBAR -->
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-top">
      <div class="brand-mark">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M3 21h18M3 7l9-4 9 4M4 7v14M20 7v14M8 10v4M12 10v4M16 10v4"></path>
        </svg>
      </div>
      <div class="brand-info">
        <span class="brand-name">Grand <em>Élite</em></span>
        <span class="brand-role">Recepción</span>
      </div>
      <button class="sidebar-close" id="sidebarClose">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M18 6L6 18M6 6l12 12"></path>
        </svg>
      </button>
    </div>
    <nav class="nav">
      <button class="nav-item active" data-section="mapa">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <rect x="3" y="3" width="7" height="7"></rect>
          <rect x="14" y="3" width="7" height="7"></rect>
          <rect x="3" y="14" width="7" height="7"></rect>
          <rect x="14" y="14" width="7" height="7"></rect>
        </svg>
        <span>Mapa de pisos</span>
      </button>
      <button class="nav-item" data-section="checkins">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M16 17l5-5-5-5M21 12H9"></path>
          <path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"></path>
        </svg>
        <span>Check-in / Out</span>
      </button>
      <button class="nav-item" data-section="incidencias">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <span>Incidencias</span>
        <span class="nav-badge" id="navBadge">0</span>
      </button>
      <button class="nav-item" data-section="housekeeping">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"></path>
          <polyline points="9 22 9 12 15 12 15 22"></polyline>
        </svg>
        <span>Housekeeping</span>
      </button>
    </nav>
    <!-- LEYENDA -->
    <div class="sidebar-legend">
      <div class="leg-title">Leyenda</div>
      <div class="leg-item"><span class="leg-dot ld-ocupada"></span>Ocupada</div>
      <div class="leg-item"><span class="leg-dot ld-libre-limpia"></span>Libre limpia</div>
      <div class="leg-item"><span class="leg-dot ld-libre-sucia"></span>Libre sucia</div>
      <div class="leg-item"><span class="leg-dot ld-reservada"></span>Reservada hoy</div>
      <div class="leg-item"><span class="leg-dot ld-checkout"></span>Check-out hoy</div>
      <div class="leg-item"><span class="leg-dot ld-mantenimiento"></span>Mantenimiento</div>
      <div class="leg-item"><span class="leg-dot ld-bloqueada"></span>Bloqueada</div>
    </div>
    <div class="sidebar-footer">
      <div class="user-chip">
        <div class="user-avatar" id="userAvatar">R</div>
        <div class="user-info">
          <span class="user-name" id="sidebarUser">Recepción</span>
          <span class="user-dept">Front Desk</span>
        </div>
      </div>
      <button class="btn-logout" id="btnLogout">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4M16 17l5-5-5-5M21 12H9"></path>
        </svg>
      </button>
    </div>
  </aside>

  <!-- MAIN -->
  <main class="main">
    <header class="topbar">
      <div class="topbar-left">
        <button class="menu-btn" id="menuBtn">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
        <div class="topbar-title">
          <span class="section-label" id="sectionLabel">Mapa de pisos</span>
          <span class="topbar-date" id="topbarDate"></span>
        </div>
      </div>
      <div class="topbar-right">
        <div class="topbar-kpis" id="topbarKpis">
          <div class="tkpi">
            <span class="tkpi-val" id="tkOcupadas">—</span>
            <span class="tkpi-lbl">Ocupadas</span>
          </div>
          <div class="tkpi-div"></div>
          <div class="tkpi">
            <span class="tkpi-val green" id="tkLibres">—</span>
            <span class="tkpi-lbl">Libres</span>
          </div>
          <div class="tkpi-div"></div>
          <div class="tkpi">
            <span class="tkpi-val gold" id="tkCheckins">—</span>
            <span class="tkpi-lbl">CI hoy</span>
          </div>
          <div class="tkpi-div"></div>
          <div class="tkpi">
            <span class="tkpi-val amber" id="tkIncidencias">—</span>
            <span class="tkpi-lbl">Incidencias</span>
          </div>
        </div>
        <div class="theme-toggle-top" id="themeToggleTop">
          <svg class="t-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
          </svg>
          <svg class="t-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"></path>
          </svg>
        </div>
        <div class="topbar-clock" id="topbarClock"></div>
        <div class="notif-wrap" id="notifBtn">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
            <path d="M13.73 21a2 2 0 01-3.46 0"></path>
          </svg>
          <span class="notif-count" id="notifCount">0</span>
        </div>
      </div>
    </header>

    <!-- ══ MAPA DE PISOS ══ -->
    <section class="section active" id="sec-mapa">
      <div class="floor-controls">
        <div class="floor-search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input
            class="fsearch-input"
            id="roomSearch"
            placeholder="Buscar habitación o huésped…"
          />
        </div>
      </div>
      <div class="floor-container">
        <Distribucion />
      </div>
    </section>

    <!-- ══ CHECK-IN / OUT ══ -->
    <section class="section" id="sec-checkins">
      <div class="ci-layout">
        <div class="ci-col">
          <div class="ci-col-header">
            <div class="ci-col-dot checkin-dot"></div>
            <span class="ci-col-title">Check-in pendientes</span>
            <span class="ci-col-count" id="ciPendCount">0</span>
          </div>
          <div class="ci-list" id="ciPendList"></div>
        </div>
        <div class="ci-col">
          <div class="ci-col-header">
            <div class="ci-col-dot incasa-dot"></div>
            <span class="ci-col-title">En casa</span>
            <span class="ci-col-count" id="ciIncasaCount">0</span>
          </div>
          <div class="ci-list" id="ciIncasaList"></div>
        </div>
        <div class="ci-col">
          <div class="ci-col-header">
            <div class="ci-col-dot checkout-dot"></div>
            <span class="ci-col-title">Check-out hoy</span>
            <span class="ci-col-count" id="ciOutCount">0</span>
          </div>
          <div class="ci-list" id="ciOutList"></div>
        </div>
      </div>
    </section>

    <!-- ══ INCIDENCIAS ══ -->
    <section class="section" id="sec-incidencias">
      <div class="inc-toolbar">
        <div class="inc-filters">
          <button class="filter-btn active" data-inc="todas">Todas</button>
          <button class="filter-btn" data-inc="urgente">Urgente</button>
          <button class="filter-btn" data-inc="solicitud">Solicitud</button>
          <button class="filter-btn" data-inc="limpieza">Limpieza</button>
          <button class="filter-btn" data-inc="tecnico">Técnico</button>
          <button class="filter-btn" data-inc="resuelta">Resueltas</button>
        </div>
        <button class="btn-primary" id="btnNuevaInc">+ Nueva incidencia</button>
      </div>
      <div class="inc-grid" id="incGrid"></div>
    </section>

    <!-- ══ HOUSEKEEPING ══ -->
    <section class="section" id="sec-housekeeping">
      <div class="hk-summary" id="hkSummary"></div>
      <div class="hk-layout">
        <div class="hk-queue-card">
          <div class="hk-card-header">
            <span class="chart-title">Cola de limpieza</span>
            <span class="chart-sub" id="hkQueueCount">0 pendientes</span>
          </div>
          <div class="hk-queue" id="hkQueue"></div>
        </div>
        <div class="hk-done-card">
          <div class="hk-card-header">
            <span class="chart-title">Completadas hoy</span>
            <span class="chart-sub" id="hkDoneCount">0</span>
          </div>
          <div class="hk-queue" id="hkDone"></div>
        </div>
      </div>
    </section>
  </main>
</div>

<div class="sidebar-overlay" id="sidebarOverlay"></div>

<!-- MODAL HABITACION -->
<div class="modal-backdrop" id="modalBackdrop">
  <div class="modal" id="modal">
    <div class="modal-header">
      <div class="modal-title-wrap">
        <span class="modal-title" id="modalTitle">Habitación</span>
        <span class="modal-badge" id="modalBadge"></span>
      </div>
      <button class="modal-close" id="modalClose">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M18 6L6 18M6 6l12 12"></path>
        </svg>
      </button>
    </div>
    <div class="modal-body" id="modalBody"></div>
    <div class="modal-footer" id="modalFooter"></div>
  </div>
</div>

<style>
  *,
  *::before,
  *::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  :root {
    --gold: #c9a96e;
    --gold-light: #e2c99a;
    --gold-dim: rgba(201, 169, 110, 0.12);
    --gold-fg: #0a0a0b;
    --green: #4caf82;
    --green-dim: rgba(76, 175, 130, 0.12);
    --red: #e05555;
    --red-dim: rgba(224, 85, 85, 0.12);
    --blue: #6b8cff;
    --blue-dim: rgba(107, 140, 255, 0.12);
    --amber: #f0a500;
    --amber-dim: rgba(240, 165, 0, 0.12);
    --purple: #b06bff;
    --purple-dim: rgba(176, 107, 255, 0.12);
    --teal: #3ec9c9;
    --teal-dim: rgba(62, 201, 201, 0.12);
    --bg: #0a0a0b;
    --bg2: #111113;
    --bg3: #18181c;
    --bg4: #1e1e24;
    --bg5: #242430;
    --text: #e8e4dc;
    --text-m: #8a8680;
    --text-d: #4a4a52;
    --border: rgba(201, 169, 110, 0.1);
    --border-h: rgba(201, 169, 110, 0.28);
    --sidebar-w: 220px;
    --status-ocupada: #c9a96e;
    --status-libre-limpia: #4caf82;
    --status-libre-sucia: #f0a500;
    --status-reservada: #6b8cff;
    --status-checkout: #3ec9c9;
    --status-mantenimiento: #e05555;
    --status-bloqueada: #4a4a5a;
  }
  :root.day {
    --gold: #a87a3a;
    --gold-light: #7a5520;
    --gold-dim: rgba(168, 122, 58, 0.1);
    --gold-fg: #fff;
    --bg: #f4f0e8;
    --bg2: #ede8de;
    --bg3: #e5dfd3;
    --bg4: #ddd7c9;
    --bg5: #d5cebc;
    --text: #1a1714;
    --text-m: #6b6258;
    --text-d: #a09890;
    --border: rgba(168, 122, 58, 0.14);
    --border-h: rgba(168, 122, 58, 0.35);
  }

  html, body {
    height: 100%;
    background: var(--bg);
    color: var(--text);
    font-family: "Jost", sans-serif;
    font-weight: 300;
    overflow: hidden;
    transition: background 0.5s, color 0.5s;
  }

  .shell {
    display: flex;
    height: 100vh;
    overflow: hidden;
  }

  /* ── SIDEBAR ── */
  .sidebar {
    width: var(--sidebar-w);
    flex-shrink: 0;
    background: var(--bg2);
    border-right: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    transition: background 0.5s, border-color 0.5s, transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 200;
  }
  .sidebar-top {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 18px 16px 14px;
    border-bottom: 1px solid var(--border);
  }
  .brand-mark {
    width: 30px;
    height: 30px;
    flex-shrink: 0;
    border: 1px solid var(--gold);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .brand-mark svg { width: 13px; height: 13px; color: var(--gold); }
  .brand-info { flex: 1; min-width: 0; }
  .brand-name {
    display: block;
    font-family: "Cormorant Garamond", serif;
    font-size: 13px;
    font-weight: 400;
    color: var(--text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .brand-name em { font-style: italic; color: var(--gold-light); }
  .brand-role { font-size: 9px; letter-spacing: 0.25em; text-transform: uppercase; color: var(--text-d); }
  .sidebar-close {
    display: none;
    background: transparent;
    border: none;
    color: var(--text-m);
    cursor: pointer;
    padding: 4px;
  }
  .sidebar-close svg { width: 15px; height: 15px; }
  .nav {
    flex: 1;
    padding: 12px 10px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    overflow-y: auto;
  }
  .nav-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 10px;
    background: transparent;
    border: 1px solid transparent;
    color: var(--text-m);
    font-family: "Jost", sans-serif;
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.22s;
    text-align: left;
    position: relative;
  }
  .nav-item svg { width: 14px; height: 14px; flex-shrink: 0; }
  .nav-item:hover { color: var(--text); border-color: var(--border); background: var(--bg3); }
  .nav-item.active { color: var(--gold); border-color: var(--gold-dim); background: var(--gold-dim); }
  .nav-badge {
    margin-left: auto;
    background: var(--red);
    color: #fff;
    font-size: 9px;
    font-weight: 500;
    min-width: 16px;
    height: 16px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 4px;
  }
  .nav-badge:empty, .nav-badge[data-count="0"] { display: none; }

  /* LEYENDA */
  .sidebar-legend { padding: 12px 16px; border-top: 1px solid var(--border); }
  .leg-title { font-size: 8px; letter-spacing: 0.3em; text-transform: uppercase; color: var(--text-d); margin-bottom: 8px; }
  .leg-item { display: flex; align-items: center; gap: 7px; font-size: 9px; color: var(--text-m); margin-bottom: 5px; letter-spacing: 0.06em; }
  .leg-dot { width: 8px; height: 8px; border-radius: 2px; flex-shrink: 0; }
  .ld-ocupada        { background: var(--status-ocupada); }
  .ld-libre-limpia   { background: var(--status-libre-limpia); }
  .ld-libre-sucia    { background: var(--status-libre-sucia); }
  .ld-reservada      { background: var(--status-reservada); }
  .ld-checkout       { background: var(--status-checkout); }
  .ld-mantenimiento  { background: var(--status-mantenimiento); }
  .ld-bloqueada      { background: var(--status-bloqueada); }

  .sidebar-footer {
    padding: 12px 14px;
    border-top: 1px solid var(--border);
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .user-chip { display: flex; align-items: center; gap: 9px; flex: 1; min-width: 0; }
  .user-avatar {
    width: 26px; height: 26px; flex-shrink: 0;
    background: var(--gold-dim); border: 1px solid var(--gold);
    display: flex; align-items: center; justify-content: center;
    font-size: 10px; font-weight: 500; color: var(--gold);
  }
  .user-info { min-width: 0; }
  .user-name { display: block; font-size: 10px; font-weight: 400; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .user-dept { font-size: 8px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--text-d); }
  .btn-logout {
    background: transparent; border: 1px solid var(--border); padding: 6px;
    cursor: pointer; color: var(--text-m); transition: all 0.25s; flex-shrink: 0;
  }
  .btn-logout svg { width: 13px; height: 13px; display: block; }
  .btn-logout:hover { border-color: var(--red); color: var(--red); }

  /* ── MAIN ── */
  .main { flex: 1; display: flex; flex-direction: column; overflow: hidden; min-width: 0; }
  .topbar {
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 20px; height: 52px; flex-shrink: 0;
    background: var(--bg2); border-bottom: 1px solid var(--border);
    transition: background 0.5s, border-color 0.5s;
  }
  .topbar-left { display: flex; align-items: center; gap: 14px; }
  .menu-btn { display: none; background: transparent; border: none; color: var(--text-m); cursor: pointer; padding: 4px; }
  .menu-btn svg { width: 17px; height: 17px; }
  .section-label { font-family: "Cormorant Garamond", serif; font-size: 17px; font-weight: 400; color: var(--text); }
  .topbar-date { font-size: 9px; letter-spacing: 0.18em; color: var(--text-d); margin-left: 4px; }
  .topbar-right { display: flex; align-items: center; gap: 12px; }

  /* KPIs */
  .topbar-kpis { display: flex; align-items: center; gap: 0; border: 1px solid var(--border); }
  .tkpi { display: flex; flex-direction: column; align-items: center; padding: 4px 14px; gap: 1px; }
  .tkpi-val { font-family: "Cormorant Garamond", serif; font-size: 16px; font-weight: 600; color: var(--text); line-height: 1; }
  .tkpi-val.green { color: var(--green); }
  .tkpi-val.gold  { color: var(--gold); }
  .tkpi-val.amber { color: var(--amber); }
  .tkpi-lbl { font-size: 8px; letter-spacing: 0.15em; text-transform: uppercase; color: var(--text-d); }
  .tkpi-div { width: 1px; height: 28px; background: var(--border); }

  .theme-toggle-top {
    display: flex; align-items: center; cursor: pointer;
    padding: 5px; border: 1px solid var(--border); transition: border-color 0.25s;
  }
  .theme-toggle-top:hover { border-color: var(--border-h); }
  .theme-toggle-top svg { width: 13px; height: 13px; color: var(--text-m); transition: opacity 0.3s, transform 0.4s; }
  :root .t-sun { opacity: 0; transform: rotate(90deg); position: absolute; }
  :root .t-moon { opacity: 1; }
  :root.day .t-sun { opacity: 1; transform: rotate(0deg); position: relative; }
  :root.day .t-moon { opacity: 0; transform: rotate(-90deg); position: absolute; }

  .topbar-clock { font-size: 11px; letter-spacing: 0.14em; color: var(--text-m); font-variant-numeric: tabular-nums; }
  .notif-wrap {
    position: relative; cursor: pointer; padding: 5px;
    border: 1px solid var(--border); transition: border-color 0.25s;
    display: flex; align-items: center;
  }
  .notif-wrap:hover { border-color: var(--border-h); }
  .notif-wrap svg { width: 14px; height: 14px; color: var(--text-m); }
  .notif-count {
    position: absolute; top: -5px; right: -5px;
    background: var(--red); color: #fff; font-size: 8px; font-weight: 600;
    min-width: 15px; height: 15px; border-radius: 8px;
    display: flex; align-items: center; justify-content: center; padding: 0 3px;
  }

  /* ── SECTIONS ── */
  .section { display: none; flex: 1; overflow-y: auto; padding: 20px; gap: 18px; flex-direction: column; }
  .section.active { display: flex; }

  /* FLOOR MAP */
  .floor-controls { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; flex-shrink: 0; }
  .floor-search { position: relative; display: flex; align-items: center; }
  .floor-search svg { position: absolute; left: 9px; width: 12px; height: 12px; color: var(--text-d); }
  .fsearch-input {
    background: var(--bg3); border: 1px solid var(--border);
    padding: 7px 12px 7px 28px; font-family: "Jost", sans-serif;
    font-size: 11px; color: var(--text); outline: none;
    transition: border-color 0.25s; min-width: 200px;
  }
  .fsearch-input::placeholder { color: var(--text-d); }
  .fsearch-input:focus { border-color: var(--gold); }
  .floor-container { flex: 1; min-height: 0; overflow-y: auto; }

  /* CHECK-IN / OUT */
  .ci-layout { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; height: 100%; }
  .ci-col {
    background: var(--bg3); border: 1px solid var(--border);
    display: flex; flex-direction: column; max-height: calc(100vh - 140px);
  }
  .ci-col-header { display: flex; align-items: center; gap: 8px; padding: 14px 16px; border-bottom: 1px solid var(--border); flex-shrink: 0; }
  .ci-col-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
  .checkin-dot  { background: var(--gold); }
  .incasa-dot   { background: var(--green); }
  .checkout-dot { background: var(--teal); }
  .ci-col-title { font-family: "Cormorant Garamond", serif; font-size: 15px; font-weight: 400; color: var(--text); flex: 1; }
  .ci-col-count { font-size: 11px; color: var(--text-d); background: var(--bg4); padding: 2px 7px; }
  .ci-list { flex: 1; overflow-y: auto; padding: 8px; }
  .ci-card {
    background: var(--bg4); border: 1px solid var(--border);
    padding: 12px; margin-bottom: 6px; cursor: pointer;
    transition: all 0.2s; animation: fadeUp 0.3s ease both;
  }
  .ci-card:hover { border-color: var(--border-h); background: var(--bg5); }
  .ci-card-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 8px; margin-bottom: 6px; }
  .ci-name { font-size: 12px; font-weight: 400; color: var(--text); }
  .ci-hab  { font-size: 10px; color: var(--gold); font-family: "Cormorant Garamond", serif; }
  .ci-detail { display: flex; align-items: center; gap: 10px; font-size: 9px; color: var(--text-d); letter-spacing: 0.06em; }
  .ci-nights { background: var(--bg3); padding: 2px 6px; font-size: 9px; color: var(--text-m); }
  .ci-actions { display: flex; gap: 4px; margin-top: 8px; }
  .ci-btn {
    flex: 1; background: transparent; border: 1px solid var(--border); padding: 5px;
    font-family: "Jost", sans-serif; font-size: 9px; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--text-d); cursor: pointer; transition: all 0.2s;
  }
  .ci-btn.primary { border-color: var(--gold); color: var(--gold); }
  .ci-btn.primary:hover { background: var(--gold); color: var(--gold-fg); }
  .ci-btn:hover { border-color: var(--border-h); color: var(--text-m); }

  /* INCIDENCIAS */
  .inc-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; flex-shrink: 0; }
  .inc-filters { display: flex; gap: 4px; flex-wrap: wrap; }
  .filter-btn {
    background: transparent; border: 1px solid var(--border); padding: 5px 11px;
    font-size: 9px; letter-spacing: 0.15em; text-transform: uppercase;
    color: var(--text-d); cursor: pointer; transition: all 0.2s; font-family: "Jost", sans-serif;
  }
  .filter-btn:hover { border-color: var(--border-h); color: var(--text-m); }
  .filter-btn.active { border-color: var(--gold); color: var(--gold); background: var(--gold-dim); }
  .btn-primary {
    background: transparent; border: 1px solid var(--gold); color: var(--gold);
    padding: 7px 14px; font-family: "Jost", sans-serif; font-size: 10px;
    letter-spacing: 0.2em; text-transform: uppercase; cursor: pointer;
    transition: all 0.25s; position: relative; overflow: hidden;
  }
  .btn-primary::before {
    content: ""; position: absolute; inset: 0; background: var(--gold);
    transform: translateX(-100%); transition: transform 0.3s; z-index: 0;
  }
  .btn-primary:hover::before { transform: translateX(0); }
  .btn-primary:hover { color: var(--gold-fg); }
  .btn-primary > *, .btn-primary { position: relative; z-index: 1; }

  .inc-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 12px; }
  .inc-card {
    background: var(--bg3); border: 1px solid var(--border);
    padding: 16px; cursor: pointer; transition: all 0.22s;
    animation: fadeUp 0.4s ease both; border-left: 3px solid transparent; position: relative;
  }
  .inc-card:hover { border-color: var(--border-h); transform: translateY(-1px); }
  .inc-card.urgente   { border-left-color: var(--red); }
  .inc-card.solicitud { border-left-color: var(--gold); }
  .inc-card.limpieza  { border-left-color: var(--green); }
  .inc-card.tecnico   { border-left-color: var(--blue); }
  .inc-card.resuelta  { opacity: 0.5; }
  .inc-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 8px; margin-bottom: 8px; }
  .inc-tipo { font-size: 8px; letter-spacing: 0.2em; text-transform: uppercase; padding: 2px 7px; border: 1px solid; }
  .inc-tipo.urgente   { color: var(--red);   border-color: rgba(224, 85, 85, 0.3); }
  .inc-tipo.solicitud { color: var(--gold);  border-color: rgba(201, 169, 110, 0.3); }
  .inc-tipo.limpieza  { color: var(--green); border-color: rgba(76, 175, 130, 0.3); }
  .inc-tipo.tecnico   { color: var(--blue);  border-color: rgba(107, 140, 255, 0.3); }
  .inc-tipo.resuelta  { color: var(--text-d); border-color: var(--border); }
  .inc-hab  { font-family: "Cormorant Garamond", serif; font-size: 20px; font-weight: 600; color: var(--text); }
  .inc-desc { font-size: 11px; color: var(--text-m); line-height: 1.5; margin-bottom: 10px; }
  .inc-footer { display: flex; align-items: center; justify-content: space-between; }
  .inc-time   { font-size: 9px; color: var(--text-d); letter-spacing: 0.06em; }
  .inc-resolve-btn {
    background: transparent; border: 1px solid var(--border); padding: 3px 8px;
    font-size: 8px; letter-spacing: 0.15em; text-transform: uppercase;
    color: var(--text-d); cursor: pointer; transition: all 0.2s; font-family: "Jost", sans-serif;
  }
  .inc-resolve-btn:hover { border-color: var(--green); color: var(--green); }
  .inc-resolve-btn.resolved { border-color: var(--green); color: var(--green); opacity: 0.5; pointer-events: none; }

  /* HOUSEKEEPING */
  .hk-summary { display: grid; grid-template-columns: repeat(5, 1fr); gap: 10px; flex-shrink: 0; }
  .hk-stat { background: var(--bg3); border: 1px solid var(--border); padding: 14px; display: flex; flex-direction: column; gap: 5px; animation: fadeUp 0.4s ease both; }
  .hk-stat-val { font-family: "Cormorant Garamond", serif; font-size: 26px; font-weight: 400; color: var(--text); line-height: 1; }
  .hk-stat-lbl { font-size: 8px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--text-d); }
  .hk-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; flex: 1; min-height: 0; }
  .hk-queue-card, .hk-done-card {
    background: var(--bg3); border: 1px solid var(--border); padding: 16px;
    display: flex; flex-direction: column; max-height: calc(100vh - 300px);
  }
  .hk-card-header { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 14px; flex-shrink: 0; }
  .chart-title { font-family: "Cormorant Garamond", serif; font-size: 15px; font-weight: 400; color: var(--text); }
  .chart-sub  { font-size: 9px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--text-d); }
  .hk-queue   { flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 6px; }
  .hk-item {
    display: flex; align-items: center; gap: 10px; padding: 10px 12px;
    background: var(--bg4); border: 1px solid var(--border);
    transition: all 0.2s; animation: fadeUp 0.3s ease both; cursor: pointer;
  }
  .hk-item:hover { border-color: var(--border-h); }
  .hk-priority { width: 4px; height: 36px; flex-shrink: 0; border-radius: 2px; }
  .hk-priority.alta  { background: var(--red); }
  .hk-priority.media { background: var(--amber); }
  .hk-priority.baja  { background: var(--green); }
  .hk-info { flex: 1; min-width: 0; }
  .hk-num  { font-family: "Cormorant Garamond", serif; font-size: 15px; font-weight: 400; color: var(--text); margin-bottom: 2px; }
  .hk-type { font-size: 9px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-d); }
  .hk-time { font-size: 9px; color: var(--text-d); white-space: nowrap; }
  .hk-assign {
    background: transparent; border: 1px solid var(--border); padding: 3px 8px;
    font-size: 8px; letter-spacing: 0.15em; text-transform: uppercase;
    color: var(--text-d); cursor: pointer; transition: all 0.2s;
    font-family: "Jost", sans-serif; white-space: nowrap; flex-shrink: 0;
  }
  .hk-assign:hover { border-color: var(--gold); color: var(--gold); }
  .hk-assign.done  { border-color: var(--green); color: var(--green); opacity: 0.6; pointer-events: none; }

  /* MODAL */
  .modal-backdrop {
    position: fixed; inset: 0; z-index: 500;
    background: rgba(0, 0, 0, 0.75); backdrop-filter: blur(4px);
    display: none; align-items: center; justify-content: center; padding: 20px;
  }
  .modal-backdrop.open { display: flex; }
  .modal { background: var(--bg2); border: 1px solid var(--border); width: 100%; max-width: 520px; animation: fadeUp 0.3s ease both; }
  .modal-header { display: flex; align-items: center; justify-content: space-between; padding: 16px 20px; border-bottom: 1px solid var(--border); }
  .modal-title-wrap { display: flex; align-items: center; gap: 10px; }
  .modal-title { font-family: "Cormorant Garamond", serif; font-size: 20px; font-weight: 400; color: var(--text); }
  .modal-badge { font-size: 9px; letter-spacing: 0.15em; text-transform: uppercase; padding: 3px 8px; border: 1px solid; }
  .modal-close { background: transparent; border: none; color: var(--text-m); cursor: pointer; padding: 4px; }
  .modal-close svg { width: 15px; height: 15px; }
  .modal-body { padding: 20px; font-size: 12px; color: var(--text-m); line-height: 1.7; max-height: 60vh; overflow-y: auto; }
  .modal-footer { display: flex; justify-content: flex-end; gap: 8px; padding: 14px 20px; border-top: 1px solid var(--border); }

  .btn-ghost {
    background: transparent; border: 1px solid var(--border); color: var(--text-m);
    padding: 7px 14px; font-family: "Jost", sans-serif; font-size: 9px;
    letter-spacing: 0.2em; text-transform: uppercase; cursor: pointer; transition: all 0.25s;
  }
  .btn-ghost:hover { border-color: var(--border-h); color: var(--text); }

  .detail-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px 20px; margin-top: 4px; }
  .detail-item { display: flex; flex-direction: column; gap: 3px; }
  .detail-label { font-size: 8px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--text-d); }
  .detail-val   { font-size: 12px; color: var(--text); }

  .status-select {
    background: var(--bg4); border: 1px solid var(--border);
    padding: 7px 10px; font-family: "Jost", sans-serif; font-size: 11px;
    color: var(--text); outline: none; cursor: pointer; width: 100%;
    transition: border-color 0.25s;
  }
  .status-select:focus { border-color: var(--gold); }

  .inc-form { display: flex; flex-direction: column; gap: 12px; }
  .inc-form select,
  .inc-form textarea,
  .inc-form input {
    background: transparent; border: none; border-bottom: 1px solid var(--border);
    padding: 7px 0; font-family: "Jost", sans-serif; font-size: 11px;
    color: var(--text); outline: none; transition: border-color 0.25s;
    width: 100%; resize: none; caret-color: var(--gold);
  }
  .inc-form select:focus,
  .inc-form textarea:focus,
  .inc-form input:focus { border-bottom-color: var(--gold); }
  .inc-form select { cursor: pointer; appearance: none; background: transparent; }
  .inc-form label { font-size: 8px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--text-d); display: block; margin-bottom: 3px; }
  .inc-form .field { display: flex; flex-direction: column; }

  /* OVERLAY */
  .sidebar-overlay { display: none; position: fixed; inset: 0; z-index: 150; background: rgba(0, 0, 0, 0.65); backdrop-filter: blur(2px); }

  /* ANIMATIONS */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* RESPONSIVE */
  @media (max-width: 1200px) {
    .topbar-kpis { display: none; }
    .hk-summary  { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 900px) {
    .ci-layout  { grid-template-columns: 1fr; }
    .ci-col     { max-height: 320px; }
    .hk-layout  { grid-template-columns: 1fr; }
  }
  @media (max-width: 768px) {
    :root { --sidebar-w: 250px; }
    .sidebar { position: fixed; top: 0; left: 0; bottom: 0; transform: translateX(-100%); }
    .sidebar.open { transform: translateX(0); }
    .sidebar-close { display: flex !important; }
    .sidebar-overlay.open { display: block; }
    .menu-btn { display: flex !important; }
    .topbar { padding: 0 14px; }
    .section { padding: 14px; }
    .inc-grid { grid-template-columns: 1fr; }
    .hk-summary { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) {
    .floor-tab { padding: 6px 10px; font-size: 9px; }
    .topbar-clock { display: none; }
  }
</style>

<script>
  // @ts-nocheck
  // ── AUTH ────────────────────────────────────────────────────────
  const API = "http://localhost:3000";
  if (!sessionStorage.getItem("hotel_token")) {
    window.location.replace("/logIn");
  }
  const storedUser = sessionStorage.getItem("hotel_fullname") || sessionStorage.getItem("hotel_user") || "Recepción";
  const storedRole = sessionStorage.getItem("hotel_role") || "recepcion";
  if (storedRole !== "recepcion") {
    window.location.replace("/" + storedRole + "/dashboard");
  }
  const avatarEl     = document.getElementById("userAvatar");
  const sidebarUserEl = document.getElementById("sidebarUser");
  if (avatarEl)      avatarEl.textContent      = storedUser.charAt(0).toUpperCase();
  if (sidebarUserEl) sidebarUserEl.textContent  = storedUser;

  // ── UTILIDADES ──────────────────────────────────────────────────
  async function apiFetch(method, path, body = null) {
    const token   = sessionStorage.getItem("hotel_token");
    const headers = { "Content-Type": "application/json" };
    if (token) headers["Authorization"] = "Bearer " + token;
    const opts = { method, headers };
    if (body) opts.body = JSON.stringify(body);
    try {
      const res = await fetch(API + path, opts);
      if (res.status === 401) { sessionStorage.clear(); window.location.replace("/logIn"); return null; }
      return res.json();
    } catch (e) { console.error("[API]", path, e); return null; }
  }

  function showToast(msg, tipo = "success") {
    const c = { success: "var(--green)", warning: "var(--amber)", error: "var(--red)", info: "var(--blue)" };
    const t = document.createElement("div");
    t.style.cssText =
      "position:fixed;bottom:24px;right:24px;z-index:9999;background:var(--bg3);border-left:4px solid " + c[tipo] +
      ";color:var(--text);padding:12px 20px;font-family:Jost,sans-serif;font-size:12px;box-shadow:0 8px 32px rgba(0,0,0,.4)";
    t.textContent = msg;
    document.body.appendChild(t);
    setTimeout(() => t.remove(), 3500);
  }

  // ── TEMA ────────────────────────────────────────────────────────
  const root = document.documentElement;
  let manualOverride = false, currentTheme = "night";
  function getAutoTheme() { const h = new Date().getHours(); return h >= 6 && h < 18 ? "day" : "night"; }
  function applyTheme(t) { currentTheme = t; t === "day" ? root.classList.add("day") : root.classList.remove("day"); }
  document.getElementById("themeToggleTop")?.addEventListener("click", () => {
    manualOverride = true;
    applyTheme(currentTheme === "day" ? "night" : "day");
    setTimeout(() => { manualOverride = false; }, 7200000);
  });
  applyTheme(getAutoTheme());

  // ── RELOJ ────────────────────────────────────────────────────────
  const clockEl = document.getElementById("topbarClock");
  const dateEl  = document.getElementById("topbarDate");
  function tick() {
    const now  = new Date();
    const h    = String(now.getHours()).padStart(2, "0");
    const m    = String(now.getMinutes()).padStart(2, "0");
    const s    = String(now.getSeconds()).padStart(2, "0");
    if (clockEl) clockEl.textContent = h + ":" + m + ":" + s;
    const dias  = ["Dom","Lun","Mar","Mié","Jue","Vie","Sáb"];
    const meses = ["Ene","Feb","Mar","Abr","May","Jun","Jul","Ago","Sep","Oct","Nov","Dic"];
    if (dateEl) dateEl.textContent = dias[now.getDay()] + " " + now.getDate() + " " + meses[now.getMonth()];
    if (!manualOverride && getAutoTheme() !== currentTheme) applyTheme(getAutoTheme());
  }
  tick(); setInterval(tick, 1000);

  // ── NAVEGACIÓN ──────────────────────────────────────────────────
  const navItems     = document.querySelectorAll(".nav-item");
  const sections     = document.querySelectorAll(".section");
  const sectionLabel = document.getElementById("sectionLabel");
  const secLabels    = { mapa: "Mapa de pisos", checkins: "Check-in / Check-out", incidencias: "Incidencias", housekeeping: "Housekeeping" };

  navItems.forEach(btn => {
    btn.addEventListener("click", () => {
      const sec = btn.getAttribute("data-section") || "mapa";
      navItems.forEach(b => b.classList.remove("active"));
      btn.classList.add("active");
      sections.forEach(s => s.classList.remove("active"));
      document.getElementById("sec-" + sec)?.classList.add("active");
      if (sectionLabel) sectionLabel.textContent = secLabels[sec] || sec;
      if (window.innerWidth < 768) closeSidebar();
    });
  });

  const sidebar = document.getElementById("sidebar");
  const overlay = document.getElementById("sidebarOverlay");
  function openSidebar()  { sidebar?.classList.add("open");    overlay?.classList.add("open");    document.body.style.overflow = "hidden"; }
  function closeSidebar() { sidebar?.classList.remove("open"); overlay?.classList.remove("open"); document.body.style.overflow = ""; }
  document.getElementById("menuBtn")?.addEventListener("click", openSidebar);
  document.getElementById("sidebarClose")?.addEventListener("click", closeSidebar);
  overlay?.addEventListener("click", closeSidebar);
  document.getElementById("btnLogout")?.addEventListener("click", () => { sessionStorage.clear(); window.location.replace("/logIn"); });

  // ── MODAL ────────────────────────────────────────────────────────
  const backdrop = document.getElementById("modalBackdrop");

  function openModal(title, badge, badgeClass, body, footer) {
    const mt  = document.getElementById("modalTitle");
    const mb  = document.getElementById("modalBadge");
    const mbd = document.getElementById("modalBody");
    const mf  = document.getElementById("modalFooter");
    if (mt)  mt.textContent  = title;
    if (mb) {
      mb.textContent  = badge;
      mb.className    = "modal-badge";
      if (badgeClass) mb.classList.add(...badgeClass.split(" ").filter(Boolean));
      mb.style.display = badge ? "" : "none";
    }
    if (mbd) mbd.innerHTML = body;
    if (mf)  mf.innerHTML  = footer;
    backdrop?.classList.add("open");
  }

  function closeModal() { backdrop?.classList.remove("open"); }
  document.getElementById("modalClose")?.addEventListener("click", closeModal);
  backdrop?.addEventListener("click", e => { if (e.target === backdrop) closeModal(); });

  // ── ETIQUETAS Y COLORES DE ESTADO ───────────────────────────────
  const statusLabels = {
    "ocupada":        "Ocupada",
    "libre-limpia":   "Libre · Limpia",
    "libre-sucia":    "Libre · Sucia",
    "reservada":      "Reservada hoy",
    "checkout":       "Check-out hoy",
    "mantenimiento":  "Mantenimiento",
    "bloqueada":      "Bloqueada",
  };

  const statusColors = {
    "ocupada":        "var(--status-ocupada,#c9a96e)",
    "libre-limpia":   "var(--status-libre-limpia,#4caf82)",
    "libre-sucia":    "var(--status-libre-sucia,#f0a500)",
    "reservada":      "var(--status-reservada,#6b8cff)",
    "checkout":       "var(--status-checkout,#3ec9c9)",
    "mantenimiento":  "var(--status-mantenimiento,#e05555)",
    "bloqueada":      "var(--status-bloqueada,#4a4a5a)",
  };

  // ── KPIs topbar ─────────────────────────────────────────────────
  let incidenciasAPI = [];

  async function updateTopbarKpis() {
    const t = (id, val) => { const e = document.getElementById(id); if (e) e.textContent = String(val); };
    const data = await apiFetch("GET", "/api/rooms/stats");
    if (data) {
      t("tkOcupadas", data.occupied  ?? data.ocupadas  ?? "—");
      t("tkLibres",   data.available ?? data.libres    ?? "—");
      t("tkCheckins", data.checkins  ?? "—");
    } else {
      const rooms = distWrap?.getRooms?.() ?? [];
      if (rooms.length) {
        t("tkOcupadas", rooms.filter(r => r.status === "ocupada").length);
        t("tkLibres",   rooms.filter(r => r.status === "libre-limpia" || r.status === "libre-sucia").length);
        t("tkCheckins", rooms.filter(r => r.status === "reservada").length);
      }
    }
    const incs = incidenciasAPI.filter(i => i.status !== "resolved" && i.status !== "closed").length;
    t("tkIncidencias", incs);
    const nc = document.getElementById("notifCount"); if (nc) nc.textContent = String(incs);
    const nb = document.getElementById("navBadge");   if (nb) nb.textContent = String(incs);
  }

  // ── COMPONENTE DISTRIBUCION ──────────────────────────────────────
  const distWrap = document.querySelector(".dist-wrap");

  // Búsqueda
  document.getElementById("roomSearch")?.addEventListener("input", e => {
    distWrap?.filterRooms(e.target.value);
  });

  // ── MODAL DE HABITACIÓN ──────────────────────────────────────────
  // Abre el modal para CUALQUIER habitación sin excepción de estado
  function openRoomModal(r) {
    const hasInc  = r.hasInc || r.hasIncidence || false;
    const stLabel = statusLabels[r.status] || r.status || "—";
    const stColor = statusColors[r.status] || "var(--text)";

    // Alerta contextual por estado (solo informativa, no bloquea nada)
    let alerta = "";
    if (r.status === "checkout") {
      alerta = `<div style="margin-top:12px;padding:10px 12px;background:rgba(62,201,201,.1);border:1px solid rgba(62,201,201,.25);font-size:11px;color:#3ec9c9">
        → Check-out pendiente${r.horaLimite ? " · salida antes de <strong>" + r.horaLimite + "</strong>" : ""}
      </div>`;
    } else if (r.status === "mantenimiento") {
      alerta = `<div style="margin-top:12px;padding:10px 12px;background:rgba(224,85,85,.1);border:1px solid rgba(224,85,85,.2);font-size:11px;color:#e05555">
        ✕ Actualmente fuera de servicio
      </div>`;
    } else if (r.status === "libre-sucia") {
      alerta = `<div style="margin-top:12px;padding:10px 12px;background:rgba(240,165,0,.1);border:1px solid rgba(240,165,0,.2);font-size:11px;color:#f0a500">
        ⚠ Requiere limpieza antes de asignar
      </div>`;
    } else if (r.status === "bloqueada") {
      alerta = `<div style="margin-top:12px;padding:10px 12px;background:rgba(74,74,90,.15);border:1px solid rgba(74,74,90,.3);font-size:11px;color:#8a8a9a">
        ◼ Bloqueada por administración
      </div>`;
    }

    const body = `
      <div class="detail-grid">
        <div class="detail-item">
          <span class="detail-label">Número</span>
          <span class="detail-val">${r.num}</span>
        </div>
        <div class="detail-item">
          <span class="detail-label">Tipo</span>
          <span class="detail-val">${r.tipo || "—"}</span>
        </div>
        <div class="detail-item">
          <span class="detail-label">Piso</span>
          <span class="detail-val">${r.piso || "—"}°</span>
        </div>
        <div class="detail-item">
          <span class="detail-label">Estado actual</span>
          <span class="detail-val" style="color:${stColor}">${stLabel}</span>
        </div>
        ${r.guest      ? `<div class="detail-item"><span class="detail-label">Huésped</span><span class="detail-val">${r.guest}</span></div>` : ""}
        ${r.checkIn    ? `<div class="detail-item"><span class="detail-label">Check-in</span><span class="detail-val">${r.checkIn}</span></div>` : ""}
        ${r.checkOut   ? `<div class="detail-item"><span class="detail-label">Check-out</span><span class="detail-val">${r.checkOut}</span></div>` : ""}
        ${r.nights     ? `<div class="detail-item"><span class="detail-label">Noches</span><span class="detail-val">${r.nights}</span></div>` : ""}
        ${r.horaLimite ? `<div class="detail-item"><span class="detail-label">Hora límite</span><span class="detail-val" style="color:var(--status-checkout,#3ec9c9)">${r.horaLimite}</span></div>` : ""}
        ${r.capacidad  ? `<div class="detail-item"><span class="detail-label">Capacidad</span><span class="detail-val">${r.capacidad} pax</span></div>` : ""}
        ${r.camas      ? `<div class="detail-item"><span class="detail-label">Camas</span><span class="detail-val">${r.camas}</span></div>` : ""}
        ${r.vista      ? `<div class="detail-item"><span class="detail-label">Vista</span><span class="detail-val">${r.vista}</span></div>` : ""}
      </div>

      ${alerta}

      ${hasInc ? `<div style="margin-top:12px;padding:10px 12px;background:var(--red-dim);border:1px solid rgba(224,85,85,.2);font-size:11px;color:var(--red)">⚠ Esta habitación tiene una incidencia activa</div>` : ""}

      <div style="margin-top:18px;padding-top:16px;border-top:1px solid var(--border)">
        <label class="detail-label" style="display:block;margin-bottom:8px">Cambiar estado</label>
        <div style="position:relative">
          <span id="modalStatusDot" style="position:absolute;left:10px;top:50%;transform:translateY(-50%);width:8px;height:8px;border-radius:50%;background:${stColor}"></span>
          <select class="status-select" id="modalStatusSel" style="padding-left:26px" onchange="onStatusSelChange(this)">
            <option value="ocupada"       ${r.status === "ocupada"       ? "selected" : ""}>Ocupada</option>
            <option value="libre-limpia"  ${r.status === "libre-limpia"  ? "selected" : ""}>Libre · Limpia</option>
            <option value="libre-sucia"   ${r.status === "libre-sucia"   ? "selected" : ""}>Libre · Sucia</option>
            <option value="reservada"     ${r.status === "reservada"     ? "selected" : ""}>Reservada hoy</option>
            <option value="checkout"      ${r.status === "checkout"      ? "selected" : ""}>Check-out hoy</option>
            <option value="mantenimiento" ${r.status === "mantenimiento" ? "selected" : ""}>Mantenimiento</option>
            <option value="bloqueada"     ${r.status === "bloqueada"     ? "selected" : ""}>Bloqueada</option>
          </select>
        </div>
      </div>

      <div style="margin-top:14px">
        <label class="detail-label" style="display:block;margin-bottom:6px">Notas internas</label>
        <textarea class="status-select" id="modalNotas" rows="2"
          placeholder="Observaciones sobre la habitación (opcional)…"
          style="resize:vertical;font-size:11px;line-height:1.6"
        >${r.notas || ""}</textarea>
      </div>
    `;

    const footer = `
      <button class="btn-ghost" onclick="closeModal()">Cancelar</button>
      <button class="btn-primary" id="btnGuardarEstado" onclick="saveRoomStatus(${r.num})">
        <span>Guardar cambio</span>
      </button>
    `;

    // Badge de estado en la cabecera del modal
    const badgeClass = r.status === "ocupada"      ? "inc-tipo solicitud" :
                       r.status === "libre-limpia" ? "inc-tipo limpieza"  :
                       r.status === "mantenimiento"? "inc-tipo urgente"   :
                       r.status === "bloqueada"    ? "inc-tipo resuelta"  : "inc-tipo";

    openModal("Habitación " + r.num, stLabel, badgeClass, body, footer);
  }

  // Actualizar dot de color al cambiar el select
  window.onStatusSelChange = sel => {
    const dot = document.getElementById("modalStatusDot");
    if (dot) dot.style.background = statusColors[sel.value] || "var(--text-d)";
  };

  // Guardar cambio de estado — funciona para todos los estados
  window.saveRoomStatus = async num => {
    const sel   = document.getElementById("modalStatusSel");
    const notas = document.getElementById("modalNotas");
    const btn   = document.getElementById("btnGuardarEstado");
    if (!sel) return;

    if (btn) { btn.disabled = true; btn.innerHTML = "<span>Guardando…</span>"; }

    const payload = { status: sel.value };
    if (notas?.value.trim()) payload.notes = notas.value.trim();

    const result = await apiFetch("PATCH", "/api/rooms/" + num + "/status", payload);

    if (btn) { btn.disabled = false; btn.innerHTML = "<span>Guardar cambio</span>"; }

    if (result && result.error !== true) {
      showToast("Habitación " + num + " · estado actualizado ✓");
      closeModal();
      distWrap?.refresh();
      updateTopbarKpis();
    } else {
      showToast("No se pudo actualizar el estado", "error");
    }
  };

  window.closeModal = closeModal;

  // ── ESCUCHAR EVENTO del componente Distribucion ──────────────────
  // El componente emite 'dist-room-click' con bubbles:true para cualquier estado
  distWrap?.addEventListener("dist-room-click", e => {
    openRoomModal(e.detail);
  });

  // Exponer para el bloque is:inline
  window.loadTopbarKpis     = updateTopbarKpis;
  window.updateRoomsFromAPI = () => distWrap?.refresh();

  // ── CHECK-IN / OUT (datos locales de demostración) ───────────────
  const ciData = [
    { id:1, nombre:"Alejandro Torres",  hab:205, tipo:"Jr. Suite",    entrada:"05 Mar", salida:"09 Mar", noches:4, pax:2, notas:"Solicita cuna extra",    estado:"pendiente" },
    { id:2, nombre:"Familia Morales",   hab:401, tipo:"Jr. Suite",    entrada:"05 Mar", salida:"12 Mar", noches:7, pax:4, notas:"Llegada 14:00 hrs",      estado:"pendiente" },
    { id:3, nombre:"Ms. Williams",      hab:607, tipo:"Piso Exec.",   entrada:"05 Mar", salida:"07 Mar", noches:2, pax:1, notas:"Early check-in solicitado", estado:"pendiente" },
    { id:4, nombre:"Juan Pérez",        hab:312, tipo:"Suite Deluxe", entrada:"03 Mar", salida:"08 Mar", noches:5, pax:2, notas:"—",                       estado:"en-casa"  },
    { id:5, nombre:"Familia García",    hab:401, tipo:"Jr. Suite",    entrada:"03 Mar", salida:"12 Mar", noches:9, pax:4, notas:"VIP",                     estado:"en-casa"  },
    { id:6, nombre:"Mr. Johnson",       hab:501, tipo:"Suite Deluxe", entrada:"02 Mar", salida:"15 Mar", noches:13,pax:1, notas:"Corporativo",             estado:"en-casa"  },
    { id:7, nombre:"Ana López",         hab:201, tipo:"Doble",        entrada:"01 Mar", salida:"05 Mar", noches:4, pax:2, notas:"—",                       estado:"checkout" },
    { id:8, nombre:"Pedro Ruiz",        hab:318, tipo:"Estándar",     entrada:"02 Mar", salida:"05 Mar", noches:3, pax:1, notas:"—",                       estado:"checkout" },
  ];

  function renderCILists() {
    const pend   = ciData.filter(c => c.estado === "pendiente");
    const incasa = ciData.filter(c => c.estado === "en-casa");
    const cout   = ciData.filter(c => c.estado === "checkout");

    const fill = (listId, data, btnLabel, btnClass, action) => {
      const el = document.getElementById(listId);
      if (!el) return;
      el.innerHTML = "";
      data.forEach((c, i) => {
        const div = document.createElement("div");
        div.className = "ci-card";
        div.style.animationDelay = i * 0.05 + "s";
        div.innerHTML = `
          <div class="ci-card-top">
            <div>
              <div class="ci-name">${c.nombre}</div>
              <div class="ci-detail">${c.entrada} → ${c.salida} · <span class="ci-nights">${c.noches}n</span> · ${c.pax} pax</div>
            </div>
            <div class="ci-hab">${c.hab}</div>
          </div>
          <div style="font-size:10px;color:var(--text-d);margin-bottom:4px">${c.tipo}</div>
          ${c.notas !== "—" ? `<div style="font-size:9px;color:var(--amber);margin-bottom:6px">📝 ${c.notas}</div>` : ""}
          <div class="ci-actions">
            <button class="ci-btn" onclick="verCI(${c.id})">Ver detalle</button>
            <button class="ci-btn ${btnClass}" onclick="${action}(${c.id})">${btnLabel}</button>
          </div>`;
        el.appendChild(div);
      });
    };

    fill("ciPendList",   pend,   "Check-in",       "primary", "doCheckinLocal");
    fill("ciIncasaList", incasa, "Ampliar estancia","",        "ampliarCI");
    fill("ciOutList",    cout,   "Check-out",       "primary", "doCheckoutLocal");

    const c1 = document.getElementById("ciPendCount");
    const c2 = document.getElementById("ciIncasaCount");
    const c3 = document.getElementById("ciOutCount");
    if (c1) c1.textContent = String(pend.length);
    if (c2) c2.textContent = String(incasa.length);
    if (c3) c3.textContent = String(cout.length);
  }
  renderCILists();

  window.verCI = id => {
    const c = ciData.find(x => x.id === id);
    if (!c) return;
    openModal(
      c.nombre, "Hab. " + c.hab, "inc-tipo solicitud",
      `<div class="detail-grid">
        <div class="detail-item"><span class="detail-label">Habitación</span><span class="detail-val">${c.hab} · ${c.tipo}</span></div>
        <div class="detail-item"><span class="detail-label">Huéspedes</span><span class="detail-val">${c.pax} pax</span></div>
        <div class="detail-item"><span class="detail-label">Check-in</span><span class="detail-val">${c.entrada}</span></div>
        <div class="detail-item"><span class="detail-label">Check-out</span><span class="detail-val">${c.salida}</span></div>
        <div class="detail-item"><span class="detail-label">Noches</span><span class="detail-val">${c.noches}</span></div>
        <div class="detail-item"><span class="detail-label">Notas</span><span class="detail-val">${c.notas}</span></div>
      </div>`,
      `<button class="btn-ghost" onclick="closeModal()">Cerrar</button>`,
    );
  };

  window.doCheckinLocal = id => {
    const c = ciData.find(x => x.id === id);
    if (!c) return;
    c.estado = "en-casa";
    renderCILists();
    distWrap?.refresh();
    updateTopbarKpis();
    openModal(
      "Check-in realizado", "✓ Completado", "inc-tipo limpieza",
      `<p style="color:var(--text)">El huésped <strong>${c.nombre}</strong> ha ingresado a la habitación <strong>${c.hab}</strong>.</p>`,
      `<button class="btn-ghost" onclick="closeModal()">Cerrar</button>`,
    );
  };

  window.doCheckoutLocal = id => {
    const c = ciData.find(x => x.id === id);
    if (!c) return;
    ciData.splice(ciData.indexOf(c), 1);
    renderCILists();
    distWrap?.refresh();
    updateTopbarKpis();
    openModal(
      "Check-out realizado", "✓ Completado", "inc-tipo limpieza",
      `<p style="color:var(--text)">Check-out de <strong>${c.nombre}</strong> (hab. ${c.hab}) completado. Habitación enviada a cola de limpieza.</p>`,
      `<button class="btn-ghost" onclick="closeModal()">Cerrar</button>`,
    );
  };

  window.ampliarCI = () => {
    openModal("Ampliar estancia", "", "", `<p style="color:var(--text-m);margin-bottom:12px">Funcionalidad disponible al conectar el backend.</p>`,
      `<button class="btn-ghost" onclick="closeModal()">Cerrar</button>`);
  };

  // ── INCIDENCIAS desde API ────────────────────────────────────────
  async function loadIncidencias(filter = "todas") {
    const data = await apiFetch("GET", "/api/incidents" + (filter && filter !== "todas" ? "?status=open" : ""));
    if (!data) return;
    incidenciasAPI = data;
    renderIncidencias(filter);
    updateTopbarKpis();
  }

  function renderIncidencias(filter = "todas") {
    const container = document.getElementById("incGrid");
    if (!container) return;

    const typeColors  = { urgent:"var(--red)", request:"var(--gold)", cleaning:"var(--green)", technical:"var(--blue)" };
    const typeLabels  = { urgent:"Urgente", request:"Solicitud", cleaning:"Limpieza", technical:"Técnico" };
    const typeES      = { urgent:"urgente", request:"solicitud", cleaning:"limpieza", technical:"tecnico" };

    const filtered =
      filter === "todas"     ? incidenciasAPI :
      filter === "resueltas" ? incidenciasAPI.filter(i => i.status === "resolved" || i.status === "closed") :
                               incidenciasAPI.filter(i => typeES[i.type] === filter || i.type === filter);

    if (!filtered.length) {
      container.innerHTML = '<div style="color:var(--text-d);font-size:11px;padding:20px 0">Sin incidencias en esta categoría</div>';
      return;
    }

    container.innerHTML = filtered.map(inc => {
      const c        = typeColors[inc.type] || "var(--gold)";
      const l        = typeLabels[inc.type] || inc.type;
      const resuelta = inc.status === "resolved" || inc.status === "closed";
      const tiempo   = inc.createdAt ? fmtRelTime(inc.createdAt) : "—";
      return `<div class="inc-card ${typeES[inc.type] || ''}${resuelta ? ' resuelta' : ''}" style="border-left-color:${c}">
        <div class="inc-top">
          <span class="inc-tipo ${typeES[inc.type] || ''}">${l}</span>
          <span class="inc-hab">${inc.roomNumber || "—"}</span>
        </div>
        <div class="inc-desc">${inc.title || inc.description?.slice(0, 80) || "—"}</div>
        <div class="inc-footer">
          <span class="inc-time">${tiempo}</span>
          ${!resuelta
            ? `<button class="inc-resolve-btn" onclick="resolverIncidencia('${inc.id}')">Marcar resuelta</button>`
            : `<span style="color:var(--green);font-size:10px;letter-spacing:.1em">✓ Resuelta</span>`}
        </div>
      </div>`;
    }).join("");
  }

  window.resolverIncidencia = async id => {
    await apiFetch("PATCH", "/api/incidents/" + id + "/status", { status: "resolved" });
    showToast("Incidencia resuelta ✓", "success");
    loadIncidencias();
  };

  function fmtRelTime(iso) {
    const d = Date.now() - new Date(iso).getTime(), m = Math.floor(d / 60000);
    if (m < 1)  return "ahora";
    if (m < 60) return "hace " + m + "m";
    const h = Math.floor(m / 60);
    if (h < 24) return "hace " + h + "h";
    return "hace " + Math.floor(h / 24) + "d";
  }

  loadIncidencias();

  document.querySelectorAll("[data-inc]").forEach(btn => {
    btn.addEventListener("click", () => {
      document.querySelectorAll("[data-inc]").forEach(b => b.classList.remove("active"));
      btn.classList.add("active");
      renderIncidencias(btn.getAttribute("data-inc") || "todas");
    });
  });
</script>