---
// src/pages/recepcion/dashboard.astro
---
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Jost:wght@200;300;400;500&display=swap" rel="stylesheet" />

<script is:inline>
  const _r = sessionStorage.getItem('hotel_role');
  const _u = sessionStorage.getItem('hotel_user');
  if (!_u || (_r !== 'admin' && _r !== 'recepcion')) window.location.replace('/logIn');
</script>

<div class="shell">

  <!-- SIDEBAR -->
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-top">
      <div class="brand-mark">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 21h18M3 7l9-4 9 4M4 7v14M20 7v14M8 10v4M12 10v4M16 10v4"/></svg>
      </div>
      <div class="brand-info">
        <span class="brand-name">Grand <em>Élite</em></span>
        <span class="brand-role">Recepción</span>
      </div>
      <button class="sidebar-close" id="sidebarClose">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
    </div>
    <nav class="nav">
      <button class="nav-item active" data-section="mapa">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
        <span>Mapa de pisos</span>
      </button>
      <button class="nav-item" data-section="checkins">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M16 17l5-5-5-5M21 12H9"/><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/></svg>
        <span>Check-in / Out</span>
      </button>
      <button class="nav-item" data-section="incidencias">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <span>Incidencias</span>
        <span class="nav-badge" id="navBadge">0</span>
      </button>
      <button class="nav-item" data-section="housekeeping">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        <span>Housekeeping</span>
      </button>
    </nav>
    <!-- LEYENDA -->
    <div class="sidebar-legend">
      <div class="leg-title">Leyenda</div>
      <div class="leg-item"><span class="leg-dot ld-ocupada"></span>Ocupada</div>
      <div class="leg-item"><span class="leg-dot ld-libre-limpia"></span>Libre limpia</div>
      <div class="leg-item"><span class="leg-dot ld-libre-sucia"></span>Libre sucia</div>
      <div class="leg-item"><span class="leg-dot ld-reservada"></span>Reservada hoy</div>
      <div class="leg-item"><span class="leg-dot ld-checkout"></span>Check-out hoy</div>
      <div class="leg-item"><span class="leg-dot ld-mantenimiento"></span>Mantenimiento</div>
      <div class="leg-item"><span class="leg-dot ld-bloqueada"></span>Bloqueada</div>
    </div>
    <div class="sidebar-footer">
      <div class="user-chip">
        <div class="user-avatar" id="userAvatar">R</div>
        <div class="user-info">
          <span class="user-name" id="sidebarUser">Recepción</span>
          <span class="user-dept">Front Desk</span>
        </div>
      </div>
      <button class="btn-logout" id="btnLogout">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4M16 17l5-5-5-5M21 12H9"/></svg>
      </button>
    </div>
  </aside>

  <!-- MAIN -->
  <main class="main">
    <header class="topbar">
      <div class="topbar-left">
        <button class="menu-btn" id="menuBtn">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
        <div class="topbar-title">
          <span class="section-label" id="sectionLabel">Mapa de pisos</span>
          <span class="topbar-date" id="topbarDate"></span>
        </div>
      </div>
      <div class="topbar-right">
        <!-- KPIs mini topbar -->
        <div class="topbar-kpis" id="topbarKpis">
          <div class="tkpi"><span class="tkpi-val" id="tkOcupadas">—</span><span class="tkpi-lbl">Ocupadas</span></div>
          <div class="tkpi-div"></div>
          <div class="tkpi"><span class="tkpi-val green" id="tkLibres">—</span><span class="tkpi-lbl">Libres</span></div>
          <div class="tkpi-div"></div>
          <div class="tkpi"><span class="tkpi-val gold" id="tkCheckins">—</span><span class="tkpi-lbl">CI hoy</span></div>
          <div class="tkpi-div"></div>
          <div class="tkpi"><span class="tkpi-val amber" id="tkIncidencias">—</span><span class="tkpi-lbl">Incidencias</span></div>
        </div>
        <div class="theme-toggle-top" id="themeToggleTop">
          <svg class="t-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
          <svg class="t-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>
        </div>
        <div class="topbar-clock" id="topbarClock"></div>
        <div class="notif-wrap" id="notifBtn">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 01-3.46 0"/></svg>
          <span class="notif-count" id="notifCount">0</span>
        </div>
      </div>
    </header>

    <!-- ══ MAPA DE PISOS ══ -->
    <section class="section active" id="sec-mapa">
      <div class="floor-controls">
        <div class="floor-tabs" id="floorTabs"></div>
        <div class="floor-search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input class="fsearch-input" id="roomSearch" placeholder="Buscar habitación…" />
        </div>
      </div>
      <div class="floor-container" id="floorContainer"></div>
    </section>

    <!-- ══ CHECK-IN / OUT ══ -->
    <section class="section" id="sec-checkins">
      <div class="ci-layout">
        <!-- Pendientes hoy -->
        <div class="ci-col">
          <div class="ci-col-header">
            <div class="ci-col-dot checkin-dot"></div>
            <span class="ci-col-title">Check-in pendientes</span>
            <span class="ci-col-count" id="ciPendCount">0</span>
          </div>
          <div class="ci-list" id="ciPendList"></div>
        </div>
        <!-- En casa -->
        <div class="ci-col">
          <div class="ci-col-header">
            <div class="ci-col-dot incasa-dot"></div>
            <span class="ci-col-title">En casa</span>
            <span class="ci-col-count" id="ciIncasaCount">0</span>
          </div>
          <div class="ci-list" id="ciIncasaList"></div>
        </div>
        <!-- Check-out hoy -->
        <div class="ci-col">
          <div class="ci-col-header">
            <div class="ci-col-dot checkout-dot"></div>
            <span class="ci-col-title">Check-out hoy</span>
            <span class="ci-col-count" id="ciOutCount">0</span>
          </div>
          <div class="ci-list" id="ciOutList"></div>
        </div>
      </div>
    </section>

    <!-- ══ INCIDENCIAS ══ -->
    <section class="section" id="sec-incidencias">
      <div class="inc-toolbar">
        <div class="inc-filters">
          <button class="filter-btn active" data-inc="todas">Todas</button>
          <button class="filter-btn" data-inc="urgente">Urgente</button>
          <button class="filter-btn" data-inc="solicitud">Solicitud</button>
          <button class="filter-btn" data-inc="limpieza">Limpieza</button>
          <button class="filter-btn" data-inc="tecnico">Técnico</button>
          <button class="filter-btn" data-inc="resuelta">Resueltas</button>
        </div>
        <button class="btn-primary" id="btnNuevaInc">+ Nueva incidencia</button>
      </div>
      <div class="inc-grid" id="incGrid"></div>
    </section>

    <!-- ══ HOUSEKEEPING ══ -->
    <section class="section" id="sec-housekeeping">
      <div class="hk-summary" id="hkSummary"></div>
      <div class="hk-layout">
        <div class="hk-queue-card">
          <div class="hk-card-header"><span class="chart-title">Cola de limpieza</span><span class="chart-sub" id="hkQueueCount">0 pendientes</span></div>
          <div class="hk-queue" id="hkQueue"></div>
        </div>
        <div class="hk-done-card">
          <div class="hk-card-header"><span class="chart-title">Completadas hoy</span><span class="chart-sub" id="hkDoneCount">0</span></div>
          <div class="hk-queue" id="hkDone"></div>
        </div>
      </div>
    </section>
  </main>
</div>

<div class="sidebar-overlay" id="sidebarOverlay"></div>

<!-- MODAL HABITACION -->
<div class="modal-backdrop" id="modalBackdrop">
  <div class="modal" id="modal">
    <div class="modal-header">
      <div class="modal-title-wrap">
        <span class="modal-title" id="modalTitle">Habitación</span>
        <span class="modal-badge" id="modalBadge"></span>
      </div>
      <button class="modal-close" id="modalClose"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 6L6 18M6 6l12 12"/></svg></button>
    </div>
    <div class="modal-body" id="modalBody"></div>
    <div class="modal-footer" id="modalFooter"></div>
  </div>
</div>

<style>
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}

:root{
  --gold:#C9A96E;--gold-light:#E2C99A;--gold-dim:rgba(201,169,110,0.12);--gold-fg:#0A0A0B;
  --green:#4CAF82;--green-dim:rgba(76,175,130,0.12);
  --red:#E05555;--red-dim:rgba(224,85,85,0.12);
  --blue:#6B8CFF;--blue-dim:rgba(107,140,255,0.12);
  --amber:#F0A500;--amber-dim:rgba(240,165,0,0.12);
  --purple:#B06BFF;--purple-dim:rgba(176,107,255,0.12);
  --teal:#3EC9C9;--teal-dim:rgba(62,201,201,0.12);
  --bg:#0A0A0B;--bg2:#111113;--bg3:#18181C;--bg4:#1E1E24;--bg5:#242430;
  --text:#E8E4DC;--text-m:#8A8680;--text-d:#4A4A52;
  --border:rgba(201,169,110,0.10);--border-h:rgba(201,169,110,0.28);
  --sidebar-w:220px;
  --status-ocupada: #C9A96E;
  --status-libre-limpia: #4CAF82;
  --status-libre-sucia: #F0A500;
  --status-reservada: #6B8CFF;
  --status-checkout: #3EC9C9;
  --status-mantenimiento: #E05555;
  --status-bloqueada: #4A4A5A;
}
:root.day{
  --gold:#A87A3A;--gold-light:#7A5520;--gold-dim:rgba(168,122,58,0.10);--gold-fg:#fff;
  --bg:#F4F0E8;--bg2:#EDE8DE;--bg3:#E5DFD3;--bg4:#DDD7C9;--bg5:#D5CEBC;
  --text:#1A1714;--text-m:#6B6258;--text-d:#A09890;
  --border:rgba(168,122,58,0.14);--border-h:rgba(168,122,58,0.35);
}

html,body{height:100%;background:var(--bg);color:var(--text);font-family:'Jost',sans-serif;font-weight:300;overflow:hidden;transition:background .5s,color .5s}

.shell{display:flex;height:100vh;overflow:hidden}

/* SIDEBAR */
.sidebar{width:var(--sidebar-w);flex-shrink:0;background:var(--bg2);border-right:1px solid var(--border);display:flex;flex-direction:column;transition:background .5s,border-color .5s,transform .35s cubic-bezier(.4,0,.2,1);z-index:200}
.sidebar-top{display:flex;align-items:center;gap:10px;padding:18px 16px 14px;border-bottom:1px solid var(--border)}
.brand-mark{width:30px;height:30px;flex-shrink:0;border:1px solid var(--gold);display:flex;align-items:center;justify-content:center}
.brand-mark svg{width:13px;height:13px;color:var(--gold)}
.brand-info{flex:1;min-width:0}
.brand-name{display:block;font-family:'Cormorant Garamond',serif;font-size:13px;font-weight:400;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.brand-name em{font-style:italic;color:var(--gold-light)}
.brand-role{font-size:9px;letter-spacing:.25em;text-transform:uppercase;color:var(--text-d)}
.sidebar-close{display:none;background:transparent;border:none;color:var(--text-m);cursor:pointer;padding:4px}
.sidebar-close svg{width:15px;height:15px}
.nav{flex:1;padding:12px 10px;display:flex;flex-direction:column;gap:2px;overflow-y:auto}
.nav-item{display:flex;align-items:center;gap:10px;padding:9px 10px;background:transparent;border:1px solid transparent;color:var(--text-m);font-family:'Jost',sans-serif;font-size:10px;font-weight:400;letter-spacing:.12em;text-transform:uppercase;cursor:pointer;transition:all .22s;text-align:left;position:relative}
.nav-item svg{width:14px;height:14px;flex-shrink:0}
.nav-item:hover{color:var(--text);border-color:var(--border);background:var(--bg3)}
.nav-item.active{color:var(--gold);border-color:var(--gold-dim);background:var(--gold-dim)}
.nav-badge{margin-left:auto;background:var(--red);color:#fff;font-size:9px;font-weight:500;min-width:16px;height:16px;border-radius:8px;display:flex;align-items:center;justify-content:center;padding:0 4px}
.nav-badge:empty,.nav-badge[data-count="0"]{display:none}

/* LEYENDA SIDEBAR */
.sidebar-legend{padding:12px 16px;border-top:1px solid var(--border)}
.leg-title{font-size:8px;letter-spacing:.3em;text-transform:uppercase;color:var(--text-d);margin-bottom:8px}
.leg-item{display:flex;align-items:center;gap:7px;font-size:9px;color:var(--text-m);margin-bottom:5px;letter-spacing:.06em}
.leg-dot{width:8px;height:8px;border-radius:2px;flex-shrink:0}
.ld-ocupada{background:var(--status-ocupada)}
.ld-libre-limpia{background:var(--status-libre-limpia)}
.ld-libre-sucia{background:var(--status-libre-sucia)}
.ld-reservada{background:var(--status-reservada)}
.ld-checkout{background:var(--status-checkout)}
.ld-mantenimiento{background:var(--status-mantenimiento)}
.ld-bloqueada{background:var(--status-bloqueada)}

.sidebar-footer{padding:12px 14px;border-top:1px solid var(--border);display:flex;align-items:center;gap:10px}
.user-chip{display:flex;align-items:center;gap:9px;flex:1;min-width:0}
.user-avatar{width:26px;height:26px;flex-shrink:0;background:var(--gold-dim);border:1px solid var(--gold);display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:500;color:var(--gold)}
.user-info{min-width:0}
.user-name{display:block;font-size:10px;font-weight:400;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.user-dept{font-size:8px;letter-spacing:.2em;text-transform:uppercase;color:var(--text-d)}
.btn-logout{background:transparent;border:1px solid var(--border);padding:6px;cursor:pointer;color:var(--text-m);transition:all .25s;flex-shrink:0}
.btn-logout svg{width:13px;height:13px;display:block}
.btn-logout:hover{border-color:var(--red);color:var(--red)}

/* MAIN */
.main{flex:1;display:flex;flex-direction:column;overflow:hidden;min-width:0}
.topbar{display:flex;align-items:center;justify-content:space-between;padding:0 20px;height:52px;flex-shrink:0;background:var(--bg2);border-bottom:1px solid var(--border);transition:background .5s,border-color .5s}
.topbar-left{display:flex;align-items:center;gap:14px}
.menu-btn{display:none;background:transparent;border:none;color:var(--text-m);cursor:pointer;padding:4px}
.menu-btn svg{width:17px;height:17px}
.section-label{font-family:'Cormorant Garamond',serif;font-size:17px;font-weight:400;color:var(--text)}
.topbar-date{font-size:9px;letter-spacing:.18em;color:var(--text-d);margin-left:4px}
.topbar-right{display:flex;align-items:center;gap:12px}

/* TOPBAR KPIs */
.topbar-kpis{display:flex;align-items:center;gap:0;border:1px solid var(--border)}
.tkpi{display:flex;flex-direction:column;align-items:center;padding:4px 14px;gap:1px}
.tkpi-val{font-family:'Cormorant Garamond',serif;font-size:16px;font-weight:600;color:var(--text);line-height:1}
.tkpi-val.green{color:var(--green)}.tkpi-val.gold{color:var(--gold)}.tkpi-val.amber{color:var(--amber)}
.tkpi-lbl{font-size:8px;letter-spacing:.15em;text-transform:uppercase;color:var(--text-d)}
.tkpi-div{width:1px;height:28px;background:var(--border)}
.theme-toggle-top{display:flex;align-items:center;cursor:pointer;padding:5px;border:1px solid var(--border);transition:border-color .25s}
.theme-toggle-top:hover{border-color:var(--border-h)}
.theme-toggle-top svg{width:13px;height:13px;color:var(--text-m);transition:opacity .3s,transform .4s}
:root .t-sun{opacity:0;transform:rotate(90deg);position:absolute}
:root .t-moon{opacity:1}
:root.day .t-sun{opacity:1;transform:rotate(0deg);position:relative}
:root.day .t-moon{opacity:0;transform:rotate(-90deg);position:absolute}
.topbar-clock{font-size:11px;letter-spacing:.14em;color:var(--text-m);font-variant-numeric:tabular-nums}
.notif-wrap{position:relative;cursor:pointer;padding:5px;border:1px solid var(--border);transition:border-color .25s;display:flex;align-items:center}
.notif-wrap:hover{border-color:var(--border-h)}
.notif-wrap svg{width:14px;height:14px;color:var(--text-m)}
.notif-count{position:absolute;top:-5px;right:-5px;background:var(--red);color:#fff;font-size:8px;font-weight:600;min-width:15px;height:15px;border-radius:8px;display:flex;align-items:center;justify-content:center;padding:0 3px}

/* SECTIONS */
.section{display:none;flex:1;overflow-y:auto;padding:20px;gap:18px;flex-direction:column}
.section.active{display:flex}

/* FLOOR MAP */
.floor-controls{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;flex-shrink:0}
.floor-tabs{display:flex;gap:0}
.floor-tab{background:transparent;border:1px solid var(--border);padding:7px 16px;font-family:'Jost',sans-serif;font-size:10px;letter-spacing:.18em;text-transform:uppercase;color:var(--text-d);cursor:pointer;transition:all .2s;margin-left:-1px}
.floor-tab:first-child{margin-left:0}
.floor-tab:hover{color:var(--text-m);border-color:var(--border-h)}
.floor-tab.active{color:var(--gold);border-color:var(--gold);background:var(--gold-dim);z-index:1}
.floor-search{position:relative;display:flex;align-items:center}
.floor-search svg{position:absolute;left:9px;width:12px;height:12px;color:var(--text-d)}
.fsearch-input{background:var(--bg3);border:1px solid var(--border);padding:7px 12px 7px 28px;font-family:'Jost',sans-serif;font-size:11px;color:var(--text);outline:none;transition:border-color .25s;min-width:200px}
.fsearch-input::placeholder{color:var(--text-d)}
.fsearch-input:focus{border-color:var(--gold)}
.floor-container{flex:1;min-height:0;overflow-y:auto}
.floor-section{animation:fadeUp .4s ease both}
@keyframes fadeUp{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
.floor-label{font-family:'Cormorant Garamond',serif;font-size:13px;font-weight:400;color:var(--text-d);letter-spacing:.3em;text-transform:uppercase;margin-bottom:10px;display:flex;align-items:center;gap:10px}
.floor-label::after{content:'';flex:1;height:1px;background:var(--border)}
.rooms-row{display:grid;grid-template-columns:repeat(auto-fill,minmax(90px,1fr));gap:8px;margin-bottom:20px}

/* ROOM CARD */
.room-card{position:relative;background:var(--bg3);border:1px solid var(--border);padding:10px 10px 8px;cursor:pointer;transition:all .22s;overflow:hidden;min-height:80px;display:flex;flex-direction:column;justify-content:space-between}
.room-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px}
.room-card.rc-ocupada::before{background:var(--status-ocupada)}
.room-card.rc-libre-limpia::before{background:var(--status-libre-limpia)}
.room-card.rc-libre-sucia::before{background:var(--status-libre-sucia)}
.room-card.rc-reservada::before{background:var(--status-reservada)}
.room-card.rc-checkout::before{background:var(--status-checkout)}
.room-card.rc-mantenimiento::before{background:var(--status-mantenimiento)}
.room-card.rc-bloqueada::before{background:var(--status-bloqueada)}
.room-card:hover{border-color:var(--border-h);transform:translateY(-2px);box-shadow:0 8px 24px rgba(0,0,0,.3)}
.room-card.has-incidence::after{content:'!';position:absolute;top:6px;right:6px;width:14px;height:14px;background:var(--red);color:#fff;font-size:8px;font-weight:700;border-radius:50%;display:flex;align-items:center;justify-content:center}
.rc-num{font-family:'Cormorant Garamond',serif;font-size:20px;font-weight:600;color:var(--text);line-height:1}
.rc-type{font-size:8px;letter-spacing:.12em;text-transform:uppercase;color:var(--text-d);margin-top:1px}
.rc-bottom{display:flex;align-items:center;justify-content:space-between;margin-top:8px}
.rc-guest{font-size:9px;color:var(--text-m);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:60px}
.rc-status-dot{width:7px;height:7px;border-radius:50%;flex-shrink:0}
.rc-status-dot.rc-ocupada{background:var(--status-ocupada)}
.rc-status-dot.rc-libre-limpia{background:var(--status-libre-limpia)}
.rc-status-dot.rc-libre-sucia{background:var(--status-libre-sucia)}
.rc-status-dot.rc-reservada{background:var(--status-reservada)}
.rc-status-dot.rc-checkout{background:var(--status-checkout)}
.rc-status-dot.rc-mantenimiento{background:var(--status-mantenimiento)}
.rc-status-dot.rc-bloqueada{background:var(--status-bloqueada)}
/* dim bloqueada */
.room-card.rc-bloqueada{opacity:.5}

/* CHECK-IN / OUT */
.ci-layout{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;height:100%}
.ci-col{background:var(--bg3);border:1px solid var(--border);display:flex;flex-direction:column;max-height:calc(100vh - 140px)}
.ci-col-header{display:flex;align-items:center;gap:8px;padding:14px 16px;border-bottom:1px solid var(--border);flex-shrink:0}
.ci-col-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0}
.checkin-dot{background:var(--gold)}
.incasa-dot{background:var(--green)}
.checkout-dot{background:var(--teal)}
.ci-col-title{font-family:'Cormorant Garamond',serif;font-size:15px;font-weight:400;color:var(--text);flex:1}
.ci-col-count{font-size:11px;color:var(--text-d);background:var(--bg4);padding:2px 7px;border-radius:0}
.ci-list{flex:1;overflow-y:auto;padding:8px}
.ci-card{background:var(--bg4);border:1px solid var(--border);padding:12px;margin-bottom:6px;cursor:pointer;transition:all .2s;animation:fadeUp .3s ease both}
.ci-card:hover{border-color:var(--border-h);background:var(--bg5)}
.ci-card-top{display:flex;align-items:flex-start;justify-content:space-between;gap:8px;margin-bottom:6px}
.ci-name{font-size:12px;font-weight:400;color:var(--text)}
.ci-hab{font-size:10px;color:var(--gold);font-family:'Cormorant Garamond',serif}
.ci-detail{display:flex;align-items:center;gap:10px;font-size:9px;color:var(--text-d);letter-spacing:.06em}
.ci-nights{background:var(--bg3);padding:2px 6px;font-size:9px;color:var(--text-m)}
.ci-actions{display:flex;gap:4px;margin-top:8px}
.ci-btn{flex:1;background:transparent;border:1px solid var(--border);padding:5px;font-family:'Jost',sans-serif;font-size:9px;letter-spacing:.14em;text-transform:uppercase;color:var(--text-d);cursor:pointer;transition:all .2s}
.ci-btn.primary{border-color:var(--gold);color:var(--gold)}
.ci-btn.primary:hover{background:var(--gold);color:var(--gold-fg)}
.ci-btn:hover{border-color:var(--border-h);color:var(--text-m)}

/* INCIDENCIAS */
.inc-toolbar{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;flex-shrink:0}
.inc-filters{display:flex;gap:4px;flex-wrap:wrap}
.filter-btn{background:transparent;border:1px solid var(--border);padding:5px 11px;font-size:9px;letter-spacing:.15em;text-transform:uppercase;color:var(--text-d);cursor:pointer;transition:all .2s;font-family:'Jost',sans-serif}
.filter-btn:hover{border-color:var(--border-h);color:var(--text-m)}
.filter-btn.active{border-color:var(--gold);color:var(--gold);background:var(--gold-dim)}
.btn-primary{background:transparent;border:1px solid var(--gold);color:var(--gold);padding:7px 14px;font-family:'Jost',sans-serif;font-size:10px;letter-spacing:.2em;text-transform:uppercase;cursor:pointer;transition:all .25s;position:relative;overflow:hidden}
.btn-primary::before{content:'';position:absolute;inset:0;background:var(--gold);transform:translateX(-100%);transition:transform .3s;z-index:0}
.btn-primary:hover::before{transform:translateX(0)}
