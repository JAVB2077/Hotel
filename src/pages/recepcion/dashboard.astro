.inc-top{display:flex;align-items:flex-start;justify-content:space-between;gap:8px;margin-bottom:8px}
.inc-tipo{font-size:8px;letter-spacing:.2em;text-transform:uppercase;padding:2px 7px;border:1px solid}
.inc-tipo.urgente{color:var(--red);border-color:rgba(224,85,85,.3)}
.inc-tipo.solicitud{color:var(--gold);border-color:rgba(201,169,110,.3)}
.inc-tipo.limpieza{color:var(--green);border-color:rgba(76,175,130,.3)}
.inc-tipo.tecnico{color:var(--blue);border-color:rgba(107,140,255,.3)}
.inc-tipo.resuelta{color:var(--text-d);border-color:var(--border)}
.inc-hab{font-family:'Cormorant Garamond',serif;font-size:20px;font-weight:600;color:var(--text)}
.inc-desc{font-size:11px;color:var(--text-m);line-height:1.5;margin-bottom:10px}
.inc-footer{display:flex;align-items:center;justify-content:space-between}
.inc-time{font-size:9px;color:var(--text-d);letter-spacing:.06em}
.inc-resolve-btn{background:transparent;border:1px solid var(--border);padding:3px 8px;font-size:8px;letter-spacing:.15em;text-transform:uppercase;color:var(--text-d);cursor:pointer;transition:all .2s;font-family:'Jost',sans-serif}
.inc-resolve-btn:hover{border-color:var(--green);color:var(--green)}
.inc-resolve-btn.resolved{border-color:var(--green);color:var(--green);opacity:.5;pointer-events:none}

/* HOUSEKEEPING */
.hk-summary{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;flex-shrink:0}
.hk-stat{background:var(--bg3);border:1px solid var(--border);padding:14px;display:flex;flex-direction:column;gap:5px;animation:fadeUp .4s ease both}
.hk-stat-val{font-family:'Cormorant Garamond',serif;font-size:26px;font-weight:400;color:var(--text);line-height:1}
.hk-stat-lbl{font-size:8px;letter-spacing:.22em;text-transform:uppercase;color:var(--text-d)}
.hk-layout{display:grid;grid-template-columns:1fr 1fr;gap:16px;flex:1;min-height:0}
.hk-queue-card,.hk-done-card{background:var(--bg3);border:1px solid var(--border);padding:16px;display:flex;flex-direction:column;max-height:calc(100vh - 300px)}
.hk-card-header{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:14px;flex-shrink:0}
.chart-title{font-family:'Cormorant Garamond',serif;font-size:15px;font-weight:400;color:var(--text)}
.chart-sub{font-size:9px;letter-spacing:.2em;text-transform:uppercase;color:var(--text-d)}
.hk-queue{flex:1;overflow-y:auto;display:flex;flex-direction:column;gap:6px}
.hk-item{display:flex;align-items:center;gap:10px;padding:10px 12px;background:var(--bg4);border:1px solid var(--border);transition:all .2s;animation:fadeUp .3s ease both;cursor:pointer}
.hk-item:hover{border-color:var(--border-h)}
.hk-priority{width:4px;height:36px;flex-shrink:0;border-radius:2px}
.hk-priority.alta{background:var(--red)}.hk-priority.media{background:var(--amber)}.hk-priority.baja{background:var(--green)}
.hk-info{flex:1;min-width:0}
.hk-num{font-family:'Cormorant Garamond',serif;font-size:15px;font-weight:400;color:var(--text);margin-bottom:2px}
.hk-type{font-size:9px;letter-spacing:.1em;text-transform:uppercase;color:var(--text-d)}
.hk-time{font-size:9px;color:var(--text-d);white-space:nowrap}
.hk-assign{background:transparent;border:1px solid var(--border);padding:3px 8px;font-size:8px;letter-spacing:.15em;text-transform:uppercase;color:var(--text-d);cursor:pointer;transition:all .2s;font-family:'Jost',sans-serif;white-space:nowrap;flex-shrink:0}
.hk-assign:hover{border-color:var(--gold);color:var(--gold)}
