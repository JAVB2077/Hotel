---
// src/pages/staff/dashboard.astro
---
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400;1,600&family=Jost:wght@200;300;400;500;600&display=swap" rel="stylesheet" />

<script is:inline>
  const _r = sessionStorage.getItem('hotel_role');
  const _u = sessionStorage.getItem('hotel_user');
  if (!_u || (_r !== 'admin' && _r !== 'staff')) window.location.replace('/logIn');
</script>

<div class="shell" id="shell">

  <!-- ══ TOPBAR ══ -->
  <header class="topbar" id="topbar">
    <div class="topbar-left">
      <button class="menu-btn" id="menuBtn">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
      <div class="brand-lockup">
        <div class="brand-mark">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 21h18M3 7l9-4 9 4M4 7v14M20 7v14M8 10v4M12 10v4M16 10v4"/></svg>
        </div>
        <div>
          <div class="brand-name">Grand <em>Élite</em></div>
          <div class="brand-sub">Staff Operations</div>
        </div>
      </div>
    </div>
    <nav class="topnav" id="topnav">
      <button class="tnav-item active" data-section="tareas">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/></svg>
        Mis tareas
        <span class="tnav-badge" id="navBadgeTareas">0</span>
      </button>
      <button class="tnav-item" data-section="solicitudes">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 8h1a4 4 0 010 8h-1"/><path d="M2 8h16v9a4 4 0 01-4 4H6a4 4 0 01-4-4V8z"/><line x1="6" y1="1" x2="6" y2="4"/><line x1="10" y1="1" x2="10" y2="4"/><line x1="14" y1="1" x2="14" y2="4"/></svg>
        Solicitudes
        <span class="tnav-badge urgent" id="navBadgeSol">0</span>
      </button>
      <button class="tnav-item" data-section="inventario">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
        Inventario
      </button>
      <button class="tnav-item" data-section="registro">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
        Registro turno
      </button>
    </nav>
    <div class="topbar-right">
      <div class="jornada-chip" id="jornadaChip">
        <span class="jornada-dot" id="jornadaDot"></span>
        <span id="jornadaLabel">—</span>
      </div>
      <div class="theme-toggle" id="themeToggle">
        <svg class="t-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
        <svg class="t-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>
      </div>
      <div class="clock-block">
        <div class="clock-time" id="clockTime">00:00</div>
        <div class="clock-date" id="clockDate"></div>
      </div>
      <div class="user-pill" id="userPill">
        <div class="user-av" id="userAv">S</div>
        <span class="user-nm" id="userName">Staff</span>
        <button class="logout-btn" id="logoutBtn" title="Salir">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4M16 17l5-5-5-5M21 12H9"/></svg>
        </button>
      </div>
    </div>
  </header>

  <!-- ══ MAIN ══ -->
  <main class="main">

    <!-- PANEL LATERAL FIJO -->
    <aside class="side-panel">
      <!-- Progreso del turno -->
      <div class="sp-card sp-progress">
        <div class="sp-label">Progreso del turno</div>
        <div class="sp-progress-ring">
          <svg viewBox="0 0 80 80" class="ring-svg">
            <circle class="ring-bg" cx="40" cy="40" r="34"/>
            <circle class="ring-fill" id="ringFill" cx="40" cy="40" r="34"/>
          </svg>
          <div class="ring-center">
            <span class="ring-pct" id="ringPct">0%</span>
            <span class="ring-sub">completo</span>
          </div>
        </div>
        <div class="sp-progress-stats">
          <div class="sp-stat"><span class="sp-stat-val" id="spDone">0</span><span class="sp-stat-lbl">Hechas</span></div>
          <div class="sp-stat-div"></div>
          <div class="sp-stat"><span class="sp-stat-val" id="spPend">0</span><span class="sp-stat-lbl">Pendientes</span></div>
          <div class="sp-stat-div"></div>
          <div class="sp-stat"><span class="sp-stat-val urgent-val" id="spUrgent">0</span><span class="sp-stat-lbl">Urgentes</span></div>
        </div>
      </div>

      <!-- Área asignada -->
      <div class="sp-card sp-area">
        <div class="sp-label">Área asignada</div>
        <div class="area-chips" id="areaChips"></div>
      </div>

      <!-- Turno actual -->
      <div class="sp-card sp-turno">
        <div class="sp-label">Turno activo</div>
        <div class="turno-info" id="turnoInfo"></div>
      </div>

      <!-- Compañeros activos -->
      <div class="sp-card sp-crew">
        <div class="sp-label">Equipo en turno</div>
        <div class="crew-list" id="crewList"></div>
      </div>
    </aside>

    <!-- CONTENIDO PRINCIPAL -->
    <div class="content">

      <!-- ══ TAREAS ══ -->
      <section class="section active" id="sec-tareas">
        <div class="section-head">
          <div>
            <h2 class="section-title">Mis tareas</h2>
            <p class="section-desc" id="taskDesc">Turno de hoy</p>
          </div>
          <div class="section-actions">
            <div class="pill-filters" id="taskFilters">
              <button class="pill active" data-tf="todas">Todas</button>
              <button class="pill" data-tf="urgente">Urgente</button>
              <button class="pill" data-tf="limpieza">Limpieza</button>
              <button class="pill" data-tf="servicio">Servicio</button>
              <button class="pill" data-tf="mantenimiento">Mant.</button>
              <button class="pill" data-tf="completada">✓ Hechas</button>
            </div>
            <button class="btn-new" id="btnNewTask">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              Nueva
            </button>
          </div>
        </div>
        <div class="tareas-grid" id="tareasGrid"></div>
      </section>

      <!-- ══ SOLICITUDES ══ -->
      <section class="section" id="sec-solicitudes">
        <div class="section-head">
          <div>
            <h2 class="section-title">Solicitudes de huéspedes</h2>
            <p class="section-desc">Solicitudes activas · Ordenadas por prioridad</p>
          </div>
          <div class="pill-filters">
            <button class="pill active" data-sf="todas">Todas</button>
            <button class="pill" data-sf="urgente">Urgente</button>
            <button class="pill" data-sf="normal">Normal</button>
            <button class="pill" data-sf="atendida">Atendidas</button>
          </div>
        </div>
        <div class="sol-list" id="solList"></div>
      </section>

      <!-- ══ INVENTARIO ══ -->
      <section class="section" id="sec-inventario">
        <div class="section-head">
          <div>
            <h2 class="section-title">Inventario de turno</h2>
            <p class="section-desc">Control de suministros · Piso asignado</p>
          </div>
          <button class="btn-new" id="btnReporte">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            Reporte
          </button>
        </div>
        <div class="inv-grid" id="invGrid"></div>
      </section>

      <!-- ══ REGISTRO DE TURNO ══ -->
      <section class="section" id="sec-registro">
        <div class="section-head">
          <div>
            <h2 class="section-title">Registro del turno</h2>
            <p class="section-desc">Bitácora de actividades · Hoy</p>
          </div>
          <button class="btn-new" id="btnAddLog">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Agregar nota
          </button>
        </div>
        <div class="registro-layout">
          <div class="bitacora" id="bitacora"></div>
          <div class="reg-side">
            <div class="reg-resumen" id="regResumen"></div>
          </div>
        </div>
      </section>

    </div>
  </main>
</div>

<!-- DRAWER MOBILE -->
<div class="drawer-overlay" id="drawerOverlay"></div>
<div class="drawer" id="drawer">
  <div class="drawer-header">
    <span class="drawer-title">Menú</span>
    <button class="drawer-close" id="drawerClose">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>
  </div>
  <nav class="drawer-nav" id="drawerNav"></nav>
</div>

<!-- MODAL -->
<div class="modal-back" id="modalBack">
  <div class="modal-box" id="modalBox">
    <div class="modal-head">
      <span class="modal-ttl" id="modalTtl">—</span>
      <button class="modal-x" id="modalX">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
    </div>
    <div class="modal-bd" id="modalBd"></div>
    <div class="modal-ft" id="modalFt"></div>
  </div>
</div>

<style>
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}

:root{
  --gold:#C9A96E;--gold-l:#E2C99A;--gold-dim:rgba(201,169,110,.12);--gold-fg:#0A0A0B;
  --green:#4CAF82;--green-dim:rgba(76,175,130,.12);
  --red:#E05555;--red-dim:rgba(224,85,85,.12);
  --blue:#6B8CFF;--blue-dim:rgba(107,140,255,.12);
  --amber:#F0A500;--amber-dim:rgba(240,165,0,.12);
  --teal:#3EC9C9;
  --bg:#08080A;--bg2:#0F0F12;--bg3:#161619;--bg4:#1C1C21;--bg5:#232328;
  --text:#EAE6DE;--text-m:#7A7670;--text-d:#3E3E46;
  --border:rgba(201,169,110,.08);--border-m:rgba(201,169,110,.16);--border-h:rgba(201,169,110,.28);
  --topbar-h:56px;
  --panel-w:230px;
  --radius:0px;
}
:root.day{
  --gold:#A07030;--gold-l:#7A5520;--gold-dim:rgba(160,112,48,.10);--gold-fg:#fff;
  --bg:#F0EBE0;--bg2:#E8E2D5;--bg3:#DFD9CA;--bg4:#D6CFBE;--bg5:#CCC4B0;
  --text:#18160F;--text-m:#5E5A52;--text-d:#A09880;
  --border:rgba(160,112,48,.12);--border-m:rgba(160,112,48,.22);--border-h:rgba(160,112,48,.38);
}

html,body{height:100%;background:var(--bg);color:var(--text);font-family:'Jost',sans-serif;font-weight:300;overflow:hidden;transition:background .4s,color .4s}

/* ══ TOPBAR ══ */
.topbar{
  position:fixed;top:0;left:0;right:0;height:var(--topbar-h);
  background:var(--bg2);border-bottom:1px solid var(--border);
  display:flex;align-items:center;gap:0;z-index:300;
  transition:background .4s,border-color .4s;
}
.topbar-left{display:flex;align-items:center;gap:14px;padding:0 20px;border-right:1px solid var(--border);height:100%}
.menu-btn{display:none;background:transparent;border:none;color:var(--text-m);cursor:pointer;padding:4px}
.menu-btn svg{width:17px;height:17px}
.brand-lockup{display:flex;align-items:center;gap:10px}
.brand-mark{width:28px;height:28px;border:1px solid var(--gold);display:flex;align-items:center;justify-content:center;flex-shrink:0}
.brand-mark svg{width:12px;height:12px;color:var(--gold)}
.brand-name{font-family:'Cormorant Garamond',serif;font-size:13px;font-weight:400;color:var(--text);line-height:1.1}
.brand-name em{font-style:italic;color:var(--gold-l)}
.brand-sub{font-size:8px;letter-spacing:.3em;text-transform:uppercase;color:var(--text-d)}
.topnav{display:flex;align-items:stretch;height:100%;flex:1;padding:0 4px;gap:0}
.tnav-item{display:flex;align-items:center;gap:7px;padding:0 16px;background:transparent;border:none;border-bottom:2px solid transparent;color:var(--text-m);font-family:'Jost',sans-serif;font-size:10px;font-weight:400;letter-spacing:.16em;text-transform:uppercase;cursor:pointer;transition:all .22s;white-space:nowrap;position:relative}
.tnav-item svg{width:13px;height:13px;flex-shrink:0}
.tnav-item:hover{color:var(--text);border-bottom-color:var(--border-m)}
.tnav-item.active{color:var(--gold);border-bottom-color:var(--gold)}
.tnav-badge{background:var(--red);color:#fff;font-size:8px;font-weight:600;min-width:14px;height:14px;border-radius:7px;display:flex;align-items:center;justify-content:center;padding:0 3px;margin-left:2px}
.tnav-badge.urgent{background:var(--red);animation:pulse 2s infinite}
@keyframes pulse{0%,100%{box-shadow:0 0 0 0 rgba(224,85,85,.4)}50%{box-shadow:0 0 0 4px rgba(224,85,85,0)}}
.tnav-badge:empty{display:none}
.topbar-right{display:flex;align-items:center;gap:10px;padding:0 16px;margin-left:auto;border-left:1px solid var(--border);height:100%}
.jornada-chip{display:flex;align-items:center;gap:6px;padding:4px 10px;border:1px solid var(--border);font-size:9px;letter-spacing:.18em;text-transform:uppercase;color:var(--text-m)}
.jornada-dot{width:6px;height:6px;border-radius:50%;background:var(--green);box-shadow:0 0 6px rgba(76,175,130,.5)}
.theme-toggle{display:flex;align-items:center;cursor:pointer;padding:5px;border:1px solid var(--border);transition:border-color .25s}
.theme-toggle:hover{border-color:var(--border-h)}
.theme-toggle svg{width:13px;height:13px;color:var(--text-m);transition:opacity .3s,transform .4s}
:root .t-sun{opacity:0;transform:rotate(90deg);position:absolute}:root .t-moon{opacity:1}
:root.day .t-sun{opacity:1;transform:rotate(0deg);position:relative}:root.day .t-moon{opacity:0;transform:rotate(-90deg);position:absolute}
.clock-block{text-align:right}
.clock-time{font-family:'Cormorant Garamond',serif;font-size:18px;font-weight:400;color:var(--text);line-height:1;font-variant-numeric:tabular-nums;letter-spacing:.04em}
.clock-date{font-size:8px;letter-spacing:.2em;text-transform:uppercase;color:var(--text-d);margin-top:1px}
.user-pill{display:flex;align-items:center;gap:8px;padding:4px 4px 4px 10px;border:1px solid var(--border)}
.user-av{width:24px;height:24px;background:var(--gold-dim);border:1px solid var(--gold);display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:500;color:var(--gold);flex-shrink:0}
.user-nm{font-size:10px;color:var(--text-m);letter-spacing:.06em}
.logout-btn{background:transparent;border:none;color:var(--text-d);cursor:pointer;padding:4px;transition:color .2s;display:flex;align-items:center}
.logout-btn svg{width:13px;height:13px}
.logout-btn:hover{color:var(--red)}

/* ══ SHELL ══ */
.shell{padding-top:var(--topbar-h);height:100vh;display:flex;overflow:hidden}
.main{flex:1;display:flex;overflow:hidden}

/* ══ SIDE PANEL ══ */
.side-panel{width:var(--panel-w);flex-shrink:0;background:var(--bg2);border-right:1px solid var(--border);overflow-y:auto;padding:16px 14px;display:flex;flex-direction:column;gap:12px;transition:background .4s,border-color .4s}
.sp-card{background:var(--bg3);border:1px solid var(--border);padding:14px;transition:background .4s,border-color .4s}
.sp-label{font-size:8px;letter-spacing:.3em;text-transform:uppercase;color:var(--text-d);margin-bottom:10px}

/* Progress ring */
.sp-progress-ring{position:relative;width:80px;height:80px;margin:0 auto 12px}
.ring-svg{width:80px;height:80px;transform:rotate(-90deg)}
.ring-bg{fill:none;stroke:var(--bg4);stroke-width:6}
.ring-fill{fill:none;stroke:var(--gold);stroke-width:6;stroke-linecap:square;stroke-dasharray:213.6;stroke-dashoffset:213.6;transition:stroke-dashoffset 1.2s cubic-bezier(.4,0,.2,1)}
.ring-center{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center}
.ring-pct{font-family:'Cormorant Garamond',serif;font-size:18px;font-weight:600;color:var(--text);line-height:1}
.ring-sub{font-size:7px;letter-spacing:.18em;text-transform:uppercase;color:var(--text-d)}
.sp-progress-stats{display:flex;align-items:center;justify-content:center;gap:0}
.sp-stat{display:flex;flex-direction:column;align-items:center;gap:2px;flex:1}
.sp-stat-val{font-family:'Cormorant Garamond',serif;font-size:18px;font-weight:400;color:var(--text);line-height:1}
.sp-stat-val.urgent-val{color:var(--red)}
.sp-stat-lbl{font-size:7px;letter-spacing:.15em;text-transform:uppercase;color:var(--text-d)}
.sp-stat-div{width:1px;height:28px;background:var(--border)}

/* Area chips */
.area-chips{display:flex;flex-wrap:wrap;gap:5px}
.area-chip{background:var(--gold-dim);border:1px solid rgba(201,169,110,.2);color:var(--gold);font-size:9px;letter-spacing:.12em;text-transform:uppercase;padding:3px 8px}

/* Turno info */
.turno-info{display:flex;flex-direction:column;gap:6px}
.turno-row{display:flex;align-items:center;justify-content:space-between;font-size:10px}
.turno-key{color:var(--text-d);letter-spacing:.1em}
.turno-val{color:var(--text);font-weight:400}
.turno-progress{height:2px;background:var(--bg4);margin-top:6px}
.turno-progress-fill{height:100%;background:var(--gold);transition:width 1s ease}

/* Crew */
.crew-list{display:flex;flex-direction:column;gap:6px}
.crew-item{display:flex;align-items:center;gap:8px;font-size:10px;color:var(--text-m)}
.crew-av{width:22px;height:22px;background:var(--bg4);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:9px;font-weight:500;color:var(--text-d);flex-shrink:0}
.crew-nm{flex:1;font-size:10px;color:var(--text-m)}
.crew-status{width:6px;height:6px;border-radius:50%}
.crew-status.active{background:var(--green);box-shadow:0 0 5px rgba(76,175,130,.4)}
.crew-status.break{background:var(--amber)}
.crew-status.off{background:var(--text-d)}

/* ══ CONTENT ══ */
.content{flex:1;overflow-y:auto;padding:24px;display:flex;flex-direction:column;gap:0}
.section{display:none;flex-direction:column;gap:20px}
.section.active{display:flex;animation:fadeUp .4s ease}
@keyframes fadeUp{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}

/* Section head */
.section-head{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;flex-wrap:wrap}
.section-title{font-family:'Cormorant Garamond',serif;font-size:28px;font-weight:300;color:var(--text);line-height:1.1;letter-spacing:.02em}
.section-desc{font-size:10px;letter-spacing:.18em;text-transform:uppercase;color:var(--text-d);margin-top:4px}
.section-actions{display:flex;align-items:center;gap:10px;flex-wrap:wrap}

/* Pills */
.pill-filters{display:flex;gap:3px;flex-wrap:wrap}
.pill{background:transparent;border:1px solid var(--border);padding:5px 12px;font-family:'Jost',sans-serif;font-size:9px;letter-spacing:.15em;text-transform:uppercase;color:var(--text-d);cursor:pointer;transition:all .2s}
.pill:hover{border-color:var(--border-m);color:var(--text-m)}
.pill.active{border-color:var(--gold);color:var(--gold);background:var(--gold-dim)}

/* New btn */
.btn-new{display:flex;align-items:center;gap:6px;background:transparent;border:1px solid var(--gold);color:var(--gold);padding:6px 14px;font-family:'Jost',sans-serif;font-size:9px;letter-spacing:.2em;text-transform:uppercase;cursor:pointer;transition:all .25s;position:relative;overflow:hidden}
.btn-new::before{content:'';position:absolute;inset:0;background:var(--gold);transform:translateX(-100%);transition:transform .3s;z-index:0}
