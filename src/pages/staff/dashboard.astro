<script>
// @ts-nocheck

// @ts-nocheck
// ── SESIÓN ──────────────────────────────────────────────────────
// ── AUTH ────────────────────────────────────────────────────────
const API = 'http://localhost:3000';
if (!sessionStorage.getItem('hotel_token')) { window.location.replace('/logIn'); }
const storedUser = sessionStorage.getItem('hotel_fullname') || sessionStorage.getItem('hotel_user') || 'Staff';
const storedRole = sessionStorage.getItem('hotel_role') || 'staff';
if (storedRole !== 'staff') { window.location.replace('/'+storedRole+'/dashboard'); }
const avEl = document.getElementById('userAv');
const unEl = document.getElementById('userName');

async function apiFetch(method, path, body=null){
  const token=sessionStorage.getItem('hotel_token');
  const headers={'Content-Type':'application/json'};
  if(token) headers['Authorization']='Bearer '+token;
  const opts={method,headers}; if(body) opts.body=JSON.stringify(body);
  try{
    const res=await fetch(API+path,opts);
    if(res.status===401){sessionStorage.clear();window.location.replace('/logIn');return null;}
    return res.json();
  }catch(e){console.error('[API]',path,e);return null;}
}
function showToast(msg,tipo='success'){const c={success:'var(--green)',warning:'var(--amber)',error:'var(--red)',info:'var(--blue)'};const t=document.createElement('div');t.style.cssText='position:fixed;bottom:24px;right:24px;z-index:9999;background:var(--bg3);border-left:4px solid '+c[tipo]+';color:var(--text);padding:12px 20px;font-family:Jost,sans-serif;font-size:12px;box-shadow:0 8px 32px rgba(0,0,0,.4)';t.textContent=msg;document.body.appendChild(t);setTimeout(()=>t.remove(),3500);}
function fmtRelTime(iso){const d=Date.now()-new Date(iso).getTime(),m=Math.floor(d/60000);if(m<1)return 'ahora';if(m<60)return 'hace '+m+'m';const h=Math.floor(m/60);if(h<24)return 'hace '+h+'h';return 'hace '+Math.floor(h/24)+'d';}
if (avEl) avEl.textContent = storedUser.charAt(0).toUpperCase();
if (unEl) unEl.textContent = storedUser;

// ── TEMA ────────────────────────────────────────────────────────
const root = document.documentElement;
let manualOverride = false, currentTheme = 'night';
const getAutoTheme = () => { const h = new Date().getHours(); return (h >= 6 && h < 18) ? 'day' : 'night'; };
const applyTheme = (t) => { currentTheme = t; t === 'day' ? root.classList.add('day') : root.classList.remove('day'); };
document.getElementById('themeToggle')?.addEventListener('click', () => {
  manualOverride = true; applyTheme(currentTheme === 'day' ? 'night' : 'day');
  setTimeout(() => { manualOverride = false; }, 7200000);
});
applyTheme(getAutoTheme());

// RELOJ
const clockTimeEl = document.getElementById('clockTime'), clockDateEl = document.getElementById('clockDate');
function tick() {
  const now = new Date();
  const h = String(now.getHours()).padStart(2,'0'), m = String(now.getMinutes()).padStart(2,'0'), s = String(now.getSeconds()).padStart(2,'0');
  if (clockTimeEl) clockTimeEl.textContent = h + ':' + m;
  const dias = ['Dom','Lun','Mar','Mié','Jue','Vie','Sáb'], meses = ['Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Sep','Oct','Nov','Dic'];
  if (clockDateEl) clockDateEl.textContent = dias[now.getDay()] + ' ' + now.getDate() + ' ' + meses[now.getMonth()];
  if (!manualOverride && getAutoTheme() !== currentTheme) applyTheme(getAutoTheme());
}
tick(); setInterval(tick, 1000);

// ── JORNADA ─────────────────────────────────────────────────────
function detectJornada() {
  const h = new Date().getHours();
  if (h >= 6 && h < 14) return { label: 'Matutino', color: 'var(--gold)' };
  if (h >= 14 && h < 22) return { label: 'Vespertino', color: 'var(--blue)' };
  return { label: 'Nocturno', color: 'var(--teal)' };
}
const jornada = detectJornada();
const jlEl = document.getElementById('jornadaLabel'), jdEl = document.getElementById('jornadaDot');
if (jlEl) jlEl.textContent = jornada.label;
if (jdEl) jdEl.style.background = jornada.color;

// Turno horario
const turnoHoras = { Matutino: '06:00 – 14:00', Vespertino: '14:00 – 22:00', Nocturno: '22:00 – 06:00' };
const turnoStart = { Matutino: 6, Vespertino: 14, Nocturno: 22 };
function getTurnoPct(): number {
  const now = new Date(), start = turnoStart[jornada.label] || 6;
  const elapsed = ((now.getHours() - start + 24) % 24) * 60 + now.getMinutes();
  return Math.min(100, Math.max(0, Math.round(elapsed / 480 * 100)));
}

// ── DATOS ───────────────────────────────────────────────────────
type Prioridad = 'urgente' | 'alta' | 'normal' | 'baja';
type TareaCategoria = 'urgente' | 'limpieza' | 'servicio' | 'mantenimiento';
type TareaStatus = TareaCategoria | 'completada';
interface Tarea { id: number; hab: number; titulo: string; desc: string; tipo: TareaCategoria; prioridad: Prioridad; hora: string; completada: boolean; }

// ── TAREAS desde API ────────────────────────────────────────────
let tareasAPI = [];
async function loadTareas(){
  const data = await apiFetch('GET','/api/tasks'); if(!data) return;
  tareasAPI=data; renderTareas(activeFilter); updateSidePanel();
}
async function completarTareaAPI(id){
  await apiFetch('PATCH','/api/tasks/'+id+'/complete');
  showToast('Tarea completada ✓'); loadTareas();
}
let nextTareaId = 9;
const prioColors={1:'var(--red)',2:'var(--amber)',3:'var(--green)',4:'var(--blue)',urgent:'var(--red)',cleaning:'var(--green)',service:'var(--gold)',maintenance:'var(--blue)'};
const prioClass={1:'urgente',2:'urgente',cleaning:'limpieza',service:'servicio',maintenance:'mantenimiento',urgent:'urgente'};
function renderTareas(filter = 'todas') {
  const tareas = tareasAPI.length ? tareasAPI.map(t=>({
    id: t.id, titulo: t.title, desc: t.description||'', hab: t.roomNumber||'—',
    tipo: t.type, prioridad: t.priority<=2||t.type==='urgent'?'urgente':t.type==='cleaning'?'limpieza':t.type==='service'?'servicio':'mantenimiento',
    completada: t.status==='completed'||t.status==='cancelled', tiempo: t.scheduledFor||t.createdAt
  })) : [];
  const grid = document.getElementById('tareasGrid'); if (!grid) return;
  const filtered = filter === 'todas' ? tareas : filter === 'completada' ? tareas.filter(t => t.completada) : tareas.filter(t => t.tipo === filter && !t.completada);
  // Ordenar: urgentes primero, luego por hora
  const prioOrder = {urgente:0,alta:1,normal:2,baja:3};
  filtered.sort((a,b) => { if(a.completada !== b.completada) return a.completada?1:-1; return (prioOrder[a.prioridad]||2)-(prioOrder[b.prioridad]||2); });
  grid.innerHTML = '';
  filtered.forEach((t, i) => {
    const card = document.createElement('div');
    card.className = `tarea-card ${t.completada ? 'completada' : t.tipo}`;
    card.style.animationDelay = (i * 0.04) + 's';
    card.innerHTML = `
      <div class="tc-body">
        <div class="tc-top">
          <div class="tc-badges">
            <span class="tc-tipo ${t.completada ? 'completada' : t.tipo}">${t.completada ? 'Completada' : t.tipo}</span>
            <span class="tc-prio">${t.prioridad}</span>
          </div>
          <div class="tc-hab">${t.hab}</div>
        </div>
        <div class="tc-title">${t.titulo}</div>
        <div class="tc-desc">${t.desc}</div>
      </div>
      <div class="tc-foot">
        <span class="tc-time">⏱ ${t.hora}</span>
        <button class="tc-check ${t.completada ? 'done' : ''}" onclick="toggleTarea(${t.id})">${t.completada ? '✓ Hecho' : 'Completar'}</button>
      </div>`;
    card.addEventListener('click', (e) => { if ((e.target).classList.contains('tc-check')) return; openTareaModal(t); });
    grid.appendChild(card);
  });

  const td = document.getElementById('taskDesc');
  if (td) td.textContent = `${tareas.filter(t=>!t.completada).length} pendientes · ${tareas.filter(t=>t.completada).length} completadas`;
}
renderTareas();

function openTareaModal(t) {
  openModal('Hab. ' + t.hab + ' · ' + t.titulo,
    `<div class="detail-g"><div class="dg-item"><span class="dg-lbl">Tipo</span><span class="dg-val">${t.tipo}</span></div><div class="dg-item"><span class="dg-lbl">Prioridad</span><span class="dg-val">${t.prioridad}</span></div><div class="dg-item"><span class="dg-lbl">Hora programada</span><span class="dg-val">${t.hora}</span></div><div class="dg-item"><span class="dg-lbl">Estado</span><span class="dg-val">${t.completada?'Completada':'Pendiente'}</span></div></div><p style="font-size:12px;color:var(--text-m);line-height:1.6">${t.desc}</p>`,
    `<button class="btn-ghost" onclick="closeModal()">Cerrar</button><button class="mf-btn" onclick="toggleTarea(${t.id});closeModal()"><span>${t.completada ? 'Reabrir' : 'Marcar completada'}</span></button>`
  );
}

window.toggleTarea = (id) => {
  completarTareaAPI(id);
  const t = tareasAPI.find(x => x.id === id); if (!t) return;
  t.completada = true;
  if (t.completada) {
    const now = new Date();
    const h = String(now.getHours()).padStart(2,'0'), m = String(now.getMinutes()).padStart(2,'0');
    bitacora.unshift({id:nextBitaId++,hora:h+':'+m,titulo:t.titulo+' · Hab. '+t.hab,desc:'Tarea completada por '+storedUser+'.',tipo:'completada'});
  }
  const activeFilter = (document.querySelector('.pill.active'))?.getAttribute('data-tf') || 'todas';
  renderTareas(activeFilter); updateSidePanel(); renderBitacora();
};

document.getElementById('taskFilters')?.addEventListener('click', (e) => {
  const btn = (e.target).closest('.pill'); if (!btn) return;
  document.querySelectorAll('[data-tf]').forEach(b => b.classList.remove('active')); btn.classList.add('active');
  renderTareas(btn.getAttribute('data-tf') || 'todas');
});

document.getElementById('btnNewTask')?.addEventListener('click', () => {
  openModal('Nueva tarea', `<div class="form-grid"><div class="form-field"><label>Habitación</label><input id="nt-hab" type="number" placeholder="Ej. 312" /></div><div class="form-field"><label>Título</label><input id="nt-title" placeholder="Descripción breve" /></div><div class="form-field"><label>Detalle</label><textarea id="nt-desc" rows="2" placeholder="Instrucciones adicionales…"></textarea></div><div class="form-field"><label>Tipo</label><select id="nt-tipo"><option value="limpieza">Limpieza</option><option value="servicio">Servicio</option><option value="mantenimiento">Mantenimiento</option><option value="urgente">Urgente</option></select></div><div class="form-field"><label>Hora</label><input id="nt-hora" type="time" /></div></div>`,
    `<button class="btn-ghost" onclick="closeModal()">Cancelar</button><button class="mf-btn" onclick="saveNewTarea()"><span>Crear tarea</span></button>`
  );
});

window.saveNewTarea = () => {
  const hab = parseInt((document.getElementById('nt-hab')).value);
  const title = (document.getElementById('nt-title')).value.trim();
  const desc = (document.getElementById('nt-desc')).value.trim();
  const tipo = (document.getElementById('nt-tipo')).value as TareaCategoria;
  const hora = (document.getElementById('nt-hora')).value || '—';
  if (!hab || !title) { alert('Habitación y título son requeridos.'); return; }
  tareas.unshift({id:nextTareaId++,hab,titulo:title,desc:desc||'Sin descripción',tipo,prioridad:tipo==='urgente'?'urgente':'normal',hora,completada:false});
  closeModal(); renderTareas(); updateSidePanel();
};

// ── SOLICITUDES ──────────────────────────────────────────────────
function renderSolicitudes(filter = 'todas') {
  const solicitudes = solicitudesAPI.map(s=>({id:s.id,hab:s.roomNumber||'—',urgencia:s.type==='urgent'?'urgente':'normal',msg:s.title||s.description||'—',tiempo:fmtRelTime(s.createdAt),atendida:s.status!=='open'}));
  const list = document.getElementById('solList'); if (!list) return;
  const filtered = filter === 'todas' ? solicitudes : solicitudes.filter(s => s.prioridad === filter);
  filtered.sort((a,b) => { const o={urgente:0,normal:1,atendida:2}; return (o[a.prioridad]||1)-(o[b.prioridad]||1); });
  list.innerHTML = '';
  filtered.forEach((s, i) => {
    const card = document.createElement('div'); card.className = 'sol-card'; card.style.animationDelay = (i*0.04)+'s';
    card.innerHTML = `<div class="sol-accent ${s.prioridad}"></div><div class="sol-body"><div class="sol-top"><div class="sol-hab">${s.hab}</div><div class="sol-guest">${s.guest}</div></div><div class="sol-msg">${s.msg}</div><div class="sol-meta"><span class="sol-tag ${s.prioridad}">${s.prioridad}</span><span class="sol-time">${s.tiempo}</span></div></div><div class="sol-actions"><button class="sol-btn" onclick="verSol(${s.id})">Ver</button><button class="sol-btn ${s.prioridad==='atendida'?'atend':''}" onclick="atenderSol(${s.id})">${s.prioridad==='atendida'?'✓ Atendida':'Atender'}</button></div>`;
    list.appendChild(card);
  });
}
renderSolicitudes();

window.verSol = (id) => {
  const s = solicitudes.find(x => x.id === id); if (!s) return;
  openModal('Solicitud · Hab. '+s.hab, `<div class="detail-g"><div class="dg-item"><span class="dg-lbl">Huésped</span><span class="dg-val">${s.guest}</span></div><div class="dg-item"><span class="dg-lbl">Prioridad</span><span class="dg-val">${s.prioridad}</span></div><div class="dg-item"><span class="dg-lbl">Tiempo</span><span class="dg-val">${s.tiempo}</span></div></div><p style="font-size:13px;color:var(--text);font-weight:300;line-height:1.6;margin-top:4px">"${s.msg}"</p>`,
    `<button class="btn-ghost" onclick="closeModal()">Cerrar</button><button class="mf-btn" onclick="atenderSol(${s.id});closeModal()"><span>${s.prioridad==='atendida'?'Reabrir':'Marcar atendida'}</span></button>`
  );
};

window.atenderSol = (id) => {
  atenderSolicitudAPI(id);
  const s = solicitudesAPI.find(x => x.id === id); if (!s) return;
  s.prioridad = s.prioridad === 'atendida' ? 'normal' : 'atendida';
  if (s.prioridad === 'atendida') {
    const now = new Date(); const h = String(now.getHours()).padStart(2,'0'), m = String(now.getMinutes()).padStart(2,'0');
    bitacora.unshift({id:nextBitaId++,hora:h+':'+m,titulo:'Solicitud atendida · Hab. '+s.hab,desc:s.msg.slice(0,80)+(s.msg.length>80?'…':''),tipo:'solicitud'});
    renderBitacora();
  }
  const af = (document.querySelector('[data-sf].active'))?.getAttribute('data-sf') || 'todas';
    atenderSolicitudAPI(s.id||s); renderSolicitudes(af); updateSidePanel();;

document.querySelectorAll('[data-sf]').forEach(btn => {
  btn.addEventListener('click', () => { document.querySelectorAll('[data-sf]').forEach(b => b.classList.remove('active')); btn.classList.add('active'); renderSolicitudes(btn.getAttribute('data-sf') || 'todas'); });
});

// ── INVENTARIO ───────────────────────────────────────────────────
function renderInventario() {
  const inventario = inventarioAPI.map(i=>({id:i.id,nombre:i.name,cat:i.category,qty:i.quantity,max:i.maxQuantity,min:i.minQuantity,unidad:i.unit}));
  const grid = document.getElementById('invGrid'); if (!grid) return;
  grid.innerHTML = '';
  inventario.forEach((item) => {
    const pct = Math.round(item.qty / item.max * 100);
    const status = pct > 50 ? 'ok' : pct > 20 ? 'mid' : 'low';
    const statusLabel = pct > 50 ? 'Suficiente' : pct > 20 ? 'Bajo' : '⚠ Crítico';
    const card = document.createElement('div'); card.className = 'inv-card'; card.style.setProperty('--i',String(i)); card.style.animationDelay=(i*0.04)+'s';
    card.innerHTML = `
      <div class="inv-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/></svg></div>
      <div class="inv-name">${item.nombre}</div>
      <div class="inv-cat">${item.cat}</div>
      <div class="inv-bar-bg"><div class="inv-bar-fill ${status}" style="width:0" data-w="${pct}%"></div></div>
      <div class="inv-bottom">
        <span><span class="inv-qty">${item.qty}</span><span class="inv-max"> / ${item.max} ${item.unidad}</span></span>
        <span class="inv-status ${status}">${statusLabel}</span>
      </div>
      <div class="inv-actions">
        <button class="inv-btn" onclick="adjustInv(${item.id},-1)">−</button>
        <button class="inv-btn" onclick="adjustInv(${item.id},1)">+</button>
        <button class="inv-btn req" onclick="requestInv(${item.id})">Solicitar</button>
      </div>`;
    grid.appendChild(card);
    setTimeout(() => { const fill = card.querySelector('.inv-bar-fill'); if(fill) fill.style.width = fill.getAttribute('data-w') || '0'; }, 100 + iIdx * 40);
  });
}
loadInventario();

window.adjustInv = (id, delta) => {
  ajustarInventario(id, delta);
};
window.requestInv = (id) => {
  solicitarReposicion(id);
};
window.confirmRequest = (id) => {
  closeModal();
  const item = inventario.find(x => x.id === id); if (!item) return;
  const now = new Date(); const h = String(now.getHours()).padStart(2,'0'), m = String(now.getMinutes()).padStart(2,'0');
  bitacora.unshift({id:nextBitaId++,hora:h+':'+m,titulo:'Solicitud de reposición',desc:item.nombre+' — stock bajo ('+item.qty+'/'+item.max+').',tipo:'nota'});
  renderBitacora();
};

document.getElementById('btnReporte')?.addEventListener('click', () => {
  const low = inventario.filter(i => i.qty/i.max <= 0.2);
  const mid = inventario.filter(i => i.qty/i.max > 0.2 && i.qty/i.max <= 0.5);
  openModal('Reporte de inventario',
    `<p style="margin-bottom:14px;color:var(--text-m)">Estado del inventario al cierre de turno.</p>${low.length?`<p style="color:var(--red);font-size:11px;margin-bottom:8px">⚠ Crítico (${low.length}): ${low.map(i=>i.nombre).join(', ')}</p>`:''}${mid.length?`<p style="color:var(--amber);font-size:11px;margin-bottom:8px">↓ Bajo (${mid.length}): ${mid.map(i=>i.nombre).join(', ')}</p>`:''}${(!low.length&&!mid.length)?`<p style="color:var(--green);font-size:11px">✓ Todo en orden.</p>`:''}`,
    `<button class="btn-ghost" onclick="closeModal()">Cerrar</button>`
  );
});

// ── BITÁCORA ─────────────────────────────────────────────────────
function renderBitacora() {
  const el = document.getElementById('bitacora'); if (!el) return;
  el.innerHTML = '';
  [...bitacora].sort((a,b) => b.id - a.id).forEach((entry, i) => {
    const div = document.createElement('div'); div.className = 'bita-entry'; div.style.animationDelay = (i*0.04)+'s';
    div.innerHTML = `<div class="bita-dot-wrap"><div class="bita-dot ${entry.tipo}"></div></div><div class="bita-content"><div class="bita-time">${entry.hora}</div><div class="bita-title">${entry.titulo}</div><div class="bita-desc">${entry.desc}</div><span class="bita-tag ${entry.tipo}">${entry.tipo}</span></div>`;
    el.appendChild(div);
  });

  // Resumen
  const rr = document.getElementById('regResumen');
  if (rr) {
    const counts = {};
    bitacora.forEach(b => { counts[b.tipo] = (counts[b.tipo]||0)+1; });
    rr.innerHTML = `<div class="rr-title">Resumen del turno</div>${Object.entries(counts).map(([k,v])=>`<div class="rr-item"><span class="rr-lbl">${k.charAt(0).toUpperCase()+k.slice(1)}</span><span class="rr-val">${v}</span></div>`).join('')}<div class="rr-item" style="margin-top:8px"><span class="rr-lbl">Total entradas</span><span class="rr-val">${bitacora.length}</span></div>`;
  }
}
renderBitacora();

document.getElementById('btnAddLog')?.addEventListener('click', () => {
  openModal('Agregar nota al turno', `<div class="form-grid"><div class="form-field"><label>Tipo de entrada</label><select id="log-tipo"><option value="nota">Nota</option><option value="limpieza">Limpieza</option><option value="servicio">Servicio</option><option value="mantenimiento">Mantenimiento</option><option value="solicitud">Solicitud</option></select></div><div class="form-field"><label>Título</label><input id="log-title" placeholder="Resumen breve…" /></div><div class="form-field"><label>Descripción</label><textarea id="log-desc" rows="3" placeholder="Detalle de la actividad…"></textarea></div></div>`,
    `<button class="btn-ghost" onclick="closeModal()">Cancelar</button><button class="mf-btn" onclick="saveLog()"><span>Registrar</span></button>`
  );
});

window.saveLog = () => {
  const tipo = (document.getElementById('log-tipo')).value;
  const title = (document.getElementById('log-title')).value.trim();
  const desc = (document.getElementById('log-desc')).value.trim();
  if (!title) { alert('El título es requerido.'); return; }
  const now = new Date(); const h = String(now.getHours()).padStart(2,'0'), m = String(now.getMinutes()).padStart(2,'0');
  bitacora.unshift({id:nextBitaId++,hora:h+':'+m,titulo:title,desc:desc||'—',tipo});
  closeModal(); renderBitacora();
};

// ── SOLICITUDES desde API ────────────────────────────────────────
let solicitudesAPI = [];
async function loadSolicitudes(){
  const data = await apiFetch('GET','/api/incidents?status=open'); if(!data) return;
  solicitudesAPI = data.filter(i => i.type==='request' || i.type==='urgent');
  renderSolicitudes();
}

// ── WebSocket ────────────────────────────────────────────────────
function conectarWS(){
  const role  = sessionStorage.getItem('hotel_role') || 'staff';
  const token = sessionStorage.getItem('hotel_token') || '';
  const wsUrl = API.replace('http','ws');
  const ws = new WebSocket(wsUrl + '/live?role=' + role + '&token=' + token);
  ws.onopen = () => { setInterval(() => ws.readyState === 1 && ws.send(JSON.stringify({type:'ping'})), 30000); };
  ws.onmessage = ({data}) => {
    try {
      const msg = JSON.parse(data);
      if (msg.type === 'new_task')         { loadTareas();     showToast('Nueva tarea asignada','info'); }
      if (msg.type === 'assigned_incident'){ loadSolicitudes(); showToast('Nueva solicitud asignada','warning'); }
    } catch {}
  };
  ws.onclose = () => setTimeout(conectarWS, 3000);
}

// ── INICIALIZACIÓN ───────────────────────────────────────────────
document.addEventListener('DOMContentLoaded', () => {
  loadTareas();
  loadSolicitudes();
  loadInventario();
  conectarWS();
});
}
</script>