---
// src/pages/admin/dashboard.astro
// Solo accesible para admin
import Distribucion from '../../components/distribucion.astro';
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=Jost:wght@200;300;400;500&display=swap"
  rel="stylesheet"
/>

<script is:inline>
  const _r = sessionStorage.getItem("hotel_role");
  const _u = sessionStorage.getItem("hotel_user");
  if (!_u || _r !== "admin") window.location.replace("/logIn");
</script>

<div class="shell">
  <!-- SIDEBAR -->
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-top">
      <div class="brand-mark">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M3 21h18M3 7l9-4 9 4M4 7v14M20 7v14M8 10v4M12 10v4M16 10v4"></path>
        </svg>
      </div>
      <div class="brand-info">
        <span class="brand-name">Grand <em>&eacute;lite</em></span>
        <span class="brand-role">Administrador</span>
      </div>
      <button class="sidebar-close" id="sidebarClose">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M18 6L6 18M6 6l12 12"></path>
        </svg>
      </button>
    </div>
    <nav class="nav">
      <button class="nav-item active" data-section="overview">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect>
          <rect x="3" y="14" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect>
        </svg>
        <span>Resumen</span>
      </button>
      <button class="nav-item" data-section="finanzas">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M12 2v20M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"></path>
        </svg>
        <span>Finanzas</span>
      </button>
      <button class="nav-item" data-section="habitaciones">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"></path>
          <polyline points="9 22 9 12 15 12 15 22"></polyline>
        </svg>
        <span>Habitaciones</span>
      </button>
      <button class="nav-item" data-section="reservaciones">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <rect x="3" y="4" width="18" height="18" rx="2"></rect>
          <line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line>
          <line x1="3" y1="10" x2="21" y2="10"></line>
        </svg>
        <span>Reservaciones</span>
      </button>
      <button class="nav-item" data-section="huespedes">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"></path>
          <circle cx="9" cy="7" r="4"></circle>
          <path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"></path>
        </svg>
        <span>Hu&eacute;spedes</span>
      </button>
      <button class="nav-item" data-section="usuarios">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="12" cy="8" r="4"></circle>
          <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"></path>
          <path d="M19 8v6M22 11h-6"></path>
        </svg>
        <span>Usuarios</span>
      </button>
    </nav>
    <div class="sidebar-footer">
      <div class="user-chip">
        <div class="user-avatar" id="userAvatar">A</div>
        <div class="user-info">
          <span class="user-name" id="sidebarUser">Admin</span>
          <span class="user-dept">Administraci&oacute;n</span>
        </div>
      </div>
      <button class="btn-logout" id="btnLogout" title="Cerrar sesion">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4M16 17l5-5-5-5M21 12H9"></path>
        </svg>
      </button>
    </div>
  </aside>

  <!-- MAIN -->
  <main class="main">
    <header class="topbar">
      <div class="topbar-left">
        <button class="menu-btn" id="menuBtn">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
        <div class="topbar-title">
          <span class="section-label" id="sectionLabel">Resumen General</span>
          <span class="topbar-date" id="topbarDate"></span>
        </div>
      </div>
      <div class="topbar-right">
        <div class="theme-toggle-top" id="themeToggleTop">
          <svg class="t-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
          </svg>
          <svg class="t-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"></path>
          </svg>
        </div>
        <div class="topbar-clock" id="topbarClock"></div>
        <div class="notif-dot"></div>
      </div>
    </header>

    <!-- ══ RESUMEN ══ -->
    <section class="section active" id="sec-overview">
      <div class="kpi-grid">
        <div class="kpi-card" style="--i:0">
          <div class="kpi-top"><span class="kpi-label">Ingresos del mes</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"></path></svg>
          </div>
          <span class="kpi-value" id="kpi-ingresos">$—</span>
          <div class="kpi-trend up"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="18 15 12 9 6 15"></polyline></svg>+12.4% vs mes anterior</div>
          <div class="kpi-bar"><div class="kpi-fill" style="width:78%"></div></div>
        </div>
        <div class="kpi-card" style="--i:1">
          <div class="kpi-top"><span class="kpi-label">Ocupaci&oacute;n actual</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"></path></svg>
          </div>
          <span class="kpi-value" id="kpi-ocupacion">—<small>%</small></span>
          <div class="kpi-trend up"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="18 15 12 9 6 15"></polyline></svg>Actualizado en tiempo real</div>
          <div class="kpi-bar"><div class="kpi-fill" id="kpi-ocupacion-bar" style="width:0%"></div></div>
        </div>
        <div class="kpi-card" style="--i:2">
          <div class="kpi-top"><span class="kpi-label">Reservaciones hoy</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="4" width="18" height="18" rx="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
          </div>
          <span class="kpi-value" id="kpi-reservaciones">—</span>
          <div class="kpi-trend up"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="18 15 12 9 6 15"></polyline></svg>Check-ins pendientes hoy</div>
          <div class="kpi-bar"><div class="kpi-fill" style="width:60%"></div></div>
        </div>
        <div class="kpi-card" style="--i:3">
          <div class="kpi-top"><span class="kpi-label">Gastos operativos</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"></path></svg>
          </div>
          <span class="kpi-value" id="kpi-gastos">$—</span>
          <div class="kpi-trend down"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>-3.1% vs mes anterior</div>
          <div class="kpi-bar"><div class="kpi-fill accent2" style="width:35%"></div></div>
        </div>
      </div>
      <div class="charts-row">
        <div class="chart-card wide" style="--i:4">
          <div class="chart-header"><span class="chart-title">Ingresos mensuales</span><span class="chart-sub">Últimos 7 meses · MXN</span></div>
          <div class="bar-chart" id="barChart"></div>
          <div class="bar-labels" id="barLabels"></div>
        </div>
        <div class="chart-card" style="--i:5">
          <div class="chart-header"><span class="chart-title">Distribuci&oacute;n</span><span class="chart-sub">Por categoría</span></div>
          <div class="donut-wrap">
            <svg class="donut" viewBox="0 0 120 120" id="donutChart"></svg>
            <div class="donut-center"><span class="donut-pct">78%</span><span class="donut-lbl">Hospedaje</span></div>
          </div>
          <div class="donut-legend" id="donutLegend"></div>
        </div>
      </div>
      <div class="bottom-row">
        <div class="chart-card" style="--i:6">
          <div class="chart-header"><span class="chart-title">Estado de habitaciones</span><span class="chart-sub" id="roomsTotal">— totales</span></div>
          <div class="rooms-grid" id="roomsGrid"></div>
          <div class="rooms-legend">
            <span class="rl-item"><span class="rl-dot occupied"></span>Ocupada</span>
            <span class="rl-item"><span class="rl-dot free"></span>Libre</span>
            <span class="rl-item"><span class="rl-dot maintenance"></span>Mantenimiento</span>
            <span class="rl-item"><span class="rl-dot reserved"></span>Reservada</span>
          </div>
        </div>
        <div class="chart-card wide" style="--i:7">
          <div class="chart-header"><span class="chart-title">Actividad reciente</span><span class="chart-sub">Últimas transacciones</span></div>
          <div class="activity-list" id="activityList"></div>
        </div>
      </div>
    </section>

    <!-- ══ FINANZAS ══ -->
    <section class="section" id="sec-finanzas">
      <div class="fin-kpi-grid">
        <div class="fin-kpi" style="--i:0"><span class="fk-label">Ingresos totales</span><span class="fk-val">$1,842,300</span><span class="fk-sub badge-up">+8.2% anual</span></div>
        <div class="fin-kpi" style="--i:1"><span class="fk-label">Egresos totales</span><span class="fk-val">$634,800</span><span class="fk-sub badge-dn">+2.1% anual</span></div>
        <div class="fin-kpi" style="--i:2"><span class="fk-label">Utilidad neta</span><span class="fk-val">$1,207,500</span><span class="fk-sub badge-up">65.5% margen</span></div>
        <div class="fin-kpi" style="--i:3"><span class="fk-label">Cuentas por cobrar</span><span class="fk-val">$48,200</span><span class="fk-sub badge-dn">12 facturas</span></div>
      </div>
      <div class="charts-row">
        <div class="chart-card wide" style="--i:4">
          <div class="chart-header"><span class="chart-title">Balance mensual</span><span class="chart-sub">Ingresos vs Egresos</span></div>
          <div class="dual-bar-chart" id="dualBarChart"></div>
          <div class="bar-labels" id="dualLabels"></div>
          <div class="dual-legend">
            <span class="dl-item"><span class="dl-dot" style="background:var(--gold)"></span>Ingresos</span>
            <span class="dl-item"><span class="dl-dot" style="background:var(--red)"></span>Egresos</span>
          </div>
        </div>
        <div class="chart-card" style="--i:5">
          <div class="chart-header"><span class="chart-title">Desglose de gastos</span><span class="chart-sub">Por categoría</span></div>
          <div class="expense-list" id="expenseList"></div>
        </div>
      </div>
      <div class="chart-card" style="--i:6">
        <div class="chart-header"><span class="chart-title">Historial de transacciones</span><span class="chart-sub">Últimas 10 operaciones</span></div>
        <div class="table-wrap">
          <table class="data-table" id="txTable">
            <thead><tr><th>Fecha</th><th>Concepto</th><th>Categoría</th><th>M&eacute;todo</th><th>Monto</th><th>Estado</th></tr></thead>
            <tbody id="txBody"></tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ══ HABITACIONES ══ -->
    <section class="section" id="sec-habitaciones">
      <div class="hab-toolbar">
        <!-- Filtros de estado (solo visibles en vista lista) -->
        <div class="hab-filters" id="habFilters">
          <button class="filter-btn active" data-filter="todas">Todas <span class="fcount" id="fc-todas">—</span></button>
          <button class="filter-btn" data-filter="libre">Libre <span class="fcount" id="fc-libre">—</span></button>
          <button class="filter-btn" data-filter="ocupada">Ocupada <span class="fcount" id="fc-ocupada">—</span></button>
          <button class="filter-btn" data-filter="mantenimiento">Mant. <span class="fcount" id="fc-mantenimiento">—</span></button>
          <button class="filter-btn" data-filter="reservada">Reservada <span class="fcount" id="fc-reservada">—</span></button>
        </div>
        <div style="display:flex;align-items:center;gap:10px">
          <!-- Toggle vista plano / lista -->
          <div class="view-toggle" id="habViewToggle">
            <button class="view-btn" id="btnViewPlan" onclick="setHabView('plan')">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="width:13px;height:13px">
                <rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect>
                <rect x="3" y="14" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect>
              </svg>
              Plano
            </button>
            <button class="view-btn active" id="btnViewList" onclick="setHabView('list')">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="width:13px;height:13px">
                <line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line>
                <line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line>
                <line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line>
              </svg>
              Lista
            </button>
          </div>
          <button class="btn-primary" id="btnNuevaHab">+ Nueva habitaci&oacute;n</button>
        </div>
      </div>

      <!-- VISTA PLANO — componente Distribucion -->
      <div id="habViewPlan" style="display:none;flex:1;min-height:0;overflow-y:auto">
        <!-- Leyenda del plano -->
        <div class="plan-legend">
          <div class="pl-item"><span class="pl-dot" style="background:var(--status-ocupada,#c9a96e)"></span>Ocupada</div>
          <div class="pl-item"><span class="pl-dot" style="background:var(--status-libre-limpia,#4caf82)"></span>Libre limpia</div>
          <div class="pl-item"><span class="pl-dot" style="background:var(--status-libre-sucia,#f0a500)"></span>Libre sucia</div>
          <div class="pl-item"><span class="pl-dot" style="background:var(--status-reservada,#6b8cff)"></span>Reservada</div>
          <div class="pl-item"><span class="pl-dot" style="background:var(--status-checkout,#3ec9c9)"></span>Check-out hoy</div>
          <div class="pl-item"><span class="pl-dot" style="background:var(--status-mantenimiento,#e05555)"></span>Mantenimiento</div>
          <div class="pl-item"><span class="pl-dot" style="background:var(--status-bloqueada,#4a4a5a)"></span>Bloqueada</div>
        </div>
        <!-- Búsqueda en plano -->
        <div class="plan-search-wrap" style="margin-bottom:14px">
          <div class="search-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            <input class="search-input" id="planSearch" placeholder="Buscar habitación o huésped…" />
          </div>
        </div>
        <Distribucion id="adminDistWrap" />
      </div>

      <!-- VISTA LISTA — tabla -->
      <div id="habViewList" class="chart-card" style="--i:0">
        <div class="table-wrap">
          <table class="data-table" id="habTable">
            <thead><tr><th>N°</th><th>Tipo</th><th>Piso</th><th>Capacidad</th><th>Tarifa/noche</th><th>Estado</th><th>Hu&eacute;sped actual</th><th>Acciones</th></tr></thead>
            <tbody id="habBody"></tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ══ RESERVACIONES ══ -->
    <section class="section" id="sec-reservaciones">
      <div class="hab-toolbar">
        <div class="hab-filters">
          <button class="filter-btn active" data-rfilter="todas">Todas</button>
          <button class="filter-btn" data-rfilter="pendiente">Pendiente</button>
          <button class="filter-btn" data-rfilter="confirmada">Confirmada</button>
          <button class="filter-btn" data-rfilter="checkin">Check-in</button>
          <button class="filter-btn" data-rfilter="checkout">Check-out</button>
          <button class="filter-btn" data-rfilter="cancelada">Cancelada</button>
        </div>
        <button class="btn-primary" id="btnNuevaRes">+ Nueva reservacion</button>
      </div>
      <div class="chart-card" style="--i:0">
        <div class="table-wrap">
          <table class="data-table" id="resTable">
            <thead><tr><th>ID</th><th>Hu&eacute;sped</th><th>Habitaci&oacute;n</th><th>Entrada</th><th>Salida</th><th>Noches</th><th>Total</th><th>Estado</th><th>Acciones</th></tr></thead>
            <tbody id="resBody"></tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ══ HUÉSPEDES ══ -->
    <section class="section" id="sec-huespedes">
      <div class="hab-toolbar">
        <div class="search-wrap">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          <input class="search-input" id="guestSearch" placeholder="Buscar hu&eacute;sped…" />
        </div>
        <button class="btn-primary" id="btnNuevoHuésped">+ Nuevo huésped</button>
      </div>
      <div class="chart-card" style="--i:0">
        <div class="table-wrap">
          <table class="data-table" id="guestTable">
            <thead><tr><th>Nombre</th><th>Email</th><th>Teléfono</th><th>Estancias</th><th>Última visita</th><th>Gasto total</th><th>Estado</th><th>Acciones</th></tr></thead>
            <tbody id="guestBody"></tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ══ USUARIOS ══ -->
    <section class="section" id="sec-usuarios">
      <div class="usr-layout">
        <div class="usr-form-card" style="--i:0">
          <div class="chart-header"><span class="chart-title">Dar de alta usuario</span><span class="chart-sub" id="formModeLabel">Nuevo</span></div>
          <form class="usr-form" id="userForm" novalidate>
            <input type="hidden" id="editUserId" value="" />
            <div class="uf-row">
              <div class="uf-field"><label class="uf-label">Nombre completo</label><input class="uf-input" id="uf-nombre" placeholder="Ej. María García" /></div>
              <div class="uf-field"><label class="uf-label">Usuario</label><input class="uf-input" id="uf-user" placeholder="maria.garcia" /></div>
            </div>
            <div class="uf-row">
              <div class="uf-field"><label class="uf-label">Contraseña</label><input class="uf-input" id="uf-pass" type="password" placeholder="••••••••" /></div>
              <div class="uf-field"><label class="uf-label">Rol</label><select class="uf-input uf-select" id="uf-rol"><option value="admin">Admin</option><option value="recepcion" selected>Recepci&oacute;n</option><option value="staff">Staff</option></select></div>
            </div>
            <div class="uf-row">
              <div class="uf-field"><label class="uf-label">Jornada laboral</label><select class="uf-input uf-select" id="uf-jornada"><option value="matutino">Matutino 06:00–14:00</option><option value="vespertino">Vespertino 14:00–22:00</option><option value="nocturno">Nocturno 22:00–06:00</option><option value="completo">Tiempo completo</option></select></div>
              <div class="uf-field"><label class="uf-label">Estado</label><select class="uf-input uf-select" id="uf-status"><option value="activo">Activo</option><option value="inactivo">Inactivo</option><option value="vacaciones">Vacaciones</option><option value="baja">Baja</option></select></div>
            </div>
            <div class="uf-actions">
              <button type="button" class="btn-ghost" id="btnCancelEdit">Cancelar</button>
              <button type="submit" class="btn-primary" id="btnSaveUser">Guardar usuario</button>
            </div>
            <div class="uf-msg" id="ufMsg"></div>
          </form>
        </div>
        <div class="usr-list-card" style="--i:1">
          <div class="chart-header"><span class="chart-title">Personal registrado</span><span class="chart-sub" id="userCount">0 usuarios</span></div>
          <div class="user-cards" id="userCards"></div>
        </div>
      </div>
    </section>
  </main>
</div>

<div class="sidebar-overlay" id="sidebarOverlay"></div>

<!-- MODAL HABITACIÓN (admin — más opciones que el de recepción) -->
<div class="modal-backdrop" id="modalBackdrop">
  <div class="modal" id="modal">
    <div class="modal-header">
      <span class="modal-title" id="modalTitle">Detalle</span>
      <button class="modal-close" id="modalClose">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 6L6 18M6 6l12 12"></path></svg>
      </button>
    </div>
    <div class="modal-body" id="modalBody"></div>
    <div class="modal-footer">
      <button class="btn-ghost" id="modalCancel">Cerrar</button>
      <button class="btn-primary" id="modalConfirm" style="display:none">Confirmar</button>
    </div>
  </div>
</div>

<style>
  *,*::before,*::after { margin:0; padding:0; box-sizing:border-box; }

  :root {
    --gold:#c9a96e; --gold-light:#e2c99a; --gold-dim:rgba(201,169,110,0.12); --gold-fg:#0a0a0b;
    --green:#4caf82; --red:#e05555; --blue:#6b8cff; --amber:#f0a500; --teal:#3ec9c9;
    --bg:#0a0a0b; --bg2:#111113; --bg3:#18181c; --bg4:#1e1e24;
    --text:#e8e4dc; --text-m:#8a8680; --text-d:#4a4a52;
    --border:rgba(201,169,110,0.1); --border-h:rgba(201,169,110,0.28);
    --sidebar-w:240px;
    --status-ocupada:#c9a96e; --status-libre-limpia:#4caf82; --status-libre-sucia:#f0a500;
    --status-reservada:#6b8cff; --status-checkout:#3ec9c9;
    --status-mantenimiento:#e05555; --status-bloqueada:#4a4a5a;
  }
  :root.day {
    --gold:#a87a3a; --gold-light:#7a5520; --gold-dim:rgba(168,122,58,0.1); --gold-fg:#fff;
    --bg:#f4f0e8; --bg2:#ede8de; --bg3:#e5dfd3; --bg4:#ddd7c9;
    --text:#1a1714; --text-m:#6b6258; --text-d:#a09890;
    --border:rgba(168,122,58,0.14); --border-h:rgba(168,122,58,0.35);
  }

  html,body { height:100%; background:var(--bg); color:var(--text); font-family:"Jost",sans-serif; font-weight:300; overflow:hidden; transition:background .5s,color .5s; }
  .shell { display:flex; height:100vh; overflow:hidden; }

  /* SIDEBAR */
  .sidebar { width:var(--sidebar-w); flex-shrink:0; background:var(--bg2); border-right:1px solid var(--border); display:flex; flex-direction:column; transition:background .5s,border-color .5s,transform .35s cubic-bezier(.4,0,.2,1); z-index:200; }
  .sidebar-top { display:flex; align-items:center; gap:12px; padding:20px 20px 16px; border-bottom:1px solid var(--border); }
  .brand-mark { width:32px; height:32px; flex-shrink:0; border:1px solid var(--gold); display:flex; align-items:center; justify-content:center; }
  .brand-mark svg { width:14px; height:14px; color:var(--gold); }
  .brand-info { flex:1; min-width:0; }
  .brand-name { display:block; font-family:"Cormorant Garamond",serif; font-size:14px; font-weight:400; color:var(--text); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .brand-name em { font-style:italic; color:var(--gold-light); }
  .brand-role { font-size:9px; letter-spacing:.25em; text-transform:uppercase; color:var(--text-d); }
  .sidebar-close { display:none; background:transparent; border:none; color:var(--text-m); cursor:pointer; padding:4px; }
  .sidebar-close svg { width:16px; height:16px; }
  .nav { flex:1; padding:16px 12px; display:flex; flex-direction:column; gap:4px; overflow-y:auto; }
  .nav-item { display:flex; align-items:center; gap:12px; padding:10px 12px; background:transparent; border:1px solid transparent; color:var(--text-m); font-family:"Jost",sans-serif; font-size:11px; font-weight:400; letter-spacing:.12em; text-transform:uppercase; cursor:pointer; transition:all .22s; text-align:left; }
  .nav-item svg { width:15px; height:15px; flex-shrink:0; }
  .nav-item:hover { color:var(--text); border-color:var(--border); background:var(--bg3); }
  .nav-item.active { color:var(--gold); border-color:var(--gold-dim); background:var(--gold-dim); }
  .sidebar-footer { padding:14px 16px; border-top:1px solid var(--border); display:flex; align-items:center; gap:10px; }
  .user-chip { display:flex; align-items:center; gap:10px; flex:1; min-width:0; }
  .user-avatar { width:28px; height:28px; flex-shrink:0; background:var(--gold-dim); border:1px solid var(--gold); display:flex; align-items:center; justify-content:center; font-size:11px; font-weight:500; color:var(--gold); }
  .user-info { min-width:0; }
  .user-name { display:block; font-size:11px; font-weight:400; color:var(--text); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .user-dept { font-size:9px; letter-spacing:.2em; text-transform:uppercase; color:var(--text-d); }
  .btn-logout { background:transparent; border:1px solid var(--border); padding:7px; cursor:pointer; color:var(--text-m); transition:all .25s; flex-shrink:0; }
  .btn-logout svg { width:14px; height:14px; display:block; }
  .btn-logout:hover { border-color:var(--red); color:var(--red); }

  /* MAIN */
  .main { flex:1; display:flex; flex-direction:column; overflow:hidden; min-width:0; }
  .topbar { display:flex; align-items:center; justify-content:space-between; padding:0 24px; height:56px; flex-shrink:0; background:var(--bg2); border-bottom:1px solid var(--border); transition:background .5s,border-color .5s; }
  .topbar-left { display:flex; align-items:center; gap:16px; }
  .menu-btn { display:none; background:transparent; border:none; color:var(--text-m); cursor:pointer; padding:4px; }
  .menu-btn svg { width:18px; height:18px; }
  .section-label { font-family:"Cormorant Garamond",serif; font-size:18px; font-weight:400; color:var(--text); }
  .topbar-date { font-size:10px; letter-spacing:.18em; color:var(--text-d); margin-left:4px; }
  .topbar-right { display:flex; align-items:center; gap:16px; }
  .theme-toggle-top { display:flex; align-items:center; cursor:pointer; padding:6px; border:1px solid var(--border); transition:border-color .25s; }
  .theme-toggle-top:hover { border-color:var(--border-h); }
  .theme-toggle-top svg { width:14px; height:14px; color:var(--text-m); transition:opacity .3s,transform .4s; }
  :root .t-sun { opacity:0; transform:rotate(90deg); position:absolute; }
  :root .t-moon { opacity:1; }
  :root.day .t-sun { opacity:1; transform:rotate(0deg); position:relative; }
  :root.day .t-moon { opacity:0; transform:rotate(-90deg); position:absolute; }
  .topbar-clock { font-size:11px; letter-spacing:.14em; color:var(--text-m); font-variant-numeric:tabular-nums; }
  .notif-dot { width:6px; height:6px; border-radius:50%; background:var(--gold); box-shadow:0 0 8px rgba(201,169,110,.5); }

  /* SECTIONS */
  .section { display:none; flex:1; overflow-y:auto; padding:24px; gap:20px; flex-direction:column; }
  .section.active { display:flex; }

  /* CARDS */
  .chart-card { background:var(--bg3); border:1px solid var(--border); padding:20px; animation:cardIn .5s ease calc(var(--i,0)*.07s) both; transition:background .5s,border-color .5s; }
  @keyframes cardIn { from { opacity:0; transform:translateY(16px); } to { opacity:1; transform:translateY(0); } }
  .chart-header { display:flex; align-items:baseline; justify-content:space-between; margin-bottom:20px; }
  .chart-title { font-family:"Cormorant Garamond",serif; font-size:16px; font-weight:400; color:var(--text); }
  .chart-sub { font-size:9px; letter-spacing:.2em; text-transform:uppercase; color:var(--text-d); }

  /* KPI */
  .kpi-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:16px; }
  .kpi-card { background:var(--bg3); border:1px solid var(--border); padding:20px; display:flex; flex-direction:column; gap:8px; animation:cardIn .5s ease calc(var(--i)*.07s) both; transition:background .5s,border-color .5s; }
  .kpi-top { display:flex; align-items:center; justify-content:space-between; }
  .kpi-top svg { width:16px; height:16px; color:var(--gold); opacity:.7; }
  .kpi-label { font-size:9px; letter-spacing:.25em; text-transform:uppercase; color:var(--text-d); }
  .kpi-value { font-family:"Cormorant Garamond",serif; font-size:32px; font-weight:400; color:var(--text); line-height:1; }
  .kpi-value small { font-size:18px; color:var(--text-m); }
  .kpi-trend { display:flex; align-items:center; gap:4px; font-size:10px; letter-spacing:.06em; }
  .kpi-trend svg { width:12px; height:12px; }
  .kpi-trend.up { color:var(--green); } .kpi-trend.down { color:var(--red); }
  .kpi-bar { height:2px; background:var(--bg4); margin-top:4px; }
  .kpi-fill { height:100%; background:var(--gold); transition:width 1s cubic-bezier(.4,0,.2,1); }
  .kpi-fill.accent2 { background:var(--red); }

  /* CHARTS */
  .charts-row { display:grid; grid-template-columns:1fr 340px; gap:16px; }
  .bar-chart { display:flex; align-items:flex-end; gap:8px; height:120px; }
  .bar-col { flex:1; display:flex; flex-direction:column; align-items:center; height:100%; justify-content:flex-end; }
  .bar-fill { width:100%; background:var(--gold); opacity:.8; transition:height .8s cubic-bezier(.4,0,.2,1); position:relative; cursor:pointer; }
  .bar-fill:hover { opacity:1; }
  .bar-fill::after { content:attr(data-val); position:absolute; bottom:100%; left:50%; transform:translateX(-50%); font-size:9px; color:var(--text-m); white-space:nowrap; padding-bottom:3px; opacity:0; transition:opacity .2s; }
  .bar-fill:hover::after { opacity:1; }
  .bar-fill.egreso { background:var(--red); opacity:.6; }
  .bar-labels { display:flex; gap:8px; margin-top:8px; }
  .bar-lbl { flex:1; text-align:center; font-size:9px; letter-spacing:.12em; color:var(--text-d); text-transform:uppercase; }
  .dual-bar-chart { display:flex; align-items:flex-end; gap:6px; height:120px; }
  .dual-group { flex:1; display:flex; align-items:flex-end; gap:2px; height:100%; justify-content:center; }
  .dual-legend { display:flex; gap:16px; margin-top:8px; }
  .dl-item { display:flex; align-items:center; gap:6px; font-size:9px; color:var(--text-d); letter-spacing:.1em; text-transform:uppercase; }
  .dl-dot { width:8px; height:8px; border-radius:1px; }
  .donut-wrap { position:relative; width:120px; height:120px; margin:0 auto 16px; }
  .donut { width:120px; height:120px; }
  .donut-center { position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; }
  .donut-pct { font-family:"Cormorant Garamond",serif; font-size:22px; font-weight:400; color:var(--text); }
  .donut-lbl { font-size:8px; letter-spacing:.18em; text-transform:uppercase; color:var(--text-d); }
  .donut-legend { display:flex; flex-direction:column; gap:8px; }
  .legend-item { display:flex; align-items:center; gap:8px; }
  .legend-dot { width:8px; height:8px; flex-shrink:0; }
  .legend-label { font-size:10px; color:var(--text-m); flex:1; }
  .legend-pct { font-size:10px; color:var(--text); font-weight:400; }
  .bottom-row { display:grid; grid-template-columns:320px 1fr; gap:16px; }
  .rooms-grid { display:grid; grid-template-columns:repeat(20,1fr); gap:2px; margin-bottom:12px; }
  .room-dot { aspect-ratio:1; border-radius:1px; cursor:pointer; transition:transform .15s; }
  .room-dot:hover { transform:scale(1.4); }
  .room-dot.occupied { background:var(--gold); } .room-dot.free { background:var(--green); opacity:.7; }
  .room-dot.maintenance { background:var(--red); opacity:.8; } .room-dot.reserved { background:var(--blue); opacity:.8; }
  .rooms-legend { display:flex; flex-wrap:wrap; gap:10px 16px; }
  .rl-item { display:flex; align-items:center; gap:5px; font-size:9px; letter-spacing:.14em; text-transform:uppercase; color:var(--text-d); }
  .rl-dot { width:7px; height:7px; border-radius:1px; }
  .rl-dot.occupied { background:var(--gold); } .rl-dot.free { background:var(--green); }
  .rl-dot.maintenance { background:var(--red); } .rl-dot.reserved { background:var(--blue); }
  .activity-list { display:flex; flex-direction:column; }
  .act-item { display:grid; grid-template-columns:8px 1fr auto auto; align-items:center; gap:10px; padding:8px 0; border-bottom:1px solid var(--border); transition:background .15s; }
  .act-item:last-child { border-bottom:none; }
  .act-item:hover { background:var(--bg4); margin:0 -8px; padding:8px 8px; }
  .act-icon { width:6px; height:6px; border-radius:50%; flex-shrink:0; }
  .act-icon.ci { background:var(--gold); box-shadow:0 0 5px rgba(201,169,110,.4); }
  .act-icon.co { background:var(--blue); box-shadow:0 0 5px rgba(107,140,255,.4); }
  .act-icon.pay { background:var(--green); box-shadow:0 0 5px rgba(76,175,130,.4); }
  .act-icon.mnt { background:var(--red); box-shadow:0 0 5px rgba(224,85,85,.4); }
  .act-desc { font-size:11px; font-weight:400; color:var(--text); line-height:1.2; }
  .act-desc small { display:block; font-size:9px; font-weight:300; color:var(--text-d); letter-spacing:.08em; margin-top:1px; }
  .act-amount { font-family:"Cormorant Garamond",serif; font-size:13px; font-weight:400; text-align:right; }
  .act-amount.pos { color:var(--green); } .act-amount.neg { color:var(--red); }
  .act-time { font-size:9px; letter-spacing:.08em; color:var(--text-d); white-space:nowrap; text-align:right; }

  /* FINANZAS */
  .fin-kpi-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:16px; }
  .fin-kpi { background:var(--bg3); border:1px solid var(--border); padding:18px; display:flex; flex-direction:column; gap:6px; animation:cardIn .5s ease calc(var(--i)*.07s) both; }
  .fk-label { font-size:9px; letter-spacing:.25em; text-transform:uppercase; color:var(--text-d); }
  .fk-val { font-family:"Cormorant Garamond",serif; font-size:26px; font-weight:400; color:var(--text); }
  .fk-sub { font-size:9px; letter-spacing:.1em; }
  .badge-up { color:var(--green); } .badge-dn { color:var(--red); }
  .expense-list { display:flex; flex-direction:column; gap:12px; }
  .exp-item { display:flex; flex-direction:column; gap:4px; }
  .exp-top { display:flex; justify-content:space-between; font-size:11px; color:var(--text-m); }
  .exp-top span:last-child { color:var(--text); font-weight:400; }
  .exp-bar-bg { height:2px; background:var(--bg4); }
  .exp-bar-fill { height:100%; transition:width .8s cubic-bezier(.4,0,.2,1); }

  /* TABLES */
  .table-wrap { overflow-x:auto; }
  .data-table { width:100%; border-collapse:collapse; font-size:11px; }
  .data-table th { text-align:left; padding:8px 12px; font-size:9px; letter-spacing:.2em; text-transform:uppercase; color:var(--text-d); border-bottom:1px solid var(--border); font-weight:400; white-space:nowrap; }
  .data-table td { padding:10px 12px; border-bottom:1px solid var(--border); color:var(--text-m); vertical-align:middle; }
  .data-table tr:last-child td { border-bottom:none; }
  .data-table tr:hover td { background:var(--bg4); }
  .badge { display:inline-block; padding:2px 8px; font-size:9px; letter-spacing:.12em; text-transform:uppercase; border:1px solid; }
  .badge-libre { color:var(--green); border-color:rgba(76,175,130,.3); background:rgba(76,175,130,.08); }
  .badge-ocupada { color:var(--gold); border-color:rgba(201,169,110,.3); background:rgba(201,169,110,.08); }
  .badge-mant { color:var(--red); border-color:rgba(224,85,85,.3); background:rgba(224,85,85,.08); }
  .badge-reservada { color:var(--blue); border-color:rgba(107,140,255,.3); background:rgba(107,140,255,.08); }
  .badge-confirmada { color:var(--green); border-color:rgba(76,175,130,.3); background:rgba(76,175,130,.08); }
  .badge-pendiente { color:var(--gold); border-color:rgba(201,169,110,.3); background:rgba(201,169,110,.08); }
  .badge-checkin { color:var(--blue); border-color:rgba(107,140,255,.3); background:rgba(107,140,255,.08); }
  .badge-checkout { color:var(--text-m); border-color:var(--border); background:transparent; }
  .badge-cancelada { color:var(--red); border-color:rgba(224,85,85,.3); background:rgba(224,85,85,.08); }
  .badge-activo { color:var(--green); border-color:rgba(76,175,130,.3); background:rgba(76,175,130,.08); }
  .badge-inactivo { color:var(--text-d); border-color:var(--border); background:transparent; }
  .badge-vacaciones { color:var(--blue); border-color:rgba(107,140,255,.3); background:rgba(107,140,255,.08); }
  .badge-baja { color:var(--red); border-color:rgba(224,85,85,.3); background:rgba(224,85,85,.08); }
  .tbl-btn { background:transparent; border:1px solid var(--border); padding:4px 8px; font-size:9px; letter-spacing:.1em; text-transform:uppercase; color:var(--text-d); cursor:pointer; transition:all .2s; font-family:"Jost",sans-serif; }
  .tbl-btn:hover { border-color:var(--gold); color:var(--gold); }
  .tbl-btn.danger:hover { border-color:var(--red); color:var(--red); }

  /* TOOLBAR */
  .hab-toolbar { display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap; flex-shrink:0; }
  .hab-filters { display:flex; gap:6px; flex-wrap:wrap; }
  .filter-btn { background:transparent; border:1px solid var(--border); padding:6px 12px; font-size:9px; letter-spacing:.15em; text-transform:uppercase; color:var(--text-d); cursor:pointer; transition:all .2s; font-family:"Jost",sans-serif; display:flex; align-items:center; gap:6px; }
  .filter-btn:hover { border-color:var(--border-h); color:var(--text-m); }
  .filter-btn.active { border-color:var(--gold); color:var(--gold); background:var(--gold-dim); }
  .fcount { font-size:9px; color:inherit; opacity:.7; }

  /* VIEW TOGGLE */
  .view-toggle { display:flex; border:1px solid var(--border); }
  .view-btn { display:flex; align-items:center; gap:6px; background:transparent; border:none; padding:6px 12px; font-family:"Jost",sans-serif; font-size:9px; letter-spacing:.14em; text-transform:uppercase; color:var(--text-d); cursor:pointer; transition:all .2s; border-right:1px solid var(--border); }
  .view-btn:last-child { border-right:none; }
  .view-btn:hover { color:var(--text-m); background:var(--bg3); }
  .view-btn.active { color:var(--gold); background:var(--gold-dim); }

  /* PLAN LEYENDA */
  .plan-legend { display:flex; flex-wrap:wrap; gap:10px 18px; margin-bottom:14px; padding:12px 16px; background:var(--bg3); border:1px solid var(--border); flex-shrink:0; }
  .pl-item { display:flex; align-items:center; gap:7px; font-size:9px; letter-spacing:.1em; color:var(--text-m); }
  .pl-dot { width:8px; height:8px; border-radius:2px; flex-shrink:0; }

  /* SEARCH */
  .search-wrap { position:relative; display:flex; align-items:center; }
  .search-wrap svg { position:absolute; left:10px; width:13px; height:13px; color:var(--text-d); }
  .search-input { background:var(--bg3); border:1px solid var(--border); padding:8px 12px 8px 32px; font-family:"Jost",sans-serif; font-size:11px; color:var(--text); outline:none; transition:border-color .25s; min-width:220px; }
  .search-input::placeholder { color:var(--text-d); }
  .search-input:focus { border-color:var(--gold); }

  /* BUTTONS */
  .btn-primary { background:transparent; border:1px solid var(--gold); color:var(--gold); padding:8px 16px; font-family:"Jost",sans-serif; font-size:10px; letter-spacing:.2em; text-transform:uppercase; cursor:pointer; transition:all .25s; position:relative; overflow:hidden; }
  .btn-primary::before { content:""; position:absolute; inset:0; background:var(--gold); transform:translateX(-100%); transition:transform .3s; z-index:0; }
  .btn-primary:hover::before { transform:translateX(0); }
  .btn-primary:hover { color:var(--gold-fg); }
  .btn-primary span,.btn-primary { position:relative; z-index:1; }
  .btn-ghost { background:transparent; border:1px solid var(--border); color:var(--text-m); padding:8px 16px; font-family:"Jost",sans-serif; font-size:10px; letter-spacing:.2em; text-transform:uppercase; cursor:pointer; transition:all .25s; }
  .btn-ghost:hover { border-color:var(--border-h); color:var(--text); }

  /* USUARIOS */
  .usr-layout { display:grid; grid-template-columns:380px 1fr; gap:20px; align-items:start; }
  .usr-form-card,.usr-list-card { background:var(--bg3); border:1px solid var(--border); padding:20px; animation:cardIn .5s ease calc(var(--i,0)*.07s) both; }
  .usr-form { display:flex; flex-direction:column; gap:16px; }
  .uf-row { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
  .uf-field { display:flex; flex-direction:column; gap:6px; }
  .uf-label { font-size:9px; letter-spacing:.25em; text-transform:uppercase; color:var(--text-d); }
  .uf-input { background:transparent; border:none; border-bottom:1px solid var(--border); padding:8px 0; font-family:"Jost",sans-serif; font-size:12px; color:var(--text); outline:none; caret-color:var(--gold); transition:border-color .25s; width:100%; }
  .uf-input:focus { border-bottom-color:var(--gold); }
  .uf-input::placeholder { color:var(--text-d); font-size:11px; }
  .uf-select { cursor:pointer; appearance:none; background:transparent; }
  .uf-actions { display:flex; gap:8px; justify-content:flex-end; margin-top:4px; }
  .uf-msg { font-size:10px; letter-spacing:.08em; min-height:16px; text-align:center; }
  .uf-msg.ok { color:var(--green); } .uf-msg.err { color:var(--red); }
  .user-cards { display:flex; flex-direction:column; gap:8px; max-height:520px; overflow-y:auto; }
  .user-card { display:grid; grid-template-columns:32px 1fr auto; gap:12px; align-items:center; padding:12px; border:1px solid var(--border); background:var(--bg4); transition:border-color .2s; }
  .user-card:hover { border-color:var(--border-h); }
  .uc-avatar { width:32px; height:32px; background:var(--gold-dim); border:1px solid var(--gold); display:flex; align-items:center; justify-content:center; font-size:12px; font-weight:500; color:var(--gold); flex-shrink:0; }
  .uc-info { min-width:0; }
  .uc-name { font-size:12px; font-weight:400; color:var(--text); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .uc-meta { display:flex; align-items:center; gap:8px; margin-top:3px; flex-wrap:wrap; }
  .uc-role { font-size:9px; letter-spacing:.15em; text-transform:uppercase; color:var(--gold); opacity:.8; }
  .uc-jornada { font-size:9px; color:var(--text-d); letter-spacing:.08em; }
  .uc-actions { display:flex; gap:4px; flex-shrink:0; }
  .uc-btn { background:transparent; border:1px solid var(--border); width:26px; height:26px; display:flex; align-items:center; justify-content:center; cursor:pointer; color:var(--text-d); transition:all .2s; }
  .uc-btn svg { width:11px; height:11px; }
  .uc-btn:hover { border-color:var(--gold); color:var(--gold); }
  .uc-btn.del:hover { border-color:var(--red); color:var(--red); }

  /* MODAL */
  .modal-backdrop { position:fixed; inset:0; z-index:500; background:rgba(0,0,0,.7); backdrop-filter:blur(4px); display:none; align-items:center; justify-content:center; padding:20px; }
  .modal-backdrop.open { display:flex; }
  .modal { background:var(--bg2); border:1px solid var(--border); width:100%; max-width:520px; animation:cardIn .3s ease both; }
  .modal-header { display:flex; align-items:center; justify-content:space-between; padding:16px 20px; border-bottom:1px solid var(--border); }
  .modal-title { font-family:"Cormorant Garamond",serif; font-size:18px; font-weight:400; color:var(--text); }
  .modal-close { background:transparent; border:none; color:var(--text-m); cursor:pointer; padding:4px; }
  .modal-close svg { width:16px; height:16px; }
  .modal-body { padding:20px; font-size:12px; color:var(--text-m); line-height:1.7; max-height:60vh; overflow-y:auto; }
  .modal-body .detail-grid { display:grid; grid-template-columns:1fr 1fr; gap:12px 20px; margin-top:8px; }
  .detail-item { display:flex; flex-direction:column; gap:3px; }
  .detail-label { font-size:9px; letter-spacing:.2em; text-transform:uppercase; color:var(--text-d); }
  .detail-val { font-size:12px; color:var(--text); }
  .modal-footer { display:flex; justify-content:flex-end; gap:8px; padding:14px 20px; border-top:1px solid var(--border); }

  /* OVERLAY */
  .sidebar-overlay { display:none; position:fixed; inset:0; z-index:150; background:rgba(0,0,0,.6); backdrop-filter:blur(2px); }

  /* STATUS SELECT en modal */
  .status-select { background:var(--bg4); border:1px solid var(--border); padding:7px 10px; font-family:"Jost",sans-serif; font-size:11px; color:var(--text); outline:none; cursor:pointer; width:100%; transition:border-color .25s; }
  .status-select:focus { border-color:var(--gold); }

  /* RESPONSIVE */
  @media (max-width:1200px) { .usr-layout { grid-template-columns:1fr; } .fin-kpi-grid { grid-template-columns:repeat(2,1fr); } }
  @media (max-width:1100px) { .kpi-grid { grid-template-columns:repeat(2,1fr); } .charts-row { grid-template-columns:1fr; } .bottom-row { grid-template-columns:1fr; } }
  @media (max-width:768px) {
    :root { --sidebar-w:260px; }
    .sidebar { position:fixed; top:0; left:0; bottom:0; transform:translateX(-100%); }
    .sidebar.open { transform:translateX(0); }
    .sidebar-close { display:flex!important; }
    .sidebar-overlay.open { display:block; }
    .menu-btn { display:flex!important; }
    .topbar { padding:0 16px; } .section { padding:16px; }
    .kpi-grid { grid-template-columns:repeat(2,1fr); gap:12px; }
    .kpi-value { font-size:26px; } .topbar-clock { display:none; }
    .hab-toolbar { flex-direction:column; align-items:flex-start; }
    .usr-layout { grid-template-columns:1fr; } .uf-row { grid-template-columns:1fr; }
  }
  @media (max-width:480px) { .kpi-grid { grid-template-columns:1fr 1fr; gap:10px; } .kpi-card { padding:14px; } .fin-kpi-grid { grid-template-columns:1fr 1fr; } .chart-card { padding:14px; } .bar-chart { height:80px; } .section-label { font-size:15px; } .rooms-grid { grid-template-columns:repeat(15,1fr); } }
  @media (max-width:360px) { .kpi-grid { grid-template-columns:1fr; } }
</style>

<script>
  // @ts-nocheck
  const API = "http://localhost:3000";
  if (!sessionStorage.getItem("hotel_token")) window.location.replace("/logIn");
  const storedUser = sessionStorage.getItem("hotel_fullname") || sessionStorage.getItem("hotel_user") || "Admin";
  const storedRole = sessionStorage.getItem("hotel_role") || "admin";
  if (storedRole !== "admin") window.location.replace("/" + storedRole + "/dashboard");
  const avatarEl = document.getElementById("userAvatar");
  const sidebarUserEl = document.getElementById("sidebarUser");
  if (avatarEl) avatarEl.textContent = storedUser.charAt(0).toUpperCase();
  if (sidebarUserEl) sidebarUserEl.textContent = storedUser;

  // ── API HELPER ──────────────────────────────────────────────────
  async function apiFetch(method, path, body = null) {
    const token = sessionStorage.getItem("hotel_token");
    const headers = { "Content-Type": "application/json" };
    if (token) headers["Authorization"] = "Bearer " + token;
    const options = { method, headers };
    if (body) options.body = JSON.stringify(body);
    try {
      const res = await fetch(API + path, options);
      if (res.status === 401) { sessionStorage.clear(); window.location.replace("/logIn"); return null; }
      return res.json();
    } catch (e) { console.error("[API Error]", path, e); return null; }
  }
  function fmtMoney(n) { return "$" + Number(n || 0).toLocaleString("es-MX", { minimumFractionDigits: 0 }); }
  function fmtRelTime(iso) {
    const d = Date.now() - new Date(iso).getTime(), m = Math.floor(d / 60000);
    if (m < 1) return "ahora"; if (m < 60) return "hace " + m + "m";
    const h = Math.floor(m / 60); if (h < 24) return "hace " + h + "h";
    return "hace " + Math.floor(h / 24) + "d";
  }
  function showToast(msg, tipo = "success") {
    const c = { success:"var(--green)", warning:"var(--amber,#f0a500)", error:"var(--red)", info:"var(--blue)" };
    const t = document.createElement("div");
    t.style.cssText = "position:fixed;bottom:24px;right:24px;z-index:9999;background:var(--bg3);border:1px solid " + c[tipo] + ";border-left:4px solid " + c[tipo] + ";color:var(--text);padding:12px 20px;font-family:Jost,sans-serif;font-size:12px;box-shadow:0 8px 32px rgba(0,0,0,.4)";
    t.textContent = msg; document.body.appendChild(t);
    setTimeout(() => t.remove(), 3500);
  }

  // ── TEMA ────────────────────────────────────────────────────────
  const root = document.documentElement;
  let manualOverride = false, currentTheme = "night";
  function getAutoTheme() { const h = new Date().getHours(); return h >= 6 && h < 18 ? "day" : "night"; }
  function applyTheme(t) { currentTheme = t; t === "day" ? root.classList.add("day") : root.classList.remove("day"); }
  document.getElementById("themeToggleTop")?.addEventListener("click", () => { manualOverride = true; applyTheme(currentTheme === "day" ? "night" : "day"); setTimeout(() => { manualOverride = false; }, 7200000); });
  applyTheme(getAutoTheme());

  // RELOJ
  const clockEl = document.getElementById("topbarClock"), dateEl = document.getElementById("topbarDate");
  function tick() {
    const now = new Date(), h = String(now.getHours()).padStart(2,"0"), m = String(now.getMinutes()).padStart(2,"0"), s = String(now.getSeconds()).padStart(2,"0");
    if (clockEl) clockEl.textContent = h + ":" + m + ":" + s;
    const dias = ["Dom","Lun","Mar","Mié","Jue","Vie","Sáb"], meses = ["Ene","Feb","Mar","Abr","May","Jun","Jul","Ago","Sep","Oct","Nov","Dic"];
    if (dateEl) dateEl.textContent = dias[now.getDay()] + " " + now.getDate() + " " + meses[now.getMonth()];
    if (!manualOverride && getAutoTheme() !== currentTheme) applyTheme(getAutoTheme());
  }
  tick(); setInterval(tick, 1000);

  // ── NAVEGACIÓN ──────────────────────────────────────────────────
  const navItems = document.querySelectorAll(".nav-item"), sections = document.querySelectorAll(".section");
  const sectionLabel = document.getElementById("sectionLabel");
  const labels = { overview:"Resumen General", finanzas:"Finanzas", habitaciones:"Habitaciones", reservaciones:"Reservaciones", huespedes:"Huéspedes", usuarios:"Gestión de Usuarios" };
  navItems.forEach(btn => {
    btn.addEventListener("click", () => {
      const sec = btn.getAttribute("data-section") || "overview";
      navItems.forEach(b => b.classList.remove("active")); btn.classList.add("active");
      sections.forEach(s => s.classList.remove("active")); document.getElementById("sec-" + sec)?.classList.add("active");
      if (sectionLabel) sectionLabel.textContent = labels[sec] || sec;
      if (window.innerWidth < 768) closeSidebar();
    });
  });
  const sidebar = document.getElementById("sidebar"), overlay = document.getElementById("sidebarOverlay");
  function openSidebar() { sidebar?.classList.add("open"); overlay?.classList.add("open"); document.body.style.overflow = "hidden"; }
  function closeSidebar() { sidebar?.classList.remove("open"); overlay?.classList.remove("open"); document.body.style.overflow = ""; }
  document.getElementById("menuBtn")?.addEventListener("click", openSidebar);
  document.getElementById("sidebarClose")?.addEventListener("click", closeSidebar);
  overlay?.addEventListener("click", closeSidebar);
  document.getElementById("btnLogout")?.addEventListener("click", () => { sessionStorage.clear(); window.location.replace("/logIn"); });

  // ── MODAL ────────────────────────────────────────────────────────
  const backdrop = document.getElementById("modalBackdrop");
  function openModal(title, body, confirmCb) {
    const mt = document.getElementById("modalTitle"), mb = document.getElementById("modalBody"), mc = document.getElementById("modalConfirm");
    if (mt) mt.textContent = title;
    if (mb) mb.innerHTML = body;
    if (mc) {
      if (confirmCb) {
        mc.style.display = "";
        const nc = mc.cloneNode(true);
        mc.parentNode?.replaceChild(nc, mc);
        nc.addEventListener("click", () => { confirmCb(); closeModal(); });
      } else { mc.style.display = "none"; }
    }
    backdrop?.classList.add("open");
  }
  function closeModal() { backdrop?.classList.remove("open"); }
  document.getElementById("modalClose")?.addEventListener("click", closeModal);
  document.getElementById("modalCancel")?.addEventListener("click", closeModal);
  backdrop?.addEventListener("click", e => { if (e.target === backdrop) closeModal(); });

  // ── HABITACIONES — VISTA TOGGLE ──────────────────────────────────
  let habView = "list";   // "plan" | "list"
  const statusLabels = { "ocupada":"Ocupada","libre-limpia":"Libre · Limpia","libre-sucia":"Libre · Sucia","reservada":"Reservada hoy","checkout":"Check-out hoy","mantenimiento":"Mantenimiento","bloqueada":"Bloqueada" };
  const statusColors = { "ocupada":"var(--status-ocupada,#c9a96e)","libre-limpia":"var(--status-libre-limpia,#4caf82)","libre-sucia":"var(--status-libre-sucia,#f0a500)","reservada":"var(--status-reservada,#6b8cff)","checkout":"var(--status-checkout,#3ec9c9)","mantenimiento":"var(--status-mantenimiento,#e05555)","bloqueada":"var(--status-bloqueada,#4a4a5a)" };

  window.setHabView = (v) => {
    habView = v;
    const planEl = document.getElementById("habViewPlan");
    const listEl = document.getElementById("habViewList");
    const btnPlan = document.getElementById("btnViewPlan");
    const btnList = document.getElementById("btnViewList");
    const filtersEl = document.getElementById("habFilters");
    if (v === "plan") {
      if (planEl) planEl.style.display = "flex";
      if (listEl) listEl.style.display = "none";
      btnPlan?.classList.add("active"); btnList?.classList.remove("active");
      // Filtros de estado no aplican al plano (el plano los muestra todos con color)
      if (filtersEl) filtersEl.style.opacity = "0.35";
      // Refrescar el plano
      adminDistWrap?.refresh();
    } else {
      if (planEl) planEl.style.display = "none";
      if (listEl) listEl.style.display = "block";
      btnList?.classList.add("active"); btnPlan?.classList.remove("active");
      if (filtersEl) filtersEl.style.opacity = "1";
    }
  };

  // ── COMPONENTE DISTRIBUCION (admin) ──────────────────────────────
  // El mismo patrón que en recepción: escuchar el evento dist-room-click
  const adminDistWrap = document.querySelector(".dist-wrap");

  // Búsqueda en el plano de admin
  document.getElementById("planSearch")?.addEventListener("input", e => {
    adminDistWrap?.filterRooms(e.target.value);
  });

  // Click en habitación del plano → abrir modal de edición completo (con más opciones que recepción)
  adminDistWrap?.addEventListener("dist-room-click", e => {
    openHabModalFromPlan(e.detail);
  });

  // Modal de habitación desde el plano — igual de completo que editHab pero con datos del evento
  function openHabModalFromPlan(r) {
    const stLabel = statusLabels[r.status] || r.status || "—";
    const stColor = statusColors[r.status] || "var(--text)";
    const statusOpts = [
      { val:"ocupada",        lbl:"Ocupada" },
      { val:"libre-limpia",   lbl:"Libre limpia" },
      { val:"libre-sucia",    lbl:"Libre sucia" },
      { val:"reservada",      lbl:"Reservada hoy" },
      { val:"checkout",       lbl:"Check-out hoy" },
      { val:"maintenance",    lbl:"Mantenimiento" },
      { val:"blocked",        lbl:"Bloqueada" },
    ];
    // Mapear status del componente al de la API
    const apiStatusMap = { "ocupada":"occupied","libre-limpia":"free_clean","libre-sucia":"free_dirty","reservada":"reserved","checkout":"checkout","mantenimiento":"maintenance","bloqueada":"blocked" };
    const currentApiStatus = apiStatusMap[r.status] || r.status;
    const opts = statusOpts.map(o => `<option value="${o.val}"${r.status === o.val || currentApiStatus === o.val ? " selected" : ""}>${o.lbl}</option>`).join("");

    openModal(
      "Habitación " + r.num,
      `<div class="detail-grid" style="margin-bottom:16px">
        <div class="detail-item"><span class="detail-label">Número</span><span class="detail-val">${r.num}</span></div>
        <div class="detail-item"><span class="detail-label">Tipo</span><span class="detail-val">${r.tipo || "—"}</span></div>
        <div class="detail-item"><span class="detail-label">Piso</span><span class="detail-val">${r.piso || "—"}°</span></div>
        <div class="detail-item"><span class="detail-label">Estado actual</span><span class="detail-val" style="color:${stColor}">${stLabel}</span></div>
        ${r.guest ? `<div class="detail-item"><span class="detail-label">Huésped</span><span class="detail-val">${r.guest}</span></div>` : ""}
        ${r.checkIn ? `<div class="detail-item"><span class="detail-label">Check-in</span><span class="detail-val">${r.checkIn}</span></div>` : ""}
        ${r.checkOut ? `<div class="detail-item"><span class="detail-label">Check-out</span><span class="detail-val">${r.checkOut}</span></div>` : ""}
        ${r.capacidad ? `<div class="detail-item"><span class="detail-label">Capacidad</span><span class="detail-val">${r.capacidad} pax</span></div>` : ""}
      </div>
      <div style="display:flex;flex-direction:column;gap:14px">
        <div class="uf-field">
          <label class="uf-label" style="margin-bottom:8px">Cambiar estado</label>
          <div style="position:relative">
            <span id="planModalDot" style="position:absolute;left:10px;top:50%;transform:translateY(-50%);width:8px;height:8px;border-radius:50%;background:${stColor}"></span>
            <select class="status-select" id="planModalStatus" style="padding-left:26px"
              onchange="(function(s){const m={'ocupada':'var(--status-ocupada,#c9a96e)','libre-limpia':'var(--status-libre-limpia,#4caf82)','libre-sucia':'var(--status-libre-sucia,#f0a500)','reservada':'var(--status-reservada,#6b8cff)','checkout':'var(--status-checkout,#3ec9c9)','maintenance':'var(--status-mantenimiento,#e05555)','mantenimiento':'var(--status-mantenimiento,#e05555)','blocked':'var(--status-bloqueada,#4a4a5a)','bloqueada':'var(--status-bloqueada,#4a4a5a)'};const d=document.getElementById('planModalDot');if(d)d.style.background=m[s.value]||'var(--text-d)'})(this)">
              ${opts}
            </select>
          </div>
        </div>
        <div class="uf-field">
          <label class="uf-label" style="margin-bottom:6px">Notas internas</label>
          <input class="status-select" id="planModalNotes" placeholder="Observaciones (opcional)…" value="${r.notas || ""}" style="font-size:11px" />
        </div>
      </div>`,
      async () => {
        const sel   = document.getElementById("planModalStatus");
        const notes = document.getElementById("planModalNotes");
        if (!sel) return;
        // Convertir status UI al formato de la API
        const uiToApi = { "ocupada":"occupied","libre-limpia":"free_clean","libre-sucia":"free_dirty","reservada":"reserved","checkout":"checkout","maintenance":"maintenance","mantenimiento":"maintenance","blocked":"blocked","bloqueada":"blocked" };
        const apiStatus = uiToApi[sel.value] || sel.value;
        const payload = { status: apiStatus };
        if (notes?.value.trim()) payload.notes = notes.value.trim();
        const res = await apiFetch("PATCH", "/api/rooms/" + r.num + "/status", payload);
        if (res !== null) {
          showToast("Habitación " + r.num + " actualizada ✓");
          adminDistWrap?.refresh();
          loadHabitaciones();
          loadRoomsGrid();
          loadKpis();
        } else { showToast("Error al actualizar", "error"); }
      },
    );
    const mc = document.getElementById("modalConfirm");
    if (mc) mc.textContent = "Guardar cambios";
  }

  // ── HABITACIONES — tabla (igual que antes) ────────────────────────
  let habDataAPI = [];
  const badgeHab = { occupied:"badge-ocupada",free_clean:"badge-libre",free_dirty:"badge-libre",maintenance:"badge-mant",reserved:"badge-reservada",checkout:"badge-checkin",blocked:"badge-mant" };
  const habEstadoLabel = { occupied:"ocupada",free_clean:"libre",free_dirty:"libre-sucia",maintenance:"mantenimiento",reserved:"reservada",checkout:"checkout",blocked:"bloqueada" };

  async function loadHabitaciones() {
    const data = await apiFetch("GET", "/api/rooms");
    if (!data) return;
    habDataAPI = data;
    renderHab();
    // Actualizar conteos en filtros
    const counts = {};
    data.forEach(h => { const lbl = habEstadoLabel[h.status] || h.status; counts[lbl] = (counts[lbl] || 0) + 1; });
    const total = data.length;
    const setFc = (id, val) => { const el = document.getElementById(id); if (el) el.textContent = val; };
    setFc("fc-todas", total);
    setFc("fc-libre", (counts["libre"] || 0) + (counts["libre-sucia"] || 0));
    setFc("fc-ocupada", counts["ocupada"] || 0);
    setFc("fc-mantenimiento", counts["mantenimiento"] || 0);
    setFc("fc-reservada", counts["reservada"] || 0);
    // Si estamos en vista plano, refrescar el componente también
    if (habView === "plan") adminDistWrap?.refresh();
  }

  function renderHab(filter = "todas") {
    const body = document.getElementById("habBody");
    if (!body) return;
    body.innerHTML = "";
    habDataAPI.filter(h => filter === "todas" || habEstadoLabel[h.status] === filter || h.status === filter)
      .forEach(h => {
        const estado = habEstadoLabel[h.status] || h.status;
        const tr = document.createElement("tr");
        tr.innerHTML = `<td style="color:var(--text);font-weight:400">${h.number}</td><td>${h.type || "—"}</td><td>${h.floor || "—"}°</td><td>${h.capacity || "—"} pax</td><td style="color:var(--gold);font-family:'Cormorant Garamond',serif;font-size:14px">${fmtMoney(h.ratePerNight)}</td><td><span class="badge ${badgeHab[h.status] || ""}">${estado}</span></td><td>${h.currentGuest || "—"}</td><td><button class="tbl-btn" onclick="verHab(${h.number})">Ver</button> <button class="tbl-btn" onclick="editHab(${h.number})">Editar</button></td>`;
        body.appendChild(tr);
      });
  }

  document.querySelectorAll("[data-filter]").forEach(btn => {
    btn.addEventListener("click", () => {
      document.querySelectorAll("[data-filter]").forEach(b => b.classList.remove("active"));
      btn.classList.add("active");
      renderHab(btn.getAttribute("data-filter") || "todas");
    });
  });

  window.verHab = (num) => {
    const h = habDataAPI.find(x => x.number === num); if (!h) return;
    const estado = habEstadoLabel[h.status] || h.status;
    openModal("Habitación " + h.number, `<div class="detail-grid"><div class="detail-item"><span class="detail-label">Tipo</span><span class="detail-val">${h.type || "—"}</span></div><div class="detail-item"><span class="detail-label">Piso</span><span class="detail-val">${h.floor || "—"}°</span></div><div class="detail-item"><span class="detail-label">Capacidad</span><span class="detail-val">${h.capacity || "—"} personas</span></div><div class="detail-item"><span class="detail-label">Tarifa/noche</span><span class="detail-val">${fmtMoney(h.ratePerNight)}</span></div><div class="detail-item"><span class="detail-label">Estado</span><span class="detail-val">${estado}</span></div><div class="detail-item"><span class="detail-label">Huésped actual</span><span class="detail-val">${h.currentGuest || "—"}</span></div></div>`);
  };

  window.editHab = (num) => {
    const h = habDataAPI.find(x => x.number === num); if (!h) return;
    const statusOpts = [{ val:"free_clean",lbl:"Libre limpia"},{ val:"free_dirty",lbl:"Libre sucia"},{ val:"occupied",lbl:"Ocupada"},{ val:"maintenance",lbl:"Mantenimiento"},{ val:"reserved",lbl:"Reservada"},{ val:"blocked",lbl:"Bloqueada"}];
    const opts = statusOpts.map(o => `<option value="${o.val}"${h.status === o.val ? " selected" : ""}>${o.lbl}</option>`).join("");
    openModal("Editar habitación " + num, `<div style="display:flex;flex-direction:column;gap:16px"><div class="detail-item"><span class="detail-label">Estado actual</span><span class="detail-val" style="color:var(--gold)">${habEstadoLabel[h.status] || h.status}</span></div><div class="uf-field"><label class="uf-label">Nuevo estado</label><select class="status-select" id="editHabStatus">${opts}</select></div><div class="uf-field"><label class="uf-label">Notas (opcional)</label><input class="status-select" id="editHabNotes" placeholder="Ej. Cambio de sábanas..." /></div></div>`,
      async () => {
        const newStatus = document.getElementById("editHabStatus").value;
        const notes = document.getElementById("editHabNotes").value;
        const res = await apiFetch("PATCH", "/api/rooms/" + num + "/status", { status: newStatus, notes });
        if (res !== null) { showToast("Habitación " + num + " actualizada"); loadHabitaciones(); loadRoomsGrid(); loadKpis(); }
        else showToast("Error al actualizar", "error");
      });
    const mc = document.getElementById("modalConfirm"); if (mc) mc.textContent = "Guardar cambios";
  };

  // ── RESERVACIONES ───────────────────────────────────────────────
  let resDataAPI = [];
  const badgeRes = { pending:"badge-pendiente",confirmed:"badge-confirmada",checked_in:"badge-checkin",checked_out:"badge-checkout",cancelled:"badge-cancelada",no_show:"badge-cancelada" };
  const resEstadoLabel = { pending:"pendiente",confirmed:"confirmada",checked_in:"checkin",checked_out:"checkout",cancelled:"cancelada",no_show:"no_show" };

  async function loadReservaciones() {
    const data = await apiFetch("GET", "/api/reservations"); if (!data) return;
    resDataAPI = data; renderRes();
  }
  function renderRes(filter = "todas") {
    const body = document.getElementById("resBody"); if (!body) return;
    body.innerHTML = "";
    resDataAPI.filter(r => filter === "todas" || (resEstadoLabel[r.status] || r.status) === filter)
      .forEach(r => {
        const estado = resEstadoLabel[r.status] || r.status;
        const noches = r.checkInDate && r.checkOutDate ? Math.ceil((new Date(r.checkOutDate) - new Date(r.checkInDate)) / 86400000) : "—";
        const tr = document.createElement("tr");
        tr.innerHTML = `<td style="color:var(--text-d);font-size:10px">${r.code || r.id?.slice(0,8)}</td><td style="color:var(--text)">${r.guestName || "—"}</td><td>Hab. ${r.roomNumber || "—"}</td><td>${r.checkInDate || "—"}</td><td>${r.checkOutDate || "—"}</td><td>${noches}</td><td style="color:var(--gold);font-family:'Cormorant Garamond',serif;font-size:14px">${fmtMoney(r.totalAmount)}</td><td><span class="badge ${badgeRes[r.status] || ""}">${estado}</span></td><td><button class="tbl-btn" onclick="verRes('${r.id}')">Ver</button></td>`;
        body.appendChild(tr);
      });
  }
  document.querySelectorAll("[data-rfilter]").forEach(btn => {
    btn.addEventListener("click", () => { document.querySelectorAll("[data-rfilter]").forEach(b => b.classList.remove("active")); btn.classList.add("active"); renderRes(btn.getAttribute("data-rfilter") || "todas"); });
  });
  window.verRes = (id) => {
    const r = resDataAPI.find(x => x.id === id); if (!r) return;
    openModal("Reservación " + (r.code || id), `<div class="detail-grid"><div class="detail-item"><span class="detail-label">Huésped</span><span class="detail-val">${r.guestName || "—"}</span></div><div class="detail-item"><span class="detail-label">Habitación</span><span class="detail-val">Hab. ${r.roomNumber || "—"}</span></div><div class="detail-item"><span class="detail-label">Entrada</span><span class="detail-val">${r.checkInDate || "—"}</span></div><div class="detail-item"><span class="detail-label">Salida</span><span class="detail-val">${r.checkOutDate || "—"}</span></div><div class="detail-item"><span class="detail-label">Total</span><span class="detail-val" style="color:var(--gold)">${fmtMoney(r.totalAmount)}</span></div><div class="detail-item"><span class="detail-label">Estado</span><span class="detail-val">${resEstadoLabel[r.status] || r.status}</span></div></div>`);
  };

  // ── HUÉSPEDES ────────────────────────────────────────────────────
  let guestDataAPI = [];
  async function loadGuests(search = "") {
    const data = await apiFetch("GET", "/api/guests" + (search ? "?search=" + encodeURIComponent(search) : "")); if (!data) return;
    guestDataAPI = data; renderGuests("", guestDataAPI);
  }
  function renderGuests(filter = "", data = guestDataAPI) {
    const body = document.getElementById("guestBody"); if (!body) return;
    body.innerHTML = "";
    const filtered = filter ? data.filter(g => ((g.firstName || "") + " " + (g.lastName || "")).toLowerCase().includes(filter.toLowerCase()) || (g.email || "").toLowerCase().includes(filter.toLowerCase())) : data;
    filtered.forEach(g => {
      const nombre = (g.firstName || "") + " " + (g.lastName || "");
      const tr = document.createElement("tr");
      tr.innerHTML = `<td style="color:var(--text)">${nombre}</td><td>${g.email || "—"}</td><td>${g.phone || "—"}</td><td>${g.totalStays || 0}</td><td>${g.updatedAt ? g.updatedAt.slice(0,10) : "—"}</td><td style="color:var(--gold);font-family:'Cormorant Garamond',serif;font-size:14px">${fmtMoney(g.totalSpent)}</td><td><span class="badge badge-${(g.status || "active") === "active" ? "confirmada" : "cancelada"}">${(g.status || "active") === "active" ? "activo" : "inactivo"}</span></td><td><button class="tbl-btn" onclick="verGuest('${g.id}')">Ver</button></td>`;
      body.appendChild(tr);
    });
  }
  document.getElementById("guestSearch")?.addEventListener("input", e => { const v = e.target.value; if (v.length > 2) loadGuests(v); else loadGuests(); });
  window.verGuest = (id) => {
    const g = guestDataAPI.find(x => x.id === id); if (!g) return;
    const nombre = (g.firstName || "") + " " + (g.lastName || "");
    openModal(nombre, `<div class="detail-grid"><div class="detail-item"><span class="detail-label">Email</span><span class="detail-val">${g.email || "—"}</span></div><div class="detail-item"><span class="detail-label">Teléfono</span><span class="detail-val">${g.phone || "—"}</span></div><div class="detail-item"><span class="detail-label">Estancias</span><span class="detail-val">${g.totalStays || 0}</span></div><div class="detail-item"><span class="detail-label">Gasto total</span><span class="detail-val" style="color:var(--gold)">${fmtMoney(g.totalSpent)}</span></div><div class="detail-item"><span class="detail-label">Nacionalidad</span><span class="detail-val">${g.nationality || "—"}</span></div></div>`);
  };

  // ── USUARIOS ────────────────────────────────────────────────────
  let usuariosAPI = [], editingId = null;
  const jornadaLabel = { matutino:"Matutino 06–14h", vespertino:"Vespertino 14–22h", nocturno:"Nocturno 22–06h", completo:"Tiempo completo" };
  async function loadUsuarios() {
    const data = await apiFetch("GET", "/api/users"); if (!data) return;
    usuariosAPI = data; renderUsers();
  }
  function renderUsers() {
    const container = document.getElementById("userCards"), cnt = document.getElementById("userCount");
    if (!container) return;
    if (cnt) cnt.textContent = usuariosAPI.length + " usuario" + (usuariosAPI.length !== 1 ? "s" : "");
    container.innerHTML = "";
    usuariosAPI.forEach(u => {
      const nombre = u.fullName || u.nombre || u.username || "—";
      const username = u.username || u.user || "—";
      const rol = u.role || u.rol || "—";
      const jornada = u.shift || u.jornada || "completo";
      const status = u.status || (u.isActive !== false ? "activo" : "inactivo");
      const badgeCls = (status === "activo" || status === "active") ? "badge-confirmada" : "badge-cancelada";
      const card = document.createElement("div"); card.className = "user-card";
      card.innerHTML = `<div class="uc-avatar">${nombre.charAt(0).toUpperCase()}</div><div class="uc-info"><div class="uc-name">${nombre} <span style="color:var(--text-d);font-size:10px">(${username})</span></div><div class="uc-meta"><span class="uc-role">${rol}</span><span class="uc-jornada">· ${jornadaLabel[jornada] || jornada}</span><span class="badge ${badgeCls}" style="font-size:8px;padding:1px 6px">${status}</span></div></div><div class="uc-actions"><button class="uc-btn" title="Editar" onclick="editUser('${u.id}')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg></button><button class="uc-btn del" title="Eliminar" onclick="deleteUser('${u.id}')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/><path d="M10 11v6M14 11v6"/></svg></button></div>`;
      container.appendChild(card);
    });
  }
  document.getElementById("userForm")?.addEventListener("submit", async e => {
    e.preventDefault();
    const nombre = document.getElementById("uf-nombre").value.trim();
    const user   = document.getElementById("uf-user").value.trim();
    const pass   = document.getElementById("uf-pass").value;
    const rol    = document.getElementById("uf-rol").value;
    const jornada = document.getElementById("uf-jornada").value;
    const status  = document.getElementById("uf-status").value;
    const msg    = document.getElementById("ufMsg");
    if (!nombre || !user) { if (msg) { msg.textContent = "Nombre y usuario son requeridos."; msg.className = "uf-msg err"; } return; }
    if (editingId === null && !pass) { if (msg) { msg.textContent = "La contraseña es requerida."; msg.className = "uf-msg err"; } return; }
    let res;
    if (editingId !== null) {
      const body = { fullName: nombre, role: rol, shift: jornada, status }; if (pass) body.password = pass;
      res = await apiFetch("PATCH", "/api/users/" + editingId, body);
    } else {
      res = await apiFetch("POST", "/api/users", { fullName: nombre, username: user, password: pass, role: rol, shift: jornada, status });
    }
    if (res && !res.error) {
      const accion = editingId !== null ? "actualizado" : "creado";
      resetUserForm(); await loadUsuarios();
      if (msg) { msg.textContent = "Usuario " + accion + " correctamente."; msg.className = "uf-msg ok"; setTimeout(() => { msg.textContent = ""; }, 3000); }
    } else { if (msg) { msg.textContent = res?.error || "Error al guardar el usuario."; msg.className = "uf-msg err"; } }
  });
  function resetUserForm() {
    editingId = null;
    ["uf-nombre","uf-user","uf-pass"].forEach(id => { const el = document.getElementById(id); if (el) el.value = ""; });
    document.getElementById("uf-rol").value = "recepcion";
    document.getElementById("uf-jornada").value = "matutino";
    document.getElementById("uf-status").value = "activo";
    const lbl = document.getElementById("formModeLabel"); if (lbl) lbl.textContent = "Nuevo";
    const btn = document.getElementById("btnSaveUser"); if (btn) btn.textContent = "Guardar usuario";
  }
  document.getElementById("btnCancelEdit")?.addEventListener("click", resetUserForm);
  window.editUser = (id) => {
    const u = usuariosAPI.find(x => String(x.id) === String(id)); if (!u) return;
    editingId = String(id);
    document.getElementById("uf-nombre").value = u.fullName || u.nombre || "";
    document.getElementById("uf-user").value = u.username || u.user || "";
    document.getElementById("uf-pass").value = "";
    document.getElementById("uf-rol").value = u.role || u.rol || "recepcion";
    document.getElementById("uf-jornada").value = u.shift || u.jornada || "matutino";
    document.getElementById("uf-status").value = u.status || "activo";
    const lbl = document.getElementById("formModeLabel"); if (lbl) lbl.textContent = "Editando";
    const btn = document.getElementById("btnSaveUser"); if (btn) btn.textContent = "Actualizar usuario";
    document.querySelector(".usr-form-card")?.scrollIntoView({ behavior:"smooth", block:"start" });
  };
  window.deleteUser = (id) => {
    const u = usuariosAPI.find(x => String(x.id) === String(id)); if (!u) return;
    const nombre = u.fullName || u.nombre || u.username;
    openModal("Eliminar usuario", `<p>¿Estás seguro de eliminar a <strong style="color:var(--text)">${nombre}</strong>? Esta acción no se puede deshacer.</p>`,
      async () => { const res = await apiFetch("DELETE", "/api/users/" + id); if (res !== null) { showToast("Usuario eliminado"); loadUsuarios(); } else showToast("Error al eliminar el usuario", "error"); });
    const mc = document.getElementById("modalConfirm"); if (mc) { mc.style.display = ""; mc.textContent = "Eliminar"; mc.style.borderColor = "var(--red)"; mc.style.color = "var(--red)"; }
  };

  // ── KPIs REALES ─────────────────────────────────────────────────
  async function loadKpis() {
    const [roomStats, txKpis, todayRes] = await Promise.all([
      apiFetch("GET", "/api/rooms/stats"),
      apiFetch("GET", "/api/transactions/kpis"),
      apiFetch("GET", "/api/reservations/today"),
    ]);
    if (txKpis) {
      const ki = document.getElementById("kpi-ingresos"); if (ki) ki.textContent = fmtMoney(txKpis.totalIncome);
      const kg = document.getElementById("kpi-gastos");   if (kg) kg.textContent = fmtMoney(txKpis.totalExpense);
    }
    if (roomStats) {
      const ko = document.getElementById("kpi-ocupacion"); if (ko) ko.innerHTML = (roomStats.occupancyPct || 0) + "<small>%</small>";
      const kb = document.getElementById("kpi-ocupacion-bar"); if (kb) kb.style.width = (roomStats.occupancyPct || 0) + "%";
      const rt = document.getElementById("roomsTotal"); if (rt) rt.textContent = (roomStats.total || "—") + " totales";
    }
    if (todayRes) {
      const kr = document.getElementById("kpi-reservaciones");
      if (kr) kr.textContent = String((todayRes.checkins || []).length + (todayRes.checkouts || []).length);
    }
  }

  // ── RESUMEN — gráficas ───────────────────────────────────────────
  const barData = [{ mes:"Sep",val:210000 },{ mes:"Oct",val:195000 },{ mes:"Nov",val:230000 },{ mes:"Dic",val:310000 },{ mes:"Ene",val:265000 },{ mes:"Feb",val:248000 },{ mes:"Mar",val:284500 }];
  const maxVal = Math.max(...barData.map(d => d.val));
  const barChart = document.getElementById("barChart"), barLabels = document.getElementById("barLabels");
  if (barChart && barLabels) {
    barData.forEach(d => {
      const col = document.createElement("div"); col.className = "bar-col";
      const fill = document.createElement("div"); fill.className = "bar-fill"; fill.style.height = "0"; fill.setAttribute("data-val","$"+(d.val/1000).toFixed(0)+"k");
      col.appendChild(fill); barChart.appendChild(col);
      setTimeout(() => { fill.style.height = (d.val/maxVal)*100+"%"; }, 150);
      const lbl = document.createElement("div"); lbl.className = "bar-lbl"; lbl.textContent = d.mes; barLabels.appendChild(lbl);
    });
  }
  const donutData = [{ label:"Hospedaje",pct:78,color:"#C9A96E" },{ label:"Restaurante",pct:12,color:"#4CAF82" },{ label:"Spa & Eventos",pct:6,color:"#6B8CFF" },{ label:"Otros",pct:4,color:"#E05555" }];
  const donutSvg = document.getElementById("donutChart"), legend = document.getElementById("donutLegend");
  if (donutSvg) {
    const r=45,cx=60,cy=60,stroke=14,circ=2*Math.PI*r; let offset=0;
    donutData.forEach(d => {
      const dash=(d.pct/100)*circ; const circle=document.createElementNS("http://www.w3.org/2000/svg","circle");
      circle.setAttribute("cx",String(cx)); circle.setAttribute("cy",String(cy)); circle.setAttribute("r",String(r)); circle.setAttribute("fill","none"); circle.setAttribute("stroke",d.color); circle.setAttribute("stroke-width",String(stroke)); circle.setAttribute("stroke-dasharray",dash+" "+(circ-dash)); circle.setAttribute("stroke-dashoffset",String(-(offset/100)*circ+circ/4));
      donutSvg.appendChild(circle); offset+=d.pct;
    });
  }
  if (legend) { donutData.forEach(d => { const item=document.createElement("div"); item.className="legend-item"; item.innerHTML=`<div class="legend-dot" style="background:${d.color}"></div><span class="legend-label">${d.label}</span><span class="legend-pct">${d.pct}%</span>`; legend.appendChild(item); }); }

  async function loadRoomsGrid() {
    const roomsGrid = document.getElementById("roomsGrid"); if (!roomsGrid) return;
    const data = await apiFetch("GET", "/api/rooms"); if (!data) return;
    roomsGrid.innerHTML = "";
    const stMap = { occupied:"occupied",free_clean:"free",free_dirty:"free",reserved:"reserved",checkout:"free",maintenance:"maintenance",blocked:"maintenance" };
    data.forEach(r => { const dot=document.createElement("div"); dot.className="room-dot "+(stMap[r.status]||"free"); dot.title="Hab. "+r.number+" · "+r.status; roomsGrid.appendChild(dot); });
  }

  async function loadActivity() {
    const actList = document.getElementById("activityList"); if (!actList) return;
    const data = await apiFetch("GET", "/api/transactions?"); if (!data || !data.length) return;
    actList.innerHTML = "";
    data.slice(0,6).forEach(t => {
      const isPos = t.type === "income";
      const item = document.createElement("div"); item.className = "act-item";
      item.innerHTML = '<div class="act-icon '+(isPos?"pay":"mnt")+'"></div><div class="act-desc">'+t.concept+"<small>"+t.category+'</small></div><span class="act-amount '+(isPos?"pos":"neg")+'">'+(isPos?"+":"-")+fmtMoney(t.amount)+'</span><span class="act-time">'+fmtRelTime(t.createdAt)+"</span>";
      actList.appendChild(item);
    });
  }

  const dualData = [{ mes:"Oct",ing:195000,egr:65000 },{ mes:"Nov",ing:230000,egr:72000 },{ mes:"Dic",ing:310000,egr:88000 },{ mes:"Ene",ing:265000,egr:70000 },{ mes:"Feb",ing:248000,egr:68000 },{ mes:"Mar",ing:284500,egr:67200 }];
  const maxDual = Math.max(...dualData.flatMap(d => [d.ing,d.egr]));
  const dualBarChart = document.getElementById("dualBarChart"), dualLabels = document.getElementById("dualLabels");
  if (dualBarChart && dualLabels) {
    dualData.forEach(d => {
      const grp=document.createElement("div"); grp.className="dual-group";
      const f1=document.createElement("div"); f1.className="bar-fill"; f1.style.height="0"; f1.setAttribute("data-val","$"+(d.ing/1000).toFixed(0)+"k"); f1.style.flex="1";
      const f2=document.createElement("div"); f2.className="bar-fill egreso"; f2.style.height="0"; f2.setAttribute("data-val","$"+(d.egr/1000).toFixed(0)+"k"); f2.style.flex="1";
      grp.appendChild(f1); grp.appendChild(f2); dualBarChart.appendChild(grp);
      setTimeout(() => { f1.style.height=(d.ing/maxDual)*100+"%"; f2.style.height=(d.egr/maxDual)*100+"%"; }, 150);
      const lbl=document.createElement("div"); lbl.className="bar-lbl"; lbl.textContent=d.mes; dualLabels.appendChild(lbl);
    });
  }
  const expenses = [{ label:"Nómina",pct:48,color:"#C9A96E",val:"$30,450" },{ label:"Suministros",pct:22,color:"#4CAF82",val:"$13,980" },{ label:"Mantenimiento",pct:15,color:"#6B8CFF",val:"$9,530" },{ label:"Marketing",pct:9,color:"#E2C99A",val:"$5,720" },{ label:"Otros",pct:6,color:"#E05555",val:"$3,520" }];
  const expList = document.getElementById("expenseList");
  if (expList) { expenses.forEach(e => { const item=document.createElement("div"); item.className="exp-item"; item.innerHTML=`<div class="exp-top"><span>${e.label}</span><span>${e.val}</span></div><div class="exp-bar-bg"><div class="exp-bar-fill" style="width:0;background:${e.color}"></div></div>`; expList.appendChild(item); setTimeout(() => { const fill=item.querySelector(".exp-bar-fill"); if(fill) fill.style.width=e.pct+"%"; }, 200); }); }

  async function loadFinanzasTx() {
    const txBody = document.getElementById("txBody"); if (!txBody) return;
    const data = await apiFetch("GET", "/api/transactions"); if (!data || !data.length) return;
    txBody.innerHTML = "";
    data.slice(0,10).forEach(t => {
      const tr=document.createElement("tr"); const isPos=t.type==="income"; const fecha=t.createdAt?t.createdAt.slice(0,10):"—"; const estado=t.status==="confirmed"?"confirmada":"pendiente";
      tr.innerHTML=`<td>${fecha}</td><td style="color:var(--text)">${t.concept||t.description||"—"}</td><td>${t.category||"—"}</td><td>${t.paymentMethod||"—"}</td><td style="color:${isPos?"var(--green)":"var(--red)"};font-family:'Cormorant Garamond',serif;font-size:13px">${isPos?"+":"-"}${fmtMoney(t.amount)}</td><td><span class="badge badge-${estado}">${estado}</span></td>`;
      txBody.appendChild(tr);
