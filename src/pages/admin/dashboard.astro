    ).value.trim();
    const user = (
      document.getElementById("uf-user") as HTMLInputElement
    ).value.trim();
    const pass = (document.getElementById("uf-pass") as HTMLInputElement).value;
    const rol = (document.getElementById("uf-rol") as HTMLSelectElement).value;
