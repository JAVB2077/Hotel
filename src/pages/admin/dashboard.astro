  }

  // ── NUEVA HABITACIÓN ──────────────────────────────────────────────
  document.getElementById("btnNuevaHab")?.addEventListener("click", () => {
    const statusOpts = [{ val:"free_clean",lbl:"Libre limpia" },{ val:"free_dirty",lbl:"Libre sucia" },{ val:"maintenance",lbl:"Mantenimiento" },{ val:"blocked",lbl:"Bloqueada" }];
    const opts = statusOpts.map(o => `<option value="${o.val}">${o.lbl}</option>`).join("");
    openModal("Nueva habitación", `<div style="display:flex;flex-direction:column;gap:14px"><div class="uf-row"><div class="uf-field"><label class="uf-label">Número</label><input class="status-select" id="nh-num" type="number" placeholder="101" /></div><div class="uf-field"><label class="uf-label">Piso</label><input class="status-select" id="nh-piso" type="number" placeholder="1" /></div></div><div class="uf-row"><div class="uf-field"><label class="uf-label">Tipo</label><input class="status-select" id="nh-tipo" placeholder="Doble, Suite, Master..." /></div><div class="uf-field"><label class="uf-label">Capacidad (pax)</label><input class="status-select" id="nh-cap" type="number" placeholder="2" /></div></div><div class="uf-row"><div class="uf-field"><label class="uf-label">Tarifa/noche ($)</label><input class="status-select" id="nh-tarifa" type="number" placeholder="1200" /></div><div class="uf-field"><label class="uf-label">Estado inicial</label><select class="status-select" id="nh-status">${opts}</select></div></div></div>`,
      async () => {
        const num=Number(document.getElementById("nh-num").value); const floor=Number(document.getElementById("nh-piso").value); const type=document.getElementById("nh-tipo").value.trim(); const cap=Number(document.getElementById("nh-cap").value); const rate=Number(document.getElementById("nh-tarifa").value); const status=document.getElementById("nh-status").value;
        if (!num||!type) { showToast("Número y tipo son requeridos","error"); return; }
        const res=await apiFetch("POST","/api/rooms",{ number:num,floor,type,capacity:cap,ratePerNight:rate,status });
        if (res&&!res.error) { showToast("Habitación "+num+" creada"); loadHabitaciones(); loadRoomsGrid(); loadKpis(); adminDistWrap?.refresh(); }
        else showToast(res?.error||"Error al crear la habitación","error");
      });
    const mc=document.getElementById("modalConfirm"); if(mc) mc.textContent="Crear habitación";
  });

  // ── NUEVA RESERVACIÓN ─────────────────────────────────────────────
  document.getElementById("btnNuevaRes")?.addEventListener("click", async () => {
    const rooms = await apiFetch("GET", "/api/rooms");
    const freeRooms=(rooms||[]).filter(r=>r.status==="free_clean"||r.status==="free_dirty"||r.status==="reserved");
    const roomOpts=freeRooms.length?freeRooms.map(r=>`<option value="${r.number}">Hab. ${r.number} · ${r.type} · ${fmtMoney(r.ratePerNight)}/noche</option>`).join(""):"<option value=''>Sin habitaciones disponibles</option>";
    openModal("Nueva reservación", `<div style="display:flex;flex-direction:column;gap:14px"><div class="uf-row"><div class="uf-field"><label class="uf-label">Nombre del huésped</label><input class="status-select" id="nr-nombre" placeholder="Nombre completo" /></div><div class="uf-field"><label class="uf-label">Email</label><input class="status-select" id="nr-email" type="email" placeholder="email@ejemplo.com" /></div></div><div class="uf-field"><label class="uf-label">Habitación</label><select class="status-select" id="nr-room">${roomOpts}</select></div><div class="uf-row"><div class="uf-field"><label class="uf-label">Check-in</label><input class="status-select" id="nr-ci" type="date" /></div><div class="uf-field"><label class="uf-label">Check-out</label><input class="status-select" id="nr-co" type="date" /></div></div><div class="uf-field"><label class="uf-label">Solicitudes especiales</label><input class="status-select" id="nr-notes" placeholder="Opcional" /></div></div>`,
      async () => {
        const nombre=document.getElementById("nr-nombre").value.trim(); const email=document.getElementById("nr-email").value.trim(); const roomNum=document.getElementById("nr-room").value; const checkIn=document.getElementById("nr-ci").value; const checkOut=document.getElementById("nr-co").value; const notes=document.getElementById("nr-notes").value;
        if (!nombre||!roomNum||!checkIn||!checkOut) { showToast("Completa todos los campos requeridos","error"); return; }
        const res=await apiFetch("POST","/api/reservations",{ guestName:nombre,guestEmail:email,roomNumber:Number(roomNum),checkInDate:checkIn,checkOutDate:checkOut,specialRequests:notes });
        if (res&&!res.error) { showToast("Reservación creada"); loadReservaciones(); loadKpis(); }
        else showToast(res?.error||"Error al crear la reservación","error");
      });
    const mc=document.getElementById("modalConfirm"); if(mc) mc.textContent="Crear reservación";
  });

  // ── NUEVO HUÉSPED ─────────────────────────────────────────────────
  document.getElementById("btnNuevoHuésped")?.addEventListener("click", () => {
    openModal("Nuevo huésped", `<div style="display:flex;flex-direction:column;gap:14px"><div class="uf-row"><div class="uf-field"><label class="uf-label">Nombre</label><input class="status-select" id="ng-fname" placeholder="María" /></div><div class="uf-field"><label class="uf-label">Apellido</label><input class="status-select" id="ng-lname" placeholder="García" /></div></div><div class="uf-row"><div class="uf-field"><label class="uf-label">Email</label><input class="status-select" id="ng-email" type="email" placeholder="maria@email.com" /></div><div class="uf-field"><label class="uf-label">Teléfono</label><input class="status-select" id="ng-phone" placeholder="+52 55 1234 5678" /></div></div><div class="uf-field"><label class="uf-label">Nacionalidad</label><input class="status-select" id="ng-nat" placeholder="Mexicana" /></div></div>`,
      async () => {
        const firstName=document.getElementById("ng-fname").value.trim(); const lastName=document.getElementById("ng-lname").value.trim(); const email=document.getElementById("ng-email").value.trim(); const phone=document.getElementById("ng-phone").value.trim(); const nationality=document.getElementById("ng-nat").value.trim();
        if (!firstName||!lastName) { showToast("Nombre y apellido son requeridos","error"); return; }
        const res=await apiFetch("POST","/api/guests",{ firstName,lastName,email,phone,nationality });
        if (res&&!res.error) { showToast("Huésped registrado"); loadGuests(); }
        else showToast(res?.error||"Error al registrar el huésped","error");
      });
    const mc=document.getElementById("modalConfirm"); if(mc) mc.textContent="Registrar";
  });

  // ── WEBSOCKET ─────────────────────────────────────────────────────
  let wsConnected=false, wsPolling=null, wsPing=null;
  function startWsPolling() {
    if (wsPolling) return;
    wsPolling=setInterval(async () => { if (wsConnected) return; await loadHabitaciones(); await loadKpis(); }, 30000);
  }
  function conectarWS() {
    const role=sessionStorage.getItem("hotel_role")||"admin", token=sessionStorage.getItem("hotel_token")||"", wsUrl=API.replace("http","ws");
    let ws;
    try { ws=new WebSocket(wsUrl+"/live?role="+role+"&token="+token); }
    catch { wsConnected=false; startWsPolling(); setTimeout(conectarWS,5000); return; }
    ws.onopen=()=>{ wsConnected=true; clearInterval(wsPolling); wsPolling=null; clearInterval(wsPing); wsPing=setInterval(()=>ws.readyState===1&&ws.send(JSON.stringify({type:"ping"})),30000); };
    ws.onmessage=({data})=>{ try { const msg=JSON.parse(data); if(msg.type==="pong")return; if(msg.type==="room_status"){ loadHabitaciones(); loadRoomsGrid(); loadKpis(); adminDistWrap?.refresh(); } if(msg.type==="checkin"||msg.type==="checkout"){ loadReservaciones(); loadKpis(); } if(msg.type==="new_reservation"){ loadReservaciones(); loadKpis(); } } catch {} };
    ws.onerror=()=>{ wsConnected=false; startWsPolling(); };
    ws.onclose=()=>{ clearInterval(wsPing); wsConnected=false; startWsPolling(); setTimeout(conectarWS,4000); };
  }

  // ── INICIALIZACIÓN ────────────────────────────────────────────────
  document.addEventListener("DOMContentLoaded", () => {
    loadKpis();
    loadRoomsGrid();
    loadReservaciones();
    loadGuests();
    loadUsuarios();
    loadHabitaciones();
    loadActivity();
    loadFinanzasTx();
    conectarWS();
    startWsPolling();
  });
</script>