---
// src/pages/admin/dashboard.astro
// Solo accesible para admin
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=Jost:wght@200;300;400;500&display=swap"
  rel="stylesheet"
/>

<script is:inline>
  const _r = sessionStorage.getItem("hotel_role");
  const _u = sessionStorage.getItem("hotel_user");
  if (!_u || _r !== "admin") window.location.replace("/logIn");
</script>

<div class="shell">
  <!-- SIDEBAR -->
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-top">
      <div class="brand-mark">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          ><path d="M3 21h18M3 7l9-4 9 4M4 7v14M20 7v14M8 10v4M12 10v4M16 10v4"
          ></path></svg
        >
      </div>
      <div class="brand-info">
        <span class="brand-name">Grand <em>Élite</em></span>
        <span class="brand-role">Administrador</span>
      </div>
      <button class="sidebar-close" id="sidebarClose">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"><path d="M18 6L6 18M6 6l12 12"></path></svg
        >
      </button>
    </div>
    <nav class="nav">
      <button class="nav-item active" data-section="overview">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          ><rect x="3" y="3" width="7" height="7"></rect><rect
            x="14"
            y="3"
            width="7"
            height="7"></rect><rect x="3" y="14" width="7" height="7"
          ></rect><rect x="14" y="14" width="7" height="7"></rect></svg
        >
        <span>Resumen</span>
      </button>
      <button class="nav-item" data-section="finanzas">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          ><path d="M12 2v20M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"
          ></path></svg
        >
        <span>Finanzas</span>
      </button>
      <button class="nav-item" data-section="habitaciones">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          ><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"
          ></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg
        >
        <span>Habitaciones</span>
      </button>
      <button class="nav-item" data-section="reservaciones">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          ><rect x="3" y="4" width="18" height="18" rx="2"></rect><line
            x1="16"
            y1="2"
            x2="16"
            y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line
            x1="3"
            y1="10"
            x2="21"
            y2="10"></line></svg
        >
        <span>Reservaciones</span>
      </button>
      <button class="nav-item" data-section="huespedes">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          ><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"></path><circle
            cx="9"
            cy="7"
            r="4"></circle><path
            d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"></path></svg
        >
        <span>Huéspedes</span>
      </button>
      <button class="nav-item" data-section="usuarios">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          ><circle cx="12" cy="8" r="4"></circle><path
            d="M4 20c0-4 3.6-7 8-7s8 3 8 7"></path><path d="M19 8v6M22 11h-6"
          ></path></svg
        >
        <span>Usuarios</span>
      </button>
    </nav>
    <div class="sidebar-footer">
      <div class="user-chip">
        <div class="user-avatar" id="userAvatar">A</div>
        <div class="user-info">
          <span class="user-name" id="sidebarUser">Admin</span>
          <span class="user-dept">Administración</span>
        </div>
      </div>
      <button class="btn-logout" id="btnLogout" title="Cerrar sesión">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          ><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4M16 17l5-5-5-5M21 12H9"
          ></path></svg
        >
      </button>
    </div>
  </aside>

  <!-- MAIN -->
  <main class="main">
    <header class="topbar">
      <div class="topbar-left">
        <button class="menu-btn" id="menuBtn">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            ><line x1="3" y1="6" x2="21" y2="6"></line><line
              x1="3"
              y1="12"
              x2="21"
              y2="12"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg
          >
        </button>
        <div class="topbar-title">
          <span class="section-label" id="sectionLabel">Resumen General</span>
          <span class="topbar-date" id="topbarDate"></span>
        </div>
      </div>
      <div class="topbar-right">
        <div class="theme-toggle-top" id="themeToggleTop">
          <svg
            class="t-sun"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            ><circle cx="12" cy="12" r="4"></circle><path
              d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
            ></path></svg
          >
          <svg
            class="t-moon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            ><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"></path></svg
          >
        </div>
        <div class="topbar-clock" id="topbarClock"></div>
        <div class="notif-dot"></div>
      </div>
    </header>

    <!-- ══ RESUMEN ══ -->
    <section class="section active" id="sec-overview">
      <div class="kpi-grid">
        <div class="kpi-card" style="--i:0">
          <div class="kpi-top">
            <span class="kpi-label">Ingresos del mes</span><svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              ><path d="M12 2v20M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"
              ></path></svg
            >
          </div>
          <span class="kpi-value">$284,500</span>
          <div class="kpi-trend up">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              ><polyline points="18 15 12 9 6 15"></polyline></svg
            >+12.4% vs mes anterior
          </div>
          <div class="kpi-bar">
            <div class="kpi-fill" style="width:78%"></div>
          </div>
        </div>
        <div class="kpi-card" style="--i:1">
          <div class="kpi-top">
            <span class="kpi-label">Ocupación actual</span><svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              ><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"
              ></path></svg
            >
          </div>
          <span class="kpi-value">94<small>%</small></span>
          <div class="kpi-trend up">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              ><polyline points="18 15 12 9 6 15"></polyline></svg
            >+6% esta semana
          </div>
          <div class="kpi-bar">
            <div class="kpi-fill" style="width:94%"></div>
          </div>
        </div>
        <div class="kpi-card" style="--i:2">
          <div class="kpi-top">
            <span class="kpi-label">Reservaciones hoy</span><svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              ><rect x="3" y="4" width="18" height="18" rx="2"></rect><line
                x1="16"
                y1="2"
                x2="16"
                y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line
                x1="3"
                y1="10"
                x2="21"
                y2="10"></line></svg
            >
          </div>
          <span class="kpi-value">23</span>
          <div class="kpi-trend up">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              ><polyline points="18 15 12 9 6 15"></polyline></svg
            >8 check-in pendientes
          </div>
          <div class="kpi-bar">
            <div class="kpi-fill" style="width:60%"></div>
          </div>
        </div>
        <div class="kpi-card" style="--i:3">
          <div class="kpi-top">
            <span class="kpi-label">Gastos operativos</span><svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              ><path
                d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"
              ></path></svg
            >
          </div>
          <span class="kpi-value">$67,200</span>
          <div class="kpi-trend down">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              ><polyline points="6 9 12 15 18 9"></polyline></svg
            >-3.1% vs mes anterior
          </div>
          <div class="kpi-bar">
            <div class="kpi-fill accent2" style="width:35%"></div>
          </div>
        </div>
      </div>
      <div class="charts-row">
        <div class="chart-card wide" style="--i:4">
          <div class="chart-header">
            <span class="chart-title">Ingresos mensuales</span><span
              class="chart-sub">Últimos 7 meses · MXN</span
            >
          </div>
          <div class="bar-chart" id="barChart"></div>
          <div class="bar-labels" id="barLabels"></div>
        </div>
        <div class="chart-card" style="--i:5">
          <div class="chart-header">
            <span class="chart-title">Distribución</span><span class="chart-sub"
              >Por categoría</span
            >
          </div>
          <div class="donut-wrap">
            <svg class="donut" viewBox="0 0 120 120" id="donutChart"></svg><div
              class="donut-center"
            >
              <span class="donut-pct">78%</span><span class="donut-lbl"
                >Hospedaje</span
              >
            </div>
          </div>
          <div class="donut-legend" id="donutLegend"></div>
        </div>
      </div>
      <div class="bottom-row">
        <div class="chart-card" style="--i:6">
          <div class="chart-header">
            <span class="chart-title">Estado de habitaciones</span><span
              class="chart-sub">248 totales</span
            >
          </div>
          <div class="rooms-grid" id="roomsGrid"></div>
          <div class="rooms-legend">
            <span class="rl-item"
              ><span class="rl-dot occupied"></span>Ocupada</span
            >
            <span class="rl-item"><span class="rl-dot free"></span>Libre</span>
            <span class="rl-item"
              ><span class="rl-dot maintenance"></span>Mantenimiento</span
            >
            <span class="rl-item"
              ><span class="rl-dot reserved"></span>Reservada</span
            >
          </div>
        </div>
        <div class="chart-card wide" style="--i:7">
          <div class="chart-header">
            <span class="chart-title">Actividad reciente</span><span
              class="chart-sub">Últimas transacciones</span
            >
          </div>
          <div class="activity-list" id="activityList"></div>
        </div>
      </div>
    </section>

    <!-- ══ FINANZAS ══ -->
    <section class="section" id="sec-finanzas">
      <div class="fin-kpi-grid">
        <div class="fin-kpi" style="--i:0">
          <span class="fk-label">Ingresos totales</span><span class="fk-val"
            >$1,842,300</span
          ><span class="fk-sub badge-up">+8.2% anual</span>
        </div>
        <div class="fin-kpi" style="--i:1">
          <span class="fk-label">Egresos totales</span><span class="fk-val"
            >$634,800</span
          ><span class="fk-sub badge-dn">+2.1% anual</span>
        </div>
        <div class="fin-kpi" style="--i:2">
          <span class="fk-label">Utilidad neta</span><span class="fk-val"
            >$1,207,500</span
          ><span class="fk-sub badge-up">65.5% margen</span>
        </div>
        <div class="fin-kpi" style="--i:3">
          <span class="fk-label">Cuentas por cobrar</span><span class="fk-val"
            >$48,200</span
          ><span class="fk-sub badge-dn">12 facturas</span>
        </div>
      </div>
      <div class="charts-row">
        <div class="chart-card wide" style="--i:4">
          <div class="chart-header">
            <span class="chart-title">Balance mensual</span><span
              class="chart-sub">Ingresos vs Egresos</span
            >
          </div>
          <div class="dual-bar-chart" id="dualBarChart"></div>
          <div class="bar-labels" id="dualLabels"></div>
          <div class="dual-legend">
            <span class="dl-item"
              ><span class="dl-dot" style="background:var(--gold)"
              ></span>Ingresos</span
            ><span class="dl-item"
              ><span class="dl-dot" style="background:var(--red)"
              ></span>Egresos</span
            >
          </div>
        </div>
        <div class="chart-card" style="--i:5">
          <div class="chart-header">
            <span class="chart-title">Desglose de gastos</span><span
              class="chart-sub">Por categoría</span
            >
          </div>
          <div class="expense-list" id="expenseList"></div>
        </div>
      </div>
      <div class="chart-card" style="--i:6">
        <div class="chart-header">
          <span class="chart-title">Historial de transacciones</span><span
            class="chart-sub">Últimas 10 operaciones</span
          >
        </div>
        <div class="table-wrap">
          <table class="data-table" id="txTable">
            <thead
              ><tr
                ><th>Fecha</th><th>Concepto</th><th>Categoría</th><th>Método</th
                ><th>Monto</th><th>Estado</th></tr
              ></thead
            >
            <tbody id="txBody"></tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ══ HABITACIONES ══ -->
    <section class="section" id="sec-habitaciones">
      <div class="hab-toolbar">
        <div class="hab-filters">
          <button class="filter-btn active" data-filter="todas"
            >Todas <span class="fcount">248</span></button
          >
          <button class="filter-btn" data-filter="libre"
            >Libre <span class="fcount">8</span></button
          >
          <button class="filter-btn" data-filter="ocupada"
            >Ocupada <span class="fcount">233</span></button
          >
          <button class="filter-btn" data-filter="mantenimiento"
            >Mant. <span class="fcount">4</span></button
          >
          <button class="filter-btn" data-filter="reservada"
            >Reservada <span class="fcount">3</span></button
          >
        </div>
        <button class="btn-primary" id="btnNuevaHab">+ Nueva habitación</button>
      </div>
      <div class="chart-card" style="--i:0">
        <div class="table-wrap">
          <table class="data-table" id="habTable">
            <thead
              ><tr
                ><th>N°</th><th>Tipo</th><th>Piso</th><th>Capacidad</th><th
                  >Tarifa/noche</th
                ><th>Estado</th><th>Huésped actual</th><th>Acciones</th></tr
              ></thead
            >
            <tbody id="habBody"></tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ══ RESERVACIONES ══ -->
    <section class="section" id="sec-reservaciones">
      <div class="hab-toolbar">
        <div class="hab-filters">
          <button class="filter-btn active" data-rfilter="todas">Todas</button>
          <button class="filter-btn" data-rfilter="pendiente">Pendiente</button>
          <button class="filter-btn" data-rfilter="confirmada"
            >Confirmada</button
          >
          <button class="filter-btn" data-rfilter="checkin">Check-in</button>
          <button class="filter-btn" data-rfilter="checkout">Check-out</button>
          <button class="filter-btn" data-rfilter="cancelada">Cancelada</button>
        </div>
        <button class="btn-primary" id="btnNuevaRes">+ Nueva reservación</button
        >
      </div>
      <div class="chart-card" style="--i:0">
        <div class="table-wrap">
          <table class="data-table" id="resTable">
            <thead
              ><tr
                ><th>ID</th><th>Huésped</th><th>Habitación</th><th>Entrada</th
                ><th>Salida</th><th>Noches</th><th>Total</th><th>Estado</th><th
                  >Acciones</th
                ></tr
              ></thead
            >
            <tbody id="resBody"></tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ══ HUÉSPEDES ══ -->
    <section class="section" id="sec-huespedes">
      <div class="hab-toolbar">
        <div class="search-wrap">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            ><circle cx="11" cy="11" r="8"></circle><line
              x1="21"
              y1="21"
              x2="16.65"
              y2="16.65"></line></svg
          >
          <input
            class="search-input"
            id="guestSearch"
            placeholder="Buscar huésped…"
          />
        </div>
        <button class="btn-primary" id="btnNuevoHuésped">+ Nuevo huésped</button
        >
      </div>
      <div class="chart-card" style="--i:0">
        <div class="table-wrap">
          <table class="data-table" id="guestTable">
            <thead
              ><tr
                ><th>Nombre</th><th>Email</th><th>Teléfono</th><th>Estancias</th
                ><th>Última visita</th><th>Gasto total</th><th>Estado</th><th
                  >Acciones</th
                ></tr
              ></thead
            >
            <tbody id="guestBody"></tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ══ USUARIOS ══ -->
    <section class="section" id="sec-usuarios">
      <div class="usr-layout">
        <!-- Formulario alta -->
        <div class="usr-form-card" style="--i:0">
          <div class="chart-header">
            <span class="chart-title">Dar de alta usuario</span><span
              class="chart-sub"
              id="formModeLabel">Nuevo</span
            >
          </div>
          <form class="usr-form" id="userForm" novalidate>
            <input type="hidden" id="editUserId" value="" />
            <div class="uf-row">
              <div class="uf-field">
                <label class="uf-label">Nombre completo</label>
                <input
                  class="uf-input"
                  id="uf-nombre"
                  placeholder="Ej. María García"
                />
              </div>
              <div class="uf-field">
                <label class="uf-label">Usuario</label>
                <input
                  class="uf-input"
                  id="uf-user"
                  placeholder="maria.garcia"
                />
              </div>
            </div>
            <div class="uf-row">
              <div class="uf-field">
                <label class="uf-label">Contraseña</label>
                <input
                  class="uf-input"
                  id="uf-pass"
                  type="password"
                  placeholder="••••••••"
                />
              </div>
              <div class="uf-field">
                <label class="uf-label">Rol</label>
                <select class="uf-input uf-select" id="uf-rol">
                  <option value="admin">Admin</option>
                  <option value="recepcion" selected>Recepción</option>
                  <option value="staff">Staff</option>
                </select>
              </div>
            </div>
            <div class="uf-row">
              <div class="uf-field">
                <label class="uf-label">Jornada laboral</label>
                <select class="uf-input uf-select" id="uf-jornada">
                  <option value="matutino">Matutino 06:00–14:00</option>
                  <option value="vespertino">Vespertino 14:00–22:00</option>
                  <option value="nocturno">Nocturno 22:00–06:00</option>
                  <option value="completo">Tiempo completo</option>
                </select>
              </div>
              <div class="uf-field">
                <label class="uf-label">Estado</label>
                <select class="uf-input uf-select" id="uf-status">
                  <option value="activo">Activo</option>
                  <option value="inactivo">Inactivo</option>
                  <option value="vacaciones">Vacaciones</option>
                  <option value="baja">Baja</option>
                </select>
              </div>
            </div>
            <div class="uf-actions">
              <button type="button" class="btn-ghost" id="btnCancelEdit"
                >Cancelar</button
              >
              <button type="submit" class="btn-primary" id="btnSaveUser"
                >Guardar usuario</button
              >
            </div>
            <div class="uf-msg" id="ufMsg"></div>
          </form>
        </div>

        <!-- Lista de usuarios -->
        <div class="usr-list-card" style="--i:1">
          <div class="chart-header">
            <span class="chart-title">Personal registrado</span>
            <span class="chart-sub" id="userCount">0 usuarios</span>
          </div>
          <div class="user-cards" id="userCards"></div>
        </div>
      </div>
    </section>
  </main>
</div>

<div class="sidebar-overlay" id="sidebarOverlay"></div>

<!-- MODAL genérico -->
<div class="modal-backdrop" id="modalBackdrop">
  <div class="modal" id="modal">
    <div class="modal-header">
      <span class="modal-title" id="modalTitle">Detalle</span>
      <button class="modal-close" id="modalClose">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"><path d="M18 6L6 18M6 6l12 12"></path></svg
        >
      </button>
    </div>
    <div class="modal-body" id="modalBody"></div>
    <div class="modal-footer">
      <button class="btn-ghost" id="modalCancel">Cerrar</button>
      <button class="btn-primary" id="modalConfirm" style="display:none"
        >Confirmar</button
      >
    </div>
  </div>
</div>

<style>
  *,
  *::before,
  *::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  :root {
    --gold: #c9a96e;
    --gold-light: #e2c99a;
    --gold-dim: rgba(201, 169, 110, 0.12);
    --gold-fg: #0a0a0b;
    --green: #4caf82;
    --red: #e05555;
    --blue: #6b8cff;
    --bg: #0a0a0b;
    --bg2: #111113;
    --bg3: #18181c;
    --bg4: #1e1e24;
    --text: #e8e4dc;
    --text-m: #8a8680;
    --text-d: #4a4a52;
    --border: rgba(201, 169, 110, 0.1);
    --border-h: rgba(201, 169, 110, 0.28);
    --sidebar-w: 240px;
  }
  :root.day {
    --gold: #a87a3a;
    --gold-light: #7a5520;
    --gold-dim: rgba(168, 122, 58, 0.1);
    --gold-fg: #fff;
    --bg: #f4f0e8;
    --bg2: #ede8de;
    --bg3: #e5dfd3;
    --bg4: #ddd7c9;
    --text: #1a1714;
    --text-m: #6b6258;
    --text-d: #a09890;
    --border: rgba(168, 122, 58, 0.14);
    --border-h: rgba(168, 122, 58, 0.35);
  }

  html,
  body {
    height: 100%;
    background: var(--bg);
    color: var(--text);
    font-family: "Jost", sans-serif;
    font-weight: 300;
    overflow: hidden;
    transition:
      background 0.5s,
      color 0.5s;
  }

  /* SHELL */
  .shell {
    display: flex;
    height: 100vh;
    overflow: hidden;
  }

  /* SIDEBAR */
  .sidebar {
    width: var(--sidebar-w);
    flex-shrink: 0;
    background: var(--bg2);
    border-right: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    transition:
      background 0.5s,
      border-color 0.5s,
      transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 200;
  }
  .sidebar-top {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 20px 20px 16px;
    border-bottom: 1px solid var(--border);
  }
  .brand-mark {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    border: 1px solid var(--gold);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .brand-mark svg {
    width: 14px;
    height: 14px;
    color: var(--gold);
  }
  .brand-info {
    flex: 1;
    min-width: 0;
  }
  .brand-name {
    display: block;
    font-family: "Cormorant Garamond", serif;
    font-size: 14px;
    font-weight: 400;
    color: var(--text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .brand-name em {
    font-style: italic;
    color: var(--gold-light);
  }
  .brand-role {
    font-size: 9px;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--text-d);
  }
  .sidebar-close {
    display: none;
    background: transparent;
    border: none;
    color: var(--text-m);
    cursor: pointer;
    padding: 4px;
  }
  .sidebar-close svg {
    width: 16px;
    height: 16px;
  }
  .nav {
    flex: 1;
    padding: 16px 12px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    overflow-y: auto;
  }
  .nav-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    background: transparent;
    border: 1px solid transparent;
    color: var(--text-m);
    font-family: "Jost", sans-serif;
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.22s;
    text-align: left;
  }
  .nav-item svg {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
  }
  .nav-item:hover {
    color: var(--text);
    border-color: var(--border);
    background: var(--bg3);
  }
  .nav-item.active {
    color: var(--gold);
    border-color: var(--gold-dim);
    background: var(--gold-dim);
  }
  .sidebar-footer {
    padding: 14px 16px;
    border-top: 1px solid var(--border);
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .user-chip {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: 1;
    min-width: 0;
  }
  .user-avatar {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    background: var(--gold-dim);
    border: 1px solid var(--gold);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-weight: 500;
    color: var(--gold);
  }
  .user-info {
    min-width: 0;
  }
  .user-name {
    display: block;
    font-size: 11px;
    font-weight: 400;
    color: var(--text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .user-dept {
    font-size: 9px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-d);
  }
  .btn-logout {
    background: transparent;
    border: 1px solid var(--border);
    padding: 7px;
    cursor: pointer;
    color: var(--text-m);
    transition: all 0.25s;
    flex-shrink: 0;
  }
  .btn-logout svg {
    width: 14px;
    height: 14px;
    display: block;
  }
  .btn-logout:hover {
    border-color: var(--red);
    color: var(--red);
  }

  /* MAIN */
  .main {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    min-width: 0;
  }
  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 24px;
    height: 56px;
    flex-shrink: 0;
    background: var(--bg2);
    border-bottom: 1px solid var(--border);
    transition:
      background 0.5s,
      border-color 0.5s;
  }
  .topbar-left {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .menu-btn {
    display: none;
    background: transparent;
    border: none;
    color: var(--text-m);
    cursor: pointer;
    padding: 4px;
  }
  .menu-btn svg {
    width: 18px;
    height: 18px;
  }
  .section-label {
    font-family: "Cormorant Garamond", serif;
    font-size: 18px;
    font-weight: 400;
    color: var(--text);
  }
  .topbar-date {
    font-size: 10px;
    letter-spacing: 0.18em;
    color: var(--text-d);
    margin-left: 4px;
  }
  .topbar-right {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .theme-toggle-top {
    display: flex;
    align-items: center;
    cursor: pointer;
    padding: 6px;
    border: 1px solid var(--border);
    transition: border-color 0.25s;
  }
  .theme-toggle-top:hover {
    border-color: var(--border-h);
  }
  .theme-toggle-top svg {
    width: 14px;
    height: 14px;
    color: var(--text-m);
    transition:
      opacity 0.3s,
      transform 0.4s;
  }
  :root .t-sun {
    opacity: 0;
    transform: rotate(90deg);
    position: absolute;
  }
  :root .t-moon {
    opacity: 1;
  }
  :root.day .t-sun {
    opacity: 1;
    transform: rotate(0deg);
    position: relative;
  }
  :root.day .t-moon {
    opacity: 0;
    transform: rotate(-90deg);
    position: absolute;
  }
  .topbar-clock {
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--text-m);
    font-variant-numeric: tabular-nums;
  }
  .notif-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--gold);
    box-shadow: 0 0 8px rgba(201, 169, 110, 0.5);
  }

  /* SECTIONS */
  .section {
    display: none;
    flex: 1;
    overflow-y: auto;
    padding: 24px;
    gap: 20px;
    flex-direction: column;
  }
  .section.active {
    display: flex;
  }

  /* CARDS & CHARTS */
  .chart-card {
    background: var(--bg3);
    border: 1px solid var(--border);
    padding: 20px;
    animation: cardIn 0.5s ease calc(var(--i, 0) * 0.07s) both;
    transition:
      background 0.5s,
      border-color 0.5s;
  }
  @keyframes cardIn {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .chart-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 20px;
  }
  .chart-title {
    font-family: "Cormorant Garamond", serif;
    font-size: 16px;
    font-weight: 400;
    color: var(--text);
  }
  .chart-sub {
    font-size: 9px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-d);
  }

  /* KPI */
  .kpi-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .kpi-card {
    background: var(--bg3);
    border: 1px solid var(--border);
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    animation: cardIn 0.5s ease calc(var(--i) * 0.07s) both;
    transition:
      background 0.5s,
      border-color 0.5s;
  }
  .kpi-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .kpi-top svg {
    width: 16px;
    height: 16px;
    color: var(--gold);
    opacity: 0.7;
  }
  .kpi-label {
    font-size: 9px;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--text-d);
  }
  .kpi-value {
    font-family: "Cormorant Garamond", serif;
    font-size: 32px;
    font-weight: 400;
    color: var(--text);
    line-height: 1;
  }
  .kpi-value small {
    font-size: 18px;
    color: var(--text-m);
  }
  .kpi-trend {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 10px;
    letter-spacing: 0.06em;
  }
  .kpi-trend svg {
    width: 12px;
    height: 12px;
  }
  .kpi-trend.up {
    color: var(--green);
  }
  .kpi-trend.down {
    color: var(--red);
  }
  .kpi-bar {
    height: 2px;
    background: var(--bg4);
    margin-top: 4px;
  }
  .kpi-fill {
    height: 100%;
    background: var(--gold);
    transition: width 1s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .kpi-fill.accent2 {
    background: var(--red);
  }

  /* CHARTS ROW */
  .charts-row {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 16px;
  }
  .bar-chart {
    display: flex;
    align-items: flex-end;
    gap: 8px;
    height: 120px;
  }
  .bar-col {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    height: 100%;
    justify-content: flex-end;
  }
  .bar-fill {
    width: 100%;
    background: var(--gold);
    opacity: 0.8;
    transition: height 0.8s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    cursor: pointer;
  }
  .bar-fill:hover {
    opacity: 1;
  }
  .bar-fill::after {
    content: attr(data-val);
    position: absolute;
    bottom: 100%;
    left: 50%;
    transform: translateX(-50%);
    font-size: 9px;
    color: var(--text-m);
    white-space: nowrap;
    padding-bottom: 3px;
    opacity: 0;
    transition: opacity 0.2s;
  }
  .bar-fill:hover::after {
    opacity: 1;
  }
  .bar-fill.egreso {
    background: var(--red);
    opacity: 0.6;
  }
  .bar-labels {
    display: flex;
    gap: 8px;
    margin-top: 8px;
  }
  .bar-lbl {
    flex: 1;
    text-align: center;
    font-size: 9px;
    letter-spacing: 0.12em;
    color: var(--text-d);
    text-transform: uppercase;
  }
  .dual-bar-chart {
    display: flex;
    align-items: flex-end;
    gap: 6px;
    height: 120px;
  }
  .dual-group {
    flex: 1;
    display: flex;
    align-items: flex-end;
    gap: 2px;
    height: 100%;
    justify-content: center;
  }
  .dual-legend {
    display: flex;
    gap: 16px;
    margin-top: 8px;
  }
  .dl-item {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 9px;
    color: var(--text-d);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .dl-dot {
    width: 8px;
    height: 8px;
    border-radius: 1px;
  }

  .donut-wrap {
    position: relative;
    width: 120px;
    height: 120px;
    margin: 0 auto 16px;
  }
  .donut {
    width: 120px;
    height: 120px;
  }
  .donut-center {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  .donut-pct {
    font-family: "Cormorant Garamond", serif;
    font-size: 22px;
    font-weight: 400;
    color: var(--text);
  }
  .donut-lbl {
    font-size: 8px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-d);
  }
  .donut-legend {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .legend-item {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .legend-dot {
    width: 8px;
    height: 8px;
    flex-shrink: 0;
  }
  .legend-label {
    font-size: 10px;
    color: var(--text-m);
    flex: 1;
  }
  .legend-pct {
    font-size: 10px;
    color: var(--text);
    font-weight: 400;
  }

  /* BOTTOM ROW */
  .bottom-row {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 16px;
  }
  .rooms-grid {
    display: grid;
    grid-template-columns: repeat(20, 1fr);
    gap: 2px;
    margin-bottom: 12px;
  }
  .room-dot {
    aspect-ratio: 1;
    border-radius: 1px;
    cursor: pointer;
    transition: transform 0.15s;
  }
  .room-dot:hover {
    transform: scale(1.4);
  }
  .room-dot.occupied {
    background: var(--gold);
  }
  .room-dot.free {
    background: var(--green);
    opacity: 0.7;
  }
  .room-dot.maintenance {
    background: var(--red);
    opacity: 0.8;
  }
  .room-dot.reserved {
    background: var(--blue);
    opacity: 0.8;
  }
  .rooms-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 16px;
  }
  .rl-item {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 9px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-d);
  }
  .rl-dot {
    width: 7px;
    height: 7px;
    border-radius: 1px;
  }
  .rl-dot.occupied {
    background: var(--gold);
  }
  .rl-dot.free {
    background: var(--green);
  }
  .rl-dot.maintenance {
    background: var(--red);
  }
  .rl-dot.reserved {
    background: var(--blue);
  }
  .activity-list {
    display: flex;
    flex-direction: column;
  }
  .act-item {
    display: grid;
    grid-template-columns: 8px 1fr auto auto;
    align-items: center;
    gap: 10px;
    padding: 8px 0;
    border-bottom: 1px solid var(--border);
    transition: background 0.15s;
  }
  .act-item:last-child {
    border-bottom: none;
  }
  .act-item:hover {
    background: var(--bg4);
    margin: 0 -8px;
    padding: 8px 8px;
  }
  .act-icon {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .act-icon.ci {
    background: var(--gold);
    box-shadow: 0 0 5px rgba(201, 169, 110, 0.4);
  }
  .act-icon.co {
    background: var(--blue);
    box-shadow: 0 0 5px rgba(107, 140, 255, 0.4);
  }
  .act-icon.pay {
    background: var(--green);
    box-shadow: 0 0 5px rgba(76, 175, 130, 0.4);
  }
  .act-icon.mnt {
    background: var(--red);
    box-shadow: 0 0 5px rgba(224, 85, 85, 0.4);
  }
  .act-desc {
    font-size: 11px;
    font-weight: 400;
    color: var(--text);
    line-height: 1.2;
  }
  .act-desc small {
    display: block;
    font-size: 9px;
    font-weight: 300;
    color: var(--text-d);
    letter-spacing: 0.08em;
    margin-top: 1px;
  }
  .act-amount {
    font-family: "Cormorant Garamond", serif;
    font-size: 13px;
    font-weight: 400;
    text-align: right;
  }
  .act-amount.pos {
    color: var(--green);
  }
  .act-amount.neg {
    color: var(--red);
  }
  .act-time {
    font-size: 9px;
    letter-spacing: 0.08em;
    color: var(--text-d);
    white-space: nowrap;
    text-align: right;
  }

  /* FINANZAS */
  .fin-kpi-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .fin-kpi {
    background: var(--bg3);
    border: 1px solid var(--border);
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    animation: cardIn 0.5s ease calc(var(--i) * 0.07s) both;
  }
  .fk-label {
    font-size: 9px;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--text-d);
  }
  .fk-val {
    font-family: "Cormorant Garamond", serif;
    font-size: 26px;
    font-weight: 400;
    color: var(--text);
  }
  .fk-sub {
    font-size: 9px;
    letter-spacing: 0.1em;
  }
  .badge-up {
    color: var(--green);
  }
  .badge-dn {
    color: var(--red);
  }
  .expense-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .exp-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .exp-top {
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    color: var(--text-m);
  }
  .exp-top span:last-child {
    color: var(--text);
    font-weight: 400;
  }
  .exp-bar-bg {
    height: 2px;
    background: var(--bg4);
  }
  .exp-bar-fill {
    height: 100%;
    transition: width 0.8s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* TABLES */
  .table-wrap {
    overflow-x: auto;
  }
  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 11px;
  }
  .data-table th {
    text-align: left;
    padding: 8px 12px;
    font-size: 9px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-d);
    border-bottom: 1px solid var(--border);
    font-weight: 400;
    white-space: nowrap;
  }
  .data-table td {
    padding: 10px 12px;
    border-bottom: 1px solid var(--border);
    color: var(--text-m);
    vertical-align: middle;
  }
  .data-table tr:last-child td {
    border-bottom: none;
  }
  .data-table tr:hover td {
    background: var(--bg4);
  }
  .badge {
    display: inline-block;
    padding: 2px 8px;
    font-size: 9px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border: 1px solid;
  }
  .badge-libre {
    color: var(--green);
    border-color: rgba(76, 175, 130, 0.3);
    background: rgba(76, 175, 130, 0.08);
  }
  .badge-ocupada {
    color: var(--gold);
    border-color: rgba(201, 169, 110, 0.3);
    background: rgba(201, 169, 110, 0.08);
  }
  .badge-mant {
    color: var(--red);
    border-color: rgba(224, 85, 85, 0.3);
    background: rgba(224, 85, 85, 0.08);
  }
  .badge-reservada {
    color: var(--blue);
    border-color: rgba(107, 140, 255, 0.3);
    background: rgba(107, 140, 255, 0.08);
  }
  .badge-confirmada {
    color: var(--green);
    border-color: rgba(76, 175, 130, 0.3);
    background: rgba(76, 175, 130, 0.08);
  }
  .badge-pendiente {
    color: var(--gold);
    border-color: rgba(201, 169, 110, 0.3);
    background: rgba(201, 169, 110, 0.08);
  }
  .badge-checkin {
    color: var(--blue);
    border-color: rgba(107, 140, 255, 0.3);
    background: rgba(107, 140, 255, 0.08);
  }
  .badge-checkout {
    color: var(--text-m);
    border-color: var(--border);
    background: transparent;
  }
  .badge-cancelada {
    color: var(--red);
    border-color: rgba(224, 85, 85, 0.3);
    background: rgba(224, 85, 85, 0.08);
  }
