    renderUsers();
    if (msg) {
      msg.textContent = "Usuario guardado correctamente.";
      msg.className = "uf-msg ok";
      setTimeout(() => {
        msg.textContent = "";
      }, 3000);
    }
  });

  function resetUserForm() {
    editingId = null;
    (document.getElementById("uf-nombre") as HTMLInputElement).value = "";
    (document.getElementById("uf-user") as HTMLInputElement).value = "";
    (document.getElementById("uf-pass") as HTMLInputElement).value = "";
    (document.getElementById("uf-rol") as HTMLSelectElement).value =
      "recepcion";
    (document.getElementById("uf-jornada") as HTMLSelectElement).value =
      "matutino";
    (document.getElementById("uf-status") as HTMLSelectElement).value =
      "activo";
    const lbl = document.getElementById("formModeLabel");
    if (lbl) lbl.textContent = "Nuevo";
    const btn = document.getElementById("btnSaveUser");
    if (btn) btn.textContent = "Guardar usuario";
  }

  document
    .getElementById("btnCancelEdit")
    ?.addEventListener("click", resetUserForm);

  (window as any).editUser = (id: number) => {
    const u = usuarios.find((x) => x.id === id);
    if (!u) return;
    editingId = id;
    (document.getElementById("uf-nombre") as HTMLInputElement).value = u.nombre;
    (document.getElementById("uf-user") as HTMLInputElement).value = u.user;
    (document.getElementById("uf-pass") as HTMLInputElement).value = "";
    (document.getElementById("uf-rol") as HTMLSelectElement).value = u.rol;
    (document.getElementById("uf-jornada") as HTMLSelectElement).value =
      u.jornada;
    (document.getElementById("uf-status") as HTMLSelectElement).value =
      u.status;
    const lbl = document.getElementById("formModeLabel");
    if (lbl) lbl.textContent = "Editando";
    const btn = document.getElementById("btnSaveUser");
    if (btn) btn.textContent = "Actualizar usuario";
    // scroll al form
    document
      .querySelector(".usr-form-card")
      ?.scrollIntoView({ behavior: "smooth", block: "start" });
  };

  (window as any).deleteUser = (id: number) => {
    const u = usuarios.find((x) => x.id === id);
    if (!u) return;
    openModal(
      "Eliminar usuario",
      `<p>¿Estás seguro de eliminar a <strong style="color:var(--text)">${u.nombre}</strong>? Esta acción no se puede deshacer.</p>`,
      () => {
        usuarios = usuarios.filter((x) => x.id !== id);
        renderUsers();
      },
    );
    const mc = document.getElementById("modalConfirm");
    if (mc) {
      mc.style.display = "";
      mc.textContent = "Eliminar";
      mc.style.borderColor = "var(--red)";
      mc.style.color = "var(--red)";
    }
  };
  // Botones nueva hab / reserva / huesped (placeholder)
  document
    .getElementById("btnNuevaHab")
    ?.addEventListener("click", () =>
      openModal(
        "Nueva habitación",
        "<p>Formulario disponible al conectar el backend.</p>",
      ),
    );
  document
    .getElementById("btnNuevaRes")
    ?.addEventListener("click", () =>
      openModal(
        "Nueva reservación",
        "<p>Formulario disponible al conectar el backend.</p>",
      ),
    );
  document
    .getElementById("btnNuevoHuésped")
    ?.addEventListener("click", () =>
      openModal(
        "Nuevo huésped",
        "<p>Formulario disponible al conectar el backend.</p>",
      ),
    );
</script>
