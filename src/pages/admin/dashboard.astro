    const status = (document.getElementById("uf-status") as HTMLSelectElement)
      .value;
    const msg = document.getElementById("ufMsg");

    if (!nombre || !user) {
      if (msg) {
        msg.textContent = "Nombre y usuario son requeridos.";
        msg.className = "uf-msg err";
      }
      return;
    }
    if (editingId === null && !pass) {
      if (msg) {
        msg.textContent = "La contraseña es requerida.";
        msg.className = "uf-msg err";
      }
      return;
    }

    if (editingId !== null) {
      const idx = usuarios.findIndex((u) => u.id === editingId);
      if (idx > -1) {
        usuarios[idx] = {
          ...usuarios[idx],
          nombre,
          user,
          rol,
          jornada,
          status,
        };
        if (pass) usuarios[idx].pass = pass;
