</style>

<script>
  // ── SESION ──────────────────────────────────────────────────────
  const storedUser = sessionStorage.getItem("hotel_user") || "Admin";
  const avatarEl = document.getElementById("userAvatar");
  const sidebarUserEl = document.getElementById("sidebarUser");
  if (avatarEl) avatarEl.textContent = storedUser.charAt(0).toUpperCase();
  if (sidebarUserEl) sidebarUserEl.textContent = storedUser;

  // ── TEMA ────────────────────────────────────────────────────────
  const root = document.documentElement;
  const DAY_START = 6,
    DAY_END = 18;
  let manualOverride = false,
    currentTheme = "night";
  function getAutoTheme() {
    const h = new Date().getHours();
    return h >= DAY_START && h < DAY_END ? "day" : "night";
  }
  function applyTheme(t: string) {
    currentTheme = t;
    t === "day" ? root.classList.add("day") : root.classList.remove("day");
  }
  document.getElementById("themeToggleTop")?.addEventListener("click", () => {
    manualOverride = true;
    applyTheme(currentTheme === "day" ? "night" : "day");
    setTimeout(() => {
      manualOverride = false;
    }, 7200000);
  });
  applyTheme(getAutoTheme());

  // RELOJ
  const clockEl = document.getElementById("topbarClock"),
    dateEl = document.getElementById("topbarDate");
  function tick() {
    const now = new Date(),
      h = String(now.getHours()).padStart(2, "0"),
      m = String(now.getMinutes()).padStart(2, "0"),
      s = String(now.getSeconds()).padStart(2, "0");
    if (clockEl) clockEl.textContent = h + ":" + m + ":" + s;
    const dias = ["Dom", "Lun", "Mar", "Mié", "Jue", "Vie", "Sáb"],
      meses = [
        "Ene",
        "Feb",
        "Mar",
        "Abr",
        "May",
        "Jun",
        "Jul",
        "Ago",
        "Sep",
        "Oct",
        "Nov",
        "Dic",
      ];
    if (dateEl)
      dateEl.textContent =
        dias[now.getDay()] + " " + now.getDate() + " " + meses[now.getMonth()];
    if (!manualOverride && getAutoTheme() !== currentTheme)
      applyTheme(getAutoTheme());
  }
  tick();
  setInterval(tick, 1000);

  // ── NAVEGACIÓN ──────────────────────────────────────────────────
  const navItems = document.querySelectorAll(".nav-item"),
    sections = document.querySelectorAll(".section");
  const sectionLabel = document.getElementById("sectionLabel");
  const labels: Record<string, string> = {
    overview: "Resumen General",
    finanzas: "Finanzas",
    habitaciones: "Habitaciones",
    reservaciones: "Reservaciones",
    huespedes: "Huéspedes",
    usuarios: "Gestión de Usuarios",
  };
  navItems.forEach((btn) => {
    btn.addEventListener("click", () => {
      const sec = btn.getAttribute("data-section") || "overview";
      navItems.forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");
      sections.forEach((s) => s.classList.remove("active"));
      document.getElementById("sec-" + sec)?.classList.add("active");
      if (sectionLabel) sectionLabel.textContent = labels[sec] || sec;
      if (window.innerWidth < 768) closeSidebar();
    });
  });

  // SIDEBAR MOBILE
  const sidebar = document.getElementById("sidebar"),
    overlay = document.getElementById("sidebarOverlay");
  function openSidebar() {
    sidebar?.classList.add("open");
    overlay?.classList.add("open");
    document.body.style.overflow = "hidden";
  }
  function closeSidebar() {
    sidebar?.classList.remove("open");
    overlay?.classList.remove("open");
    document.body.style.overflow = "";
  }
  document.getElementById("menuBtn")?.addEventListener("click", openSidebar);
  document
    .getElementById("sidebarClose")
    ?.addEventListener("click", closeSidebar);
  overlay?.addEventListener("click", closeSidebar);

  // LOGOUT
  document.getElementById("btnLogout")?.addEventListener("click", () => {
    sessionStorage.removeItem("hotel_user");
    sessionStorage.removeItem("hotel_role");
    window.location.replace("/logIn");
  });

  // MODAL
  const backdrop = document.getElementById("modalBackdrop");
  function openModal(title: string, body: string, confirmCb?: () => void) {
    const mt = document.getElementById("modalTitle"),
      mb = document.getElementById("modalBody"),
      mc = document.getElementById("modalConfirm");
    if (mt) mt.textContent = title;
    if (mb) mb.innerHTML = body;
    if (mc) {
      if (confirmCb) {
        mc.style.display = "";
        const nc = mc.cloneNode(true) as HTMLElement;
        mc.parentNode?.replaceChild(nc, mc);
        nc.addEventListener("click", () => {
          confirmCb();
          closeModal();
        });
      } else {
        mc.style.display = "none";
      }
    }
    backdrop?.classList.add("open");
  }
  function closeModal() {
    backdrop?.classList.remove("open");
  }
  document.getElementById("modalClose")?.addEventListener("click", closeModal);
  document.getElementById("modalCancel")?.addEventListener("click", closeModal);
  backdrop?.addEventListener("click", (e) => {
    if (e.target === backdrop) closeModal();
  });

  // ── RESUMEN ─────────────────────────────────────────────────────
  // Barras
  const barData = [
    { mes: "Sep", val: 210000 },
    { mes: "Oct", val: 195000 },
    { mes: "Nov", val: 230000 },
    { mes: "Dic", val: 310000 },
    { mes: "Ene", val: 265000 },
    { mes: "Feb", val: 248000 },
    { mes: "Mar", val: 284500 },
  ];
  const maxVal = Math.max(...barData.map((d) => d.val));
  const barChart = document.getElementById("barChart"),
    barLabels = document.getElementById("barLabels");
  if (barChart && barLabels) {
    barData.forEach((d) => {
      const col = document.createElement("div");
      col.className = "bar-col";
      const fill = document.createElement("div");
      fill.className = "bar-fill";
      fill.style.height = "0";
      fill.setAttribute("data-val", "$" + (d.val / 1000).toFixed(0) + "k");
      col.appendChild(fill);
      barChart.appendChild(col);
      setTimeout(() => {
        fill.style.height = (d.val / maxVal) * 100 + "%";
      }, 150);
      const lbl = document.createElement("div");
      lbl.className = "bar-lbl";
      lbl.textContent = d.mes;
      barLabels.appendChild(lbl);
    });
  }

  // Donut
  const donutData = [
    { label: "Hospedaje", pct: 78, color: "#C9A96E" },
    { label: "Restaurante", pct: 12, color: "#4CAF82" },
    { label: "Spa & Eventos", pct: 6, color: "#6B8CFF" },
    { label: "Otros", pct: 4, color: "#E05555" },
  ];
  const donutSvg = document.getElementById("donutChart"),
    legend = document.getElementById("donutLegend");
  if (donutSvg) {
    const r = 45,
      cx = 60,
      cy = 60,
      stroke = 14,
      circ = 2 * Math.PI * r;
    let offset = 0;
    donutData.forEach((d) => {
      const dash = (d.pct / 100) * circ;
      const circle = document.createElementNS(
        "http://www.w3.org/2000/svg",
        "circle",
      );
      circle.setAttribute("cx", String(cx));
      circle.setAttribute("cy", String(cy));
      circle.setAttribute("r", String(r));
      circle.setAttribute("fill", "none");
      circle.setAttribute("stroke", d.color);
      circle.setAttribute("stroke-width", String(stroke));
      circle.setAttribute("stroke-dasharray", dash + " " + (circ - dash));
      circle.setAttribute(
        "stroke-dashoffset",
        String(-(offset / 100) * circ + circ / 4),
      );
      donutSvg.appendChild(circle);
      offset += d.pct;
    });
  }
  if (legend) {
    donutData.forEach((d) => {
      const item = document.createElement("div");
      item.className = "legend-item";
      item.innerHTML = `<div class="legend-dot" style="background:${d.color}"></div><span class="legend-label">${d.label}</span><span class="legend-pct">${d.pct}%</span>`;
      legend.appendChild(item);
    });
  }

  // Habitaciones grid
  const roomsGrid = document.getElementById("roomsGrid");
  if (roomsGrid) {
    for (let i = 0; i < 248; i++) {
      const r2 = Math.random();
      let st = "occupied";
      if (r2 > 0.97) st = "reserved";
      else if (r2 > 0.95) st = "maintenance";
      else if (r2 > 0.94) st = "free";
      const dot = document.createElement("div");
      dot.className = "room-dot " + st;
      dot.title = "Hab. " + (i + 101);
      roomsGrid.appendChild(dot);
    }
  }

  // Actividad
  const activities = [
    {
      icon: "check-in",
      desc: "Check-in · Juan Pérez",
      sub: "Hab. 312 · Suite Deluxe",
      amount: "+$3,200",
      pos: true,
      time: "Hace 8 min",
    },
    {
      icon: "pay",
      desc: "Pago restaurante",
      sub: "Consumo mesa 7",
      amount: "+$890",
      pos: true,
      time: "Hace 22 min",
    },
    {
      icon: "checkout",
      desc: "Check-out · María R.",
      sub: "Hab. 204 · Estándar",
      amount: "+$6,400",
      pos: true,
      time: "Hace 1 h",
    },
    {
      icon: "maint",
      desc: "Mantenimiento",
      sub: "Hab. 118 · Plomería",
      amount: "-$450",
      pos: false,
      time: "Hace 2 h",
    },
    {
      icon: "pay",
      desc: "Pago spa",
      sub: "Servicio masaje · 2 pax",
      amount: "+$1,600",
      pos: true,
      time: "Hace 3 h",
    },
    {
      icon: "check-in",
      desc: "Check-in · Carlos M.",
      sub: "Hab. 501 · Junior Suite",
      amount: "+$4,800",
      pos: true,
      time: "Hace 4 h",
    },
  ];
  const dotMap: Record<string, string> = {
    "check-in": "ci",
    checkout: "co",
    pay: "pay",
    maint: "mnt",
  };
  const actList = document.getElementById("activityList");
  if (actList) {
    activities.forEach((a) => {
      const item = document.createElement("div");
      item.className = "act-item";
      item.innerHTML = `<div class="act-icon ${dotMap[a.icon] || "pay"}"></div><div class="act-desc">${a.desc}<small>${a.sub}</small></div><span class="act-amount ${a.pos ? "pos" : "neg"}">${a.amount}</span><span class="act-time">${a.time}</span>`;
      actList.appendChild(item);
    });
  }

